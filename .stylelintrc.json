{
  "extends": ["stylelint-config-drupal"],
  "rules": {
    "alpha-value-notation": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["container", "starting-style"]
      }
    ],
    "color-function-notation": null,
    "declaration-block-single-line-max-declarations": null,
    "number-leading-zero": "never",
    "unit-allowed-list": [
      "ch",
      "deg",
      "dvh",
      "em",
      "ex",
      "fr",
      "ms",
      "rem",
      "%",
      "s",
      "px",
      "vw",
      "vh"
    ],
    "unit-no-unknown": [
      true,
      {
        "ignoreUnits": ["dvh"]
      }
    ],
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": ["currentColor", "sRGB"],
        "ignoreProperties": [
          "font-family",
          "--font-family-base",
          "--font-family-heading"
        ]
      }
    ]
  }
}
