{
  "dependencies": {
    "selenium": "^2.20.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "js-yaml": "4.3.2",
    "postcss": "8.5.32",
    "purgecss": "9.1.0",
    "stylelint": "^14.16.1",
    "stylelint-config-drupal": "^3.1.0",
    "stylelint-order": "^5.0.0"
  },
  "scripts": {
    "lint:css": "stylelint \"web/themes/custom/aculta420_v2/**/*.css\"",
    "lint:js": "eslint web/themes/custom/aculta420_v2/js web/themes/custom/aculta420_v2/components",
    "css:audit": "node scripts/css-audit/report.mjs && node scripts/css-audit/purge.mjs --mode=audit",
    "css:purge": "node scripts/css-audit/purge.mjs --mode=apply",
    "css:verify": "node scripts/css-audit/verify.mjs",
    "css:test": "node --test scripts/css-audit/tests/*.test.mjs",
    "css:classify": "node scripts/css-audit/classify.mjs"
  }
}
