diff --git a/src/Hook/AddressTokenHooks.php b/src/Hook/AddressTokenHooks.php
new file mode 100644
index 0000000000000000000000000000000000000000..d498310600f6e9aed725ede05fa04a7d64febdd8
--- /dev/null
+++ b/src/Hook/AddressTokenHooks.php
@@ -0,0 +1,71 @@
+<?php
+
+namespace Drupal\address\Hook;
+
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\Hook\Order\Order;
+use Drupal\Core\Render\BubbleableMetadata;
+
+/**
+ * Hook implementations for address.
+ */
+class AddressTokenHooks {
+
+  /**
+   * Implements hook_tokens().
+   *
+   * D12 (change record 3496788): moved from a bare procedural function to
+   * this OOP method so the order: Order::Last parameter actually takes
+   * effect. Core's HookCollectorPass only reads a #[Hook] attribute's order
+   * parameter when it is on a real class method (OOP scan branch); the
+   * procedural-file scan branch never does (see
+   * HookCollectorPass::collectModuleHookImplementations(),
+   * core/lib/Drupal/Core/Hook/HookCollectorPass.php:397-405 vs. 424-466).
+   * The old address_module_implements_alter() procedural reorder in
+   * address.module is left in place as dead code for pre-11.2 BC.
+   */
+  #[Hook('tokens', order: Order::Last)]
+  public function tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
+    $replacements = [];
+
+    if (!empty($data['field_property'])) {
+      foreach ($tokens as $token => $original) {
+        $delta = 0;
+        $parts = explode(':', $token);
+        if (is_numeric($parts[0])) {
+          if (count($parts) > 1) {
+            $delta = $parts[0];
+            $property_name = $parts[1];
+          }
+          else {
+            continue;
+          }
+        }
+        else {
+          $property_name = $parts[0];
+        }
+        if ($property_name != 'country_name') {
+          continue;
+        }
+        if (!isset($data[$data['field_name']][$delta])) {
+          continue;
+        }
+
+        $field_item = $data[$data['field_name']][$delta];
+
+        $country_name = '';
+        if ($country_code = $field_item->country_code) {
+          $country_repository = \Drupal::service('address.country_repository');
+          $locale = $options['langcode'] ?? NULL;
+          if ($country = $country_repository->get($country_code, $locale)) {
+            $country_name = $country->getName();
+          }
+        }
+        $replacements[$original] = $country_name;
+      }
+    }
+
+    return $replacements;
+  }
+
+}
