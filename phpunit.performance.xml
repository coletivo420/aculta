    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="performance">
      <directory suffix="Test.php">web/modules/custom/aculta_portal/modules/aculta_index/tests/src/Performance</directory>
    </testsuite>
  </testsuites>
</phpunit>
