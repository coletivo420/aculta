{
  "name": "aculta420-storybook",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Catálogo de componentes e documentação do tema Drupal ACULTA420.",
  "scripts": {
    "storybook": "storybook dev --no-open --port 6006",
    "build": "storybook build",
    "stories:compile": "cd .. && php vendor/drush/drush/drush.php storybook:generate-all-stories --omit-server-url"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/builder-vite": "10.6.2",
    "@storybook/server": "10.6.2",
    "storybook": "10.6.2"
  }
}
