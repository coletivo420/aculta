<?php

/**
 * @file
 * ACULTA Commerce module hooks.
 *
 * Studio registration lives in AcultaCommerceServiceProvider. Shipping hooks
 * implement the in-module engine ported from drupal/commerce_shipping 3.0.5
 * (GPL-2.0-or-later); they never depend on the contributed module.
 */

use Drupal\aculta_commerce\Entity\Shipment;
use Drupal\commerce\PurchasableEntityInterface;
use Drupal\commerce_store\Entity\Store;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Implements hook_commerce_entity_trait_info_alter().
 */
function aculta_commerce_commerce_entity_trait_info_alter(array &$definitions): void {
  // Expose the ACULTA purchasable entity traits for every purchasable entity.
  $entity_types = \Drupal::entityTypeManager()->getDefinitions();
  $entity_type_ids = [];
  foreach ($entity_types as $entity_type) {
    if ($entity_type->entityClassImplements(PurchasableEntityInterface::class)) {
      $entity_type_ids[] = $entity_type->id();
    }
  }
  $definitions['aculta_purchasable_entity_shippable']['entity_types'] = $entity_type_ids;
  $definitions['aculta_purchasable_entity_dimensions']['entity_types'] = $entity_type_ids;
}

/**
 * Implements hook_entity_base_field_info().
 */
function aculta_commerce_entity_base_field_info(EntityTypeInterface $entity_type): array {
  if ($entity_type->id() !== 'commerce_store') {
    return [];
  }
  $fields['shipping_countries'] = BaseFieldDefinition::create('list_string')
    ->setLabel(t('Supported shipping countries'))
    ->setCardinality(BaseFieldDefinition::CARDINALITY_UNLIMITED)
    ->setSetting('allowed_values_function', [Store::class, 'getAvailableCountries'])
    ->setDisplayOptions('form', [
      'type' => 'options_select',
      'weight' => 4,
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', TRUE);

  return $fields;
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function aculta_commerce_entity_bundle_info_alter(array &$bundles): void {
  if (empty($bundles['commerce_order'])) {
    return;
  }
  $order_type_ids = array_keys($bundles['commerce_order']);
  $order_types = \Drupal::entityTypeManager()
    ->getStorage('commerce_order_type')
    ->loadMultiple($order_type_ids);
  $shipment_type_storage = \Drupal::entityTypeManager()->getStorage('aculta_shipment_type');
  foreach ($bundles['commerce_order'] as $bundle => $info) {
    if (!isset($order_types[$bundle])) {
      continue;
    }
    $shipment_type_id = $order_types[$bundle]->getThirdPartySetting('aculta_commerce', 'shipment_type');
    if (!$shipment_type_id) {
      continue;
    }
    $shipment_type = $shipment_type_storage->load($shipment_type_id);
    if (!$shipment_type) {
      continue;
    }
    $shipping_profile_type_id = $shipment_type->getProfileTypeId();
    if ($shipping_profile_type_id !== 'customer') {
      $bundles['commerce_order'][$bundle]['shipping_profile_type'] = $shipping_profile_type_id;
    }
  }
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function aculta_commerce_entity_bundle_field_info(EntityTypeInterface $entity_type, string $bundle): array {
  if ($entity_type->id() !== 'commerce_order') {
    return [];
  }
  $order_type = \Drupal::entityTypeManager()
    ->getStorage('commerce_order_type')
    ->load($bundle);
  if (!$order_type) {
    return [];
  }
  if (empty($order_type->getThirdPartySetting('aculta_commerce', 'shipment_type'))) {
    return [];
  }
  $field_definition = Shipment::buildShipmentsFieldDefinition($bundle);
  return [$field_definition->getName() => $field_definition];
}
