{#
/**
 * @file
 * Tela de retorno da autorização do Melhor Envio.
 *
 * Variáveis: status (success|error), title, message, action_url, action_label.
 */
#}
<section class="melhorenvio-retorno melhorenvio-retorno--{{ status }}" role="status" aria-live="polite">
  <div class="melhorenvio-retorno__icon" aria-hidden="true">
    {% if status == 'success' %}
      <svg viewBox="0 0 24 24" width="40" height="40" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" fill="currentColor"/></svg>
    {% else %}
      <svg viewBox="0 0 24 24" width="40" height="40" focusable="false"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z" fill="currentColor"/></svg>
    {% endif %}
  </div>
  <h1 class="melhorenvio-retorno__title">{{ title }}</h1>
  <p class="melhorenvio-retorno__message">{{ message }}</p>
  <a class="melhorenvio-retorno__action" href="{{ action_url }}">{{ action_label }}</a>
</section>
