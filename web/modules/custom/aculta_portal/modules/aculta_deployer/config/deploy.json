{
  "tool": "aculta-deployer",
  "scope": [
    "^config/sync/(.+/)?[^/]+\\.yml$",
    "^scripts/content/.+\\.json$"
  ],
  "drop": [
    "^config/sync/domain_alias\\.alias\\..*_(toca_net_br|test_8080)\\.yml$"
  ],
  "host_rules": [
    {
      "from": "aculta.toca.net.br",
      "to": "aculta.org",
      "comment": "Host de teste (*.aculta.toca.net.br) para produção (*.aculta.org). Preserva o prefixo do subdomínio."
    }
  ],
  "domain_transition": {
    "shop": {"purpose": "shop", "route": "entity.commerce_product.canonical", "note": "A página do produto da loja fica no host SHOP (loja.aculta.toca.net.br em teste; loja.aculta.org em produção). Carrinho e checkout ficam no MAIN."},
    "note": "Migração de domínios do servidor de testes (*.aculta.toca.net.br) para produção (*.aculta.org), por domínio registrado no Portal. Dado declarado: o comando `domains` confere os registros de config/sync contra esta tabela (somente leitura). A troca em produção só acontece no deploy do RC.",
    "decision_pending": [
      "coletivo420_aculta_org: o host de produção da revista (coletivo420.aculta.org hoje) segue a mudança de host de teste (revista420). Confirmar revista420.aculta.org antes do RC."
    ],
    "entries": [
      {"domain_id": "aculta_org", "test_host": "aculta.toca.net.br", "production_host": "aculta.org"},
      {"domain_id": "apoio_aculta_org", "test_host": "apoio.aculta.toca.net.br", "production_host": "apoio.aculta.org"},
      {"domain_id": "conta_aculta_org", "test_host": "conta.aculta.toca.net.br", "production_host": "conta.aculta.org"},
      {"domain_id": "coletivo420_aculta_org", "test_host": "revista420.aculta.toca.net.br", "production_host": "revista420.aculta.org"},
      {"domain_id": "wiki420_aculta_org", "test_host": "wiki420.aculta.toca.net.br", "production_host": "wiki420.aculta.org"},
      {"domain_id": "loja_aculta_org", "test_host": "loja.aculta.toca.net.br", "production_host": "loja.aculta.org"},
      {"domain_id": "forum_aculta_org", "test_host": "forum.aculta.toca.net.br", "production_host": "forum.aculta.org"},
      {"domain_id": "cursos_aculta_org", "test_host": "cursos.aculta.toca.net.br", "production_host": "cursos.aculta.org"}
    ]
  },
  "blocking_kinds": [
    "canonical",
    "sitemap"
  ],
  "max_bytes": 2097152,
  "robots_policy": {
    "production": {
      "x_robots_tag": null,
      "hosts": [
        "https://aculta.org/",
        "https://conta.aculta.org/",
        "https://apoio.aculta.org/",
        "https://coletivo420.aculta.org/",
        "https://wiki420.aculta.org/",
        "https://loja.aculta.org/",
        "https://cursos.aculta.org/"
      ],
      "note": "Indexação ativa em todos os domínios e subdomínios de produção. Noindex de páginas privadas da conta permanece no Portal (meta robots por rota).",
      "private_probes": [
        "https://conta.aculta.org/entrar",
        "https://conta.aculta.org/conta-interna",
        "https://conta.aculta.org/dados",
        "https://conta.aculta.org/seguranca",
        "https://conta.aculta.org/conexoes",
        "https://conta.aculta.org/meus-cursos",
        "https://aculta.org/painel-administrativo",
        "https://aculta.org/cart",
        "https://aculta.org/checkout"
      ],
      "private_note": "Caminhos privados (conta, login, painel, carrinho e checkout) devem ter noindex (meta robots ou X-Robots-Tag) ou status 401/403/404/410. O noindex é mantido no Portal por rota; o deployer apenas confere."
    },
    "test": {
      "x_robots_tag": "noindex, nofollow, noarchive",
      "hosts": [
        "https://aculta.toca.net.br/",
        "https://apoio.aculta.toca.net.br/",
        "https://revista420.aculta.toca.net.br/",
        "https://loja.aculta.toca.net.br/",
        "https://forum.aculta.toca.net.br/",
        "https://wiki420.aculta.toca.net.br/"
      ],
      "note": "Servidor de testes não indexável."
    }
  },
  "sitemap": {
    "production": {
      "index_url": "https://aculta.org/sitemap.xml",
      "index_base": "https://aculta.org",
      "note": "Índice central em produção. Os filhos listam URLs canônicas de produção de todos os purposes indexáveis."
    },
    "test": {
      "index_url": "https://aculta.toca.net.br/sitemap.xml",
      "index_base": "https://aculta.toca.net.br",
      "note": "Índice no servidor de testes. Os filhos listam os hosts de teste (perfil test, registros de domínio por ambiente); a produção lista os hosts de produção."
    }
  },
  "environments": {
    "production": {
      "site": "https://aculta.org"
    },
    "test": {
      "site": "https://aculta.toca.net.br"
    }
  },
  "environment_bound": [
    {
      "file": "config/sync/smtp.settings.yml",
      "reason": "SMTP2GO ligado e remetente por ambiente"
    },
    {
      "file": "config/sync/system.mail.yml",
      "reason": "backend de e-mail: SMTP em produção e teste"
    },
    {
      "file": "config/sync/system.site.yml",
      "reason": "e-mail do site por ambiente"
    },
    {
      "file": "config/sync/webform.webform.aculta_contact.yml",
      "reason": "remetente do formulário de contato por ambiente"
    },
    {
      "file": "config/sync/commerce_payment.commerce_payment_gateway.mercado_pago.yml",
      "reason": "gateway Mercado Pago ativo quando as credenciais do ambiente existem"
    },
    {
      "file": "config/sync/system.logging.yml",
      "reason": "erros ocultos na tela em todos os ambientes"
    },
    {
      "file": "config/sync/domain.record.aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.apoio_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.conta_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.coletivo420_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.wiki420_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.loja_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.forum_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    },
    {
      "file": "config/sync/domain.record.cursos_aculta_org.yml",
      "reason": "hostname do domínio por ambiente: sitemaps, canonical e links usam o host do registro"
    }
  ],
  "profiles": {
    "production": {
      "description": "Transição para produção no build de produção (aculta-deployer build --target production).",
      "rules": [
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_on: .*$",
          "with": "smtp_on: true"
        },
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_from: .*$",
          "with": "smtp_from: 'naoresponda@aculta.org'"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  default: .*$",
          "with": "  default: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  webform: .*$",
          "with": "  webform: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.site.yml",
          "pattern": "^mail: .*$",
          "with": "mail: naoresponda@aculta.org"
        },
        {
          "file": "config/sync/webform.webform.aculta_contact.yml",
          "pattern": "^      from_mail: .*$",
          "with": "      from_mail: naoresponda@aculta.org"
        },
        {
          "file": "config/sync/commerce_payment.commerce_payment_gateway.mercado_pago.yml",
          "pattern": "^status: .*$",
          "with": "status: true"
        },
        {
          "file": "config/sync/system.logging.yml",
          "pattern": "^error_level: .*$",
          "with": "error_level: hide"
        },
        {
          "file": "config/sync/domain.record.aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: aculta.org"
        },
        {
          "file": "config/sync/domain.record.apoio_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: apoio.aculta.org"
        },
        {
          "file": "config/sync/domain.record.conta_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: conta.aculta.org"
        },
        {
          "file": "config/sync/domain.record.coletivo420_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: coletivo420.aculta.org"
        },
        {
          "file": "config/sync/domain.record.wiki420_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: wiki420.aculta.org"
        },
        {
          "file": "config/sync/domain.record.loja_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: loja.aculta.org"
        },
        {
          "file": "config/sync/domain.record.forum_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: forum.aculta.org"
        },
        {
          "file": "config/sync/domain.record.cursos_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: cursos.aculta.org"
        }
      ]
    },
    "test": {
      "description": "Configuração do servidor de testes (aculta-deployer build --target test). Remetente de teste.",
      "rules": [
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_on: .*$",
          "with": "smtp_on: true"
        },
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_from: .*$",
          "with": "smtp_from: 'naoresponda@toca.net.br'"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  default: .*$",
          "with": "  default: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  webform: .*$",
          "with": "  webform: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.site.yml",
          "pattern": "^mail: .*$",
          "with": "mail: naoresponda@toca.net.br"
        },
        {
          "file": "config/sync/webform.webform.aculta_contact.yml",
          "pattern": "^      from_mail: .*$",
          "with": "      from_mail: naoresponda@toca.net.br"
        },
        {
          "file": "config/sync/commerce_payment.commerce_payment_gateway.mercado_pago.yml",
          "pattern": "^status: .*$",
          "with": "status: true"
        },
        {
          "file": "config/sync/system.logging.yml",
          "pattern": "^error_level: .*$",
          "with": "error_level: hide"
        },
        {
          "file": "config/sync/domain.record.aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.apoio_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: apoio.aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.conta_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: conta.aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.coletivo420_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: revista420.aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.wiki420_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: wiki420.aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.loja_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: loja.aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.forum_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: forum.aculta.toca.net.br"
        },
        {
          "file": "config/sync/domain.record.cursos_aculta_org.yml",
          "pattern": "^hostname: .*$",
          "with": "hostname: cursos.aculta.toca.net.br"
        }
      ]
    }
  }
}
