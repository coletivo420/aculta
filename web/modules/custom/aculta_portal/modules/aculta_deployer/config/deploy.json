      "production": {
        "cookie_domain": ".aculta.org",
        "source": "web/sites/default/services.hostinger.yml",
        "source_note": "provisionado no servidor de produção; não versionado. O modelo é web/sites/default/services.hostinger.yml.example, que o comando confere.",
        "loaded_by": "settings.hostinger.php.example"
      },
      "test": {
        "cookie_domain": ".aculta.toca.net.br",
        "source": "web/sites/default/services.homelab.yml",
        "source_note": "versionado; carregado pelo settings.local.php do Homelab",
        "loaded_by": "settings.local.php"
      }
    },
    "transition": {
      "from": "test",
      "to": "production",
      "change": "cookie_domain muda de .aculta.toca.net.br para .aculta.org no deploy do RC",
      "impact": "o cookie de sessão é emitido por host de produção; sessões do Runtime de teste não são aceitas em aculta.org. Usuários entram de novo.",
      "verify": "aculta-deployer cookies (somente leitura)",
