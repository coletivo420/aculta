<?php

/**
 * @file
 * Instalação do submódulo ACULTA Editor.
 */

declare(strict_types=1);

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 *
 * Concede apenas o formato básico ao papel de editor de conteúdo. Os formatos
 * editorial, institucional e e-mail ficam sem permissão automática: o acesso a
 * eles é concedido pelo responsável (menor privilégio).
 */
function aculta_editor_install(): void {
  $role = Role::load('content_editor');
  if ($role === NULL) {
    return;
  }
  $permission = 'use text format aculta_basico';
  if (!$role->hasPermission($permission)) {
    $role->grantPermission($permission);
    $role->save();
  }
}
