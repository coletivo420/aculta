<?php

/**
 * Hooks do módulo aculta_events.
 *
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Tema e hooks do módulo ACULTA Eventos.
 */

/**
 * Implements hook_cron().
 */
function aculta_events_cron(): void {
  \Drupal::service('aculta_events.organization_contribution_event_queue')->recoverUndelivered();
}
