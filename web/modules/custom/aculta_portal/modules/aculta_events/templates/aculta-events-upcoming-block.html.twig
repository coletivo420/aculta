{#
  Fallback neutro do bloco de próximos eventos (aculta_events). O tema
  ACULTA420 sobrescreve este template e compõe o SDC correspondente.
#}
{% if items %}
  <ul data-portal-ui="events-upcoming-block">
    {% for item in items %}
      <li><a href="{{ item.url }}" data-portal-ui="events-upcoming-link">{{ item.title }}</a></li>
    {% endfor %}
  </ul>
{% else %}
  <p>{{ empty_text }}</p>
{% endif %}
