<?php

/**
 * @file
 * Install and update hooks for ACULTA Forum.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_schema().
 */
function aculta_forum_schema(): array {
  $schema['aculta_discussion_reaction'] = [
    'description' => 'Stores individual user emoji reactions on discussion comments and forum posts.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique reaction entry ID.',
      ],
      'entity_type' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Target entity type (node, comment, or aculta_forum_post).',
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Target entity ID.',
      ],
      'host_entity_type' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Host entity type (e.g. node).',
      ],
      'host_entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Host entity ID.',
      ],
      'context_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Context identifier (e.g. public_forum, publication, lms, wiki).',
      ],
      'is_public_context' => [
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Whether the reaction occurred in a public context (1) or restricted/LMS (0).',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'User ID who reacted.',
      ],
      'author_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Target content author User ID who received the reaction.',
      ],
      'reaction' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Reaction machine identifier (e.g. heart, seedling, fire).',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Timestamp when created.',
      ],
      'changed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Timestamp when last updated.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'user_entity_reaction' => ['entity_type', 'entity_id', 'uid'],
    ],
    'indexes' => [
      'entity_lookup' => ['entity_type', 'entity_id', 'reaction'],
      'user_given' => ['uid', 'is_public_context'],
      'author_received' => ['author_uid', 'is_public_context'],
    ],
  ];

  $schema['aculta_discussion_reaction_user_stats'] = [
    'description' => 'Aggregated O(1) user reaction statistics.',
    'fields' => [
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: User ID.',
      ],
      'reactions_received' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Total public reactions received by this user.',
      ],
      'reactions_given' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Total public reactions given by this user.',
      ],
      'updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of last update.',
      ],
    ],
    'primary key' => ['uid'],
  ];

  return $schema;
}

/**
 * Adds first-publication timestamps to shared discussion comments.
 */
function aculta_forum_update_9001(array &$sandbox): string {
  if (!isset($sandbox['initialized'])) {
    if (!FieldStorageConfig::loadByName('comment', 'field_aculta_published_at')) {
      FieldStorageConfig::create([
        'entity_type' => 'comment',
        'field_name' => 'field_aculta_published_at',
        'type' => 'integer',
        'settings' => ['unsigned' => TRUE, 'size' => 'big'],
        'cardinality' => 1,
        'translatable' => FALSE,
      ])->save();
    }
    if (!FieldConfig::loadByName('comment', 'aculta_discussion_post', 'field_aculta_published_at')) {
      FieldConfig::create([
        'entity_type' => 'comment',
        'bundle' => 'aculta_discussion_post',
        'field_name' => 'field_aculta_published_at',
        'label' => 'Primeira publicação (marcador interno)',
        'description' => 'Timestamp interno usado para aplicar a janela de edição do autor; não é exibido.',
      ])->save();
    }
    $sandbox['initialized'] = TRUE;
    $sandbox['last_cid'] = 0;
    $sandbox['scanned'] = 0;
    $sandbox['processed'] = 0;
    $sandbox['total'] = (int) \Drupal::entityQuery('comment')
      ->accessCheck(FALSE)
      ->condition('comment_type', 'aculta_discussion_post')
      ->condition('field_name', 'field_aculta_discussion')
      ->condition('status', 1)
      ->count()
      ->execute();
  }

  // Writes only the missing marker rows. Saving each comment would run comment
  // presave and update hooks and bump its changed time, which reorders topics
  // by last activity and invalidates caches for a data-only backfill.
  $database = \Drupal::database();
  $batch = $database->select('comment_field_data', 'c')
    ->fields('c', ['cid', 'langcode', 'created'])
    ->condition('c.comment_type', 'aculta_discussion_post')
    ->condition('c.field_name', 'field_aculta_discussion')
    ->condition('c.status', 1)
    ->condition('c.cid', $sandbox['last_cid'], '>')
    ->orderBy('c.cid')
    ->range(0, 100)
    ->execute()
    ->fetchAll();
  if ($batch !== []) {
    $cids = array_map(static fn($row): int => (int) $row->cid, $batch);
    $marked = array_flip($database->select('comment__field_aculta_published_at', 'm')
      ->fields('m', ['entity_id'])
      ->condition('m.deleted', 0)
      ->condition('m.entity_id', $cids, 'IN')
      ->execute()
      ->fetchCol());

    $insert = $database->insert('comment__field_aculta_published_at')
      ->fields(['bundle', 'deleted', 'entity_id', 'revision_id', 'langcode', 'delta', 'field_aculta_published_at_value']);
    $missing = 0;
    foreach ($batch as $row) {
      if (!isset($marked[(int) $row->cid])) {
        // Existing content has no recoverable first-published event. The
        // creation time is the conservative bound: it never grants an author
        // more time than the policy allows. Non-revisionable comments store
        // their ID as revision_id.
        $insert->values([
          'bundle' => 'aculta_discussion_post',
          'deleted' => 0,
          'entity_id' => (int) $row->cid,
          'revision_id' => (int) $row->cid,
          'langcode' => $row->langcode,
          'delta' => 0,
          'field_aculta_published_at_value' => (int) $row->created,
        ]);
        $missing++;
      }
    }
    if ($missing > 0) {
      $insert->execute();
    }
    $sandbox['last_cid'] = end($cids);
    $sandbox['scanned'] += count($batch);
    $sandbox['processed'] += $missing;
  }

  $sandbox['#finished'] = $sandbox['total'] === 0 || count($batch) < 100
    ? 1
    : min(1, $sandbox['scanned'] / $sandbox['total']);

  return (string) t('Added first-publication markers to @count existing discussion comments.', [
    '@count' => $sandbox['processed'],
  ]);
}

/**
 * Installs the schema for the revisionable Forum post entity.
 */
function aculta_forum_update_9002(): void {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($definition_update_manager->getEntityType('aculta_forum_post')) {
    return;
  }

  $entity_type = \Drupal::entityTypeManager()->getDefinition('aculta_forum_post');
  $field_storage_definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('aculta_forum_post');
  $definition_update_manager->installFieldableEntityType($entity_type, $field_storage_definitions);
}

/**
 * Groups the category page by its parent taxonomy term.
 */
function aculta_forum_update_9003(): void {
  $config_name = 'views.view.aculta_forum_categories';
  $view = \Drupal::configFactory()->getEditable($config_name);
  if ($view->isNew()) {
    throw new RuntimeException('The ACULTA Forum categories View is missing.');
  }

  $fields = $view->get('display.default.display_options.fields');
  if (!is_array($fields) || !isset($fields['parent_name'])) {
    throw new RuntimeException('The parent category field is missing from the ACULTA Forum categories View.');
  }

  // Reuse the existing field handlers so any locally maintained field
  // settings are preserved. Only the page display changes; the landing block
  // and the default display remain untouched.
  $fields['parent_name']['admin_label'] = 'Título do grupo hierárquico';
  $fields['parent_name']['label'] = '';
  $fields['parent_name']['exclude'] = TRUE;
  $fields['parent_name']['element_type'] = 'h2';
  $fields['parent_name']['empty'] = 'Categoria raiz';
  $fields['parent_name']['hide_empty'] = FALSE;

  $page_path = 'display.page_categories.display_options';
  $view->set($page_path . '.defaults.fields', FALSE);
  $view->set($page_path . '.defaults.style', FALSE);
  $view->set($page_path . '.fields', $fields);

  $style = $view->get('display.default.display_options.style') ?? [
    'type' => 'default',
    'options' => [],
  ];
  $style['options']['grouping'] = [
    [
      'field' => 'parent_name',
      'rendered' => FALSE,
      'rendered_strip' => FALSE,
    ],
  ];
  $view->set($page_path . '.style', $style);
  $view->save();
}

/**
 * Uses heading levels that follow the category hierarchy on the page.
 */
function aculta_forum_update_9004(): void {
  $config_name = 'views.view.aculta_forum_categories';
  $view = \Drupal::configFactory()->getEditable($config_name);
  if ($view->isNew()) {
    throw new RuntimeException('The ACULTA Forum categories View is missing.');
  }

  $field_path = 'display.page_categories.display_options.fields.name.element_type';
  if ($view->get('display.page_categories.display_options.defaults.fields') !== FALSE) {
    throw new RuntimeException('The category page does not have its own field handlers.');
  }
  if ($view->get('display.page_categories.display_options.fields.name') === NULL) {
    throw new RuntimeException('The category name field is missing from the page display.');
  }

  $view->set($field_path, 'h3');
  $view->save();
}

/**
 * Invalidates public topic View caches when revisionable replies change.
 */
function aculta_forum_update_9005(): void {
  $configFactory = \Drupal::configFactory();
  $view = $configFactory->getEditable('views.view.aculta_forum_public_topics');
  if ($view->isNew()) {
    throw new RuntimeException('The ACULTA Forum public topics View is missing.');
  }

  $view->set('display.default.display_options.cache.type', 'aculta_forum_post_tag');
  $view->save();
}

/**
 * Installs schema tables and default config for discussion emoji reactions and user stats.
 */
function aculta_forum_update_9006(): void {
  $schema = \Drupal::database()->schema();
  $tables = aculta_forum_schema();

  if (!$schema->tableExists('aculta_discussion_reaction')) {
    $schema->createTable('aculta_discussion_reaction', $tables['aculta_discussion_reaction']);
  }

  if (!$schema->tableExists('aculta_discussion_reaction_user_stats')) {
    $schema->createTable('aculta_discussion_reaction_user_stats', $tables['aculta_discussion_reaction_user_stats']);
  }

  $config = \Drupal::configFactory()->getEditable('aculta_forum.settings');
  if ($config->get('reactions_enabled') === NULL) {
    $config->set('reactions_enabled', TRUE);
    $config->set('default_reaction', 'heart');
    $config->set('allowed_reactions', [
      ['id' => 'heart', 'icon' => 'heart', 'label' => 'Curtir', 'enabled' => TRUE],
      ['id' => 'thumbs_up', 'icon' => 'thumbs-up', 'label' => 'Apoiar', 'enabled' => TRUE],
      ['id' => 'seedling', 'icon' => 'seedling', 'label' => 'Cultivo', 'enabled' => TRUE],
      ['id' => 'herb', 'icon' => 'herb', 'label' => 'Botânica', 'enabled' => TRUE],
      ['id' => 'fire', 'icon' => 'fire', 'label' => 'Excelente', 'enabled' => TRUE],
      ['id' => 'clap', 'icon' => 'clapping-hands', 'label' => 'Aplausos', 'enabled' => TRUE],
      ['id' => 'laugh', 'icon' => 'grinning-squinting-face', 'label' => 'Engraçado', 'enabled' => TRUE],
      ['id' => 'pray', 'icon' => 'folded-hands', 'label' => 'Gratidão', 'enabled' => TRUE],
    ]);
    $config->save();
  }

  $role = \Drupal\user\Entity\Role::load('email_confirmed');
  if ($role !== NULL && !$role->hasPermission('react to aculta discussions')) {
    $role->grantPermission('react to aculta discussions');
    $role->save();
  }
}

