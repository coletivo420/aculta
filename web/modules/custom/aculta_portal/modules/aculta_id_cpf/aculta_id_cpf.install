<?php

/**
 * @file
 * Atualizações do aculta_id_cpf.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Adds a database-level unique constraint for current document fingerprints.
 *
 * @throws \RuntimeException
 *   When the field table is missing or contains duplicate fingerprints.
 */
function aculta_id_cpf_ensure_document_index_unique_key(): void {
  $table = 'profile__field_documento_indice';
  $key = 'aculta_id_cpf_documento_unique';
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists($table)) {
    throw new \RuntimeException('Document index storage table is unavailable.');
  }
  if ($schema->indexExists($table, $key)) {
    return;
  }

  $duplicateGroups = (int) \Drupal::database()->query(
    'SELECT COUNT(*) FROM (
      SELECT field_documento_indice_value
      FROM {' . $table . '}
      WHERE deleted = 0
        AND field_documento_indice_value IS NOT NULL
        AND field_documento_indice_value <> \'\'
      GROUP BY field_documento_indice_value
      HAVING COUNT(DISTINCT entity_id) > 1
    ) document_index_duplicates',
  )->fetchField();
  if ($duplicateGroups > 0) {
    throw new \RuntimeException(sprintf(
      'Document index constraint not created: %d duplicate group(s) require resolution.',
      $duplicateGroups,
    ));
  }

  $schema->addUniqueKey($table, $key, ['field_documento_indice_value']);
}

/**
 * Adds the fingerprint uniqueness constraint on fresh installations.
 */
function aculta_id_cpf_install(): void {
  aculta_id_cpf_ensure_document_index_unique_key();
}

/**
 * Cria o índice de unicidade e indexa os documentos gravados antes dele.
 *
 * Os valores continuam cifrados: o fingerprint é calculado a partir do documento decifrado, dentro da atualização.
 * Se dois perfis tiverem o mesmo documento, a atualização para com a contagem de conflitos (sem dados pessoais).
 */
function aculta_id_cpf_update_10001(array &$sandbox): string {
  if (!FieldStorageConfig::loadByName('profile', 'field_documento_indice')) {
    FieldStorageConfig::create([
      'field_name' => 'field_documento_indice',
      'entity_type' => 'profile',
      'type' => 'string',
      'settings' => ['max_length' => 64, 'case_sensitive' => FALSE, 'is_ascii' => TRUE],
      'indexes' => ['documento_indice' => ['value']],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!FieldConfig::loadByName('profile', 'participante', 'field_documento_indice')) {
    FieldConfig::create([
      'field_name' => 'field_documento_indice',
      'entity_type' => 'profile',
      'bundle' => 'participante',
      'label' => 'Índice de unicidade (fingerprint HMAC)',
      'description' => 'Não é o documento. Índice pseudonimizado, privado do perfil.',
      'required' => FALSE,
      'translatable' => FALSE,
      'third_party_settings' => ['profile' => ['profile_private' => TRUE]],
    ])->save();
  }

  $indexer = \Drupal::service('aculta_id_cpf.account_document');
  $storage = \Drupal::entityTypeManager()->getStorage('profile');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'participante')
    ->condition('field_documento', '', '<>')
    ->execute();
  $counts = ['indexed' => 0, 'conflict' => 0, 'empty' => 0];
  foreach ($storage->loadMultiple($ids) as $profile) {
    $counts[$indexer->indexStoredDocument($profile)]++;
  }
  if ($counts['conflict'] > 0) {
    throw new \RuntimeException(sprintf('Índice de unicidade interrompido: %d documento(s) duplicado(s) entre contas. Resolva antes de repetir.', $counts['conflict']));
  }
  return sprintf('Índice de unicidade criado. Documentos indexados: %d.', $counts['indexed']);
}

/**
 * Enforces uniqueness of active CPF/CNPJ fingerprints in Profile storage.
 */
function aculta_id_cpf_update_10002(): string {
  aculta_id_cpf_ensure_document_index_unique_key();
  return 'Unique document fingerprint constraint created.';
}
