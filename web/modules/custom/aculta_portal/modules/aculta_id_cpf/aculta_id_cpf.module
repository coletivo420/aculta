<?php

/**
 * @file
 * Form integration for ACULTA CPF identity.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function aculta_id_cpf_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!in_array($form_id, ['user_login_form', 'aculta_login_popup_form'], TRUE)) {
    return;
  }

  $validators = $form['#validate'] ?? [];
  $authentication_validator = 'aculta_portal.form_callbacks:validateLoginAuthentication';
  $authentication_index = array_search($authentication_validator, $validators, TRUE);
  if ($authentication_index === FALSE) {
    $authentication_validator = '::validateAuthentication';
    $authentication_index = array_search($authentication_validator, $validators, TRUE);
  }
  if ($authentication_index === FALSE) {
    return;
  }

  $resolve = 'aculta_id_cpf.login_form_callbacks:resolveIdentifier';
  $restore = 'aculta_id_cpf.login_form_callbacks:restoreIdentifier';
  if (in_array($resolve, $validators, TRUE) || in_array($restore, $validators, TRUE)) {
    return;
  }

  array_splice($validators, $authentication_index, 1, [
    $resolve,
    $authentication_validator,
    $restore,
  ]);
  $form['#validate'] = $validators;
}
