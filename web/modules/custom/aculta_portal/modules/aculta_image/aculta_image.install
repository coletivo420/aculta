<?php

/**
 * @file
 * Instalação e atualizações do aculta_image.
 */

/**
 * Implements hook_schema().
 */
function aculta_image_schema(): array {
  $schema['aculta_image_origin'] = [
    'description' => 'Origem de cada imagem ingerida de fora do site (URL e captura), por SHA-256 do conteúdo.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'fid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'File entity usado.'],
      'sha256' => ['type' => 'char', 'length' => 64, 'not null' => TRUE],
      'source_url' => ['type' => 'varchar', 'length' => 2048, 'not null' => TRUE, 'default' => ''],
      'captured_at' => ['type' => 'int', 'not null' => FALSE, 'description' => 'Data da captura na origem.'],
      'imported_at' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => ['sha256' => ['sha256'], 'fid' => ['fid']],
  ];
  return $schema;
}

/**
 * Cria a tabela de origem das imagens ingeridas.
 */
function aculta_image_update_10001(): void {
  $schema = aculta_image_schema();
  $database = \Drupal::database();
  if (!$database->schema()->tableExists('aculta_image_origin')) {
    $database->schema()->createTable('aculta_image_origin', $schema['aculta_image_origin']);
  }
}
