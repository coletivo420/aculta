        'generation_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'provider_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'source_entity_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
        'source_entity_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
        'source_langcode' => ['type' => 'varchar', 'length' => 12, 'not null' => TRUE],
        'relation_type' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'target_entity_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
