/**
 * Implements hook_install().
 */
function aculta_index_install(): void {
  \Drupal::database()->insert('aculta_index_state')
    ->fields([
      'state_id' => 1,
      'active_generation' => '',
      'revision' => 0,
      'updated' => \Drupal::time()->getRequestTime(),
    ])
    ->execute();
  \Drupal::database()->insert('aculta_index_audit')
    ->fields([
      'audit_id' => 1,
      'status' => 'idle',
      'phase' => 'entries',
      'created' => \Drupal::time()->getRequestTime(),
      'updated' => \Drupal::time()->getRequestTime(),
    ])
    ->execute();
}

/**
 * Adds a compare-and-swap revision to resumable rebuild checkpoints.
 */
function aculta_index_update_10001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_generation')) {
    return;
  }
  if (!$schema->fieldExists('aculta_index_generation', 'cursor_revision')) {
    $schema->addField('aculta_index_generation', 'cursor_revision', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Adds the source change sequence used to reject stale projection jobs.
 */
function aculta_index_update_10002(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_entry')) {
    return;
  }
  if (!$schema->fieldExists('aculta_index_entry', 'source_sequence')) {
    $schema->addField('aculta_index_entry', 'source_sequence', [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Adds durable incremental work and failure state.
 */
function aculta_index_update_10003(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_work')) {
    $schema->createTable('aculta_index_work', aculta_index_schema()['aculta_index_work']);
  }
}

/**
 * Adds provider-inventory identity to resumable generations.
 */
function aculta_index_update_10004(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_generation')) {
    return;
  }
  if (!$schema->fieldExists('aculta_index_generation', 'provider_fingerprint')) {
    $schema->addField('aculta_index_generation', 'provider_fingerprint', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => TRUE,
      'default' => '',
    ]);
  }
}

/**
 * Adds opaque query cursor storage.
 */
function aculta_index_update_10005(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_cursor')) {
    $schema->createTable('aculta_index_cursor', aculta_index_schema()['aculta_index_cursor']);
  }
}

/**
 * Adds compare-and-swap revision to persisted query cursors.
 */
function aculta_index_update_10006(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('aculta_index_cursor') && !$schema->fieldExists('aculta_index_cursor', 'cursor_revision')) {
    $schema->addField('aculta_index_cursor', 'cursor_revision', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Adds the keyset order index used by bounded query pages.
 */
function aculta_index_update_10007(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_entry')) {
    return;
  }
  if (!$schema->indexExists('aculta_index_entry', 'gen_changed')) {
    $schema->addIndex('aculta_index_entry', 'gen_changed', ['generation_id', 'changed', 'entry_id'], aculta_index_schema()['aculta_index_entry']);
  }
}

/**
 * Records completion of a generation's backfill before validation.
 */
function aculta_index_update_10008(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_generation')) {
    return;
  }
  if (!$schema->fieldExists('aculta_index_generation', 'backfill_completed')) {
    $schema->addField('aculta_index_generation', 'backfill_completed', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Adds the checkpoint used by bounded incremental catalog audits.
 */
function aculta_index_update_10009(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_audit')) {
    $schema->createTable('aculta_index_audit', aculta_index_schema()['aculta_index_audit']);
  }
  if (!\Drupal::database()->select('aculta_index_audit', 'audit')->condition('audit_id', 1)->countQuery()->execute()->fetchField()) {
    \Drupal::database()->insert('aculta_index_audit')
      ->fields([
        'audit_id' => 1,
        'status' => 'idle',
        'phase' => 'entries',
        'created' => \Drupal::time()->getRequestTime(),
        'updated' => \Drupal::time()->getRequestTime(),
      ])
      ->execute();
  }
}

/**
 * Records the provider projection version on each catalog entry.
 */
function aculta_index_update_10010(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('aculta_index_entry') && !$schema->fieldExists('aculta_index_entry', 'provider_version')) {
    $schema->addField('aculta_index_entry', 'provider_version', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 1,
    ]);
  }
}

/**
 * Replaces the mutable changed sort index with the immutable ID keyset index.
 */
function aculta_index_update_10011(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_entry')) {
    return;
  }
  if ($schema->indexExists('aculta_index_entry', 'gen_changed')) {
    $schema->dropIndex('aculta_index_entry', 'gen_changed');
  }
  if (!$schema->indexExists('aculta_index_entry', 'gen_entry_id')) {
    $schema->addIndex('aculta_index_entry', 'gen_entry_id', ['generation_id', 'entry_id'], aculta_index_schema()['aculta_index_entry']);
  }
}

/**
 * Adds the relation type to the outgoing-source lookup index.
 */
function aculta_index_update_10012(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_relation')) {
    return;
  }
  if ($schema->indexExists('aculta_index_relation', 'gen_source')) {
    $schema->dropIndex('aculta_index_relation', 'gen_source');
  }
  $table = aculta_index_schema()['aculta_index_relation'];
  $schema->addIndex('aculta_index_relation', 'gen_source', $table['indexes']['gen_source'], $table);
}

/**
 * Adds the finding counter for stale active-generation provider projections.
 */
function aculta_index_update_10013(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('aculta_index_audit') && !$schema->fieldExists('aculta_index_audit', 'stale_projection_count')) {
    $schema->addField('aculta_index_audit', 'stale_projection_count', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Adds a monotonic revision for safe candidate cache invalidation.
 */
function aculta_index_update_10014(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('aculta_index_generation') && !$schema->fieldExists('aculta_index_generation', 'candidate_revision')) {
    $schema->addField('aculta_index_generation', 'candidate_revision', [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Adds source reconciliation counters to the incremental audit checkpoint.
 */
function aculta_index_update_10015(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_audit')) {
    return;
  }
  foreach (['missing_source_count', 'unverified_source_count'] as $field) {
    if (!$schema->fieldExists('aculta_index_audit', $field)) {
      $schema->addField('aculta_index_audit', $field, [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ]);
    }
  }
}

/**
 * Adds keyset state for source-to-catalog reconciliation.
 */
function aculta_index_update_10016(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_audit')) {
    return;
  }
  $fields = [
    'source_provider_cursor' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
    'source_entity_type_cursor' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
    'source_entity_id_cursor' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
    'missing_catalog_entry_count' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
  ];
  foreach ($fields as $field => $specification) {
    if (!$schema->fieldExists('aculta_index_audit', $field)) {
      $schema->addField('aculta_index_audit', $field, $specification);
    }
  }
}

/**
 * Adds the captured source ID ceiling for finite audit keyset windows.
 */
function aculta_index_update_10017(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_index_audit')) {
    return;
  }
  if (!$schema->fieldExists('aculta_index_audit', 'source_entity_max_id')) {
    $schema->addField('aculta_index_audit', 'source_entity_max_id', [
      'type' => 'varchar',
      'length' => 255,
      'not null' => TRUE,
      'default' => '',
    ]);
  }
  // A running audit has no ceiling for its current source/type cursor. Restart
  // that derived scan on the next cron/manual batch rather than treating the
  // empty migration default as an already captured empty window.
  \Drupal::database()->update('aculta_index_audit')
    ->fields(['status' => 'idle'])
    ->condition('status', 'running')
    ->execute();
}
