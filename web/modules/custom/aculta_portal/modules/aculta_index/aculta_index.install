        'audit_id' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
        'revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'idle'],
        'phase' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'entries'],
        'cursor_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'source_provider_cursor' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
        'source_entity_type_cursor' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
        'source_entity_id_cursor' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
        'source_entity_max_id' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
        'entry_max_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
