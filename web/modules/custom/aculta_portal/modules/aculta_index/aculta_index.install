        'target_langcode' => ['type' => 'varchar', 'length' => 12, 'not null' => TRUE],
        'relation_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'updated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      ],
      'primary key' => ['relation_id'],
      'unique keys' => [
