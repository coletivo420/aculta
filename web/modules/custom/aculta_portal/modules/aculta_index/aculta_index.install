        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'generation_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'query_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'cursor_changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'cursor_entry_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'cursor_revision' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'expires' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'updated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
