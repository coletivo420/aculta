<?php

declare(strict_types=1);

use Drupal\Core\Entity\ContentEntityInterface;

/**
 * Implements hook_entity_insert().
 */
function aculta_index_entity_insert(\Drupal\Core\Entity\EntityInterface $entity): void {
  aculta_index_schedule_source_change($entity, 'project');
}

/**
 * Implements hook_entity_update().
 */
function aculta_index_entity_update(\Drupal\Core\Entity\EntityInterface $entity): void {
  aculta_index_schedule_source_change($entity, 'project');
}

/**
 * Implements hook_entity_delete().
 */
function aculta_index_entity_delete(\Drupal\Core\Entity\EntityInterface $entity): void {
  aculta_index_schedule_source_change($entity, 'delete');
}

/**
 * Implements hook_entity_translation_delete().
 */
function aculta_index_entity_translation_delete(\Drupal\Core\Entity\EntityInterface $translation): void {
  aculta_index_schedule_one_translation($translation, 'delete');
}

/**
 * Implements hook_cron().
 */
function aculta_index_cron(): void {
  \Drupal::service('aculta_index.work_manager')->recover();
}

/**
 * Schedules all supported translations of a changed source entity.
 */
function aculta_index_schedule_source_change(\Drupal\Core\Entity\EntityInterface $entity, string $operation): void {
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }
  foreach ($entity->getTranslationLanguages() as $langcode => $language) {
    if ($entity->hasTranslation($langcode)) {
      aculta_index_schedule_one_translation($entity->getTranslation($langcode), $operation);
    }
  }
}

/**
 * Schedules one translation only when an enabled provider owns its bundle.
 */
function aculta_index_schedule_one_translation(\Drupal\Core\Entity\EntityInterface $entity, string $operation): void {
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }
  $providers = \Drupal::service('aculta_index.provider_registry');
  $providerId = $providers->findProviderIdForBundle($entity->getEntityTypeId(), $entity->bundle());
  if ($providerId !== NULL) {
    \Drupal::service('aculta_index.work_manager')->schedule(
      $providerId,
      $entity->getEntityTypeId(),
      (string) $entity->id(),
      $entity->language()->getId(),
      $operation,
    );
  }
}

