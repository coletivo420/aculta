<?php

declare(strict_types=1);

use Drupal\aculta_portal\Hook\EntityHooks;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Bridges the production Portal policy into this isolated integration fixture.
 */
function aculta_index_wiki_access_test_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): ?AccessResultInterface {
  return \Drupal::service(EntityHooks::class)->entityAccess($entity, $operation, $account);
}

