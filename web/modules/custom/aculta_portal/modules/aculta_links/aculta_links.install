<?php

declare(strict_types=1);

/**
 * Installs the revisionable visual preset field on existing micropages.
 */
function aculta_links_update_10001(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('theme_preset', 'aculta_link_page') === NULL) {
    $definitions = \Drupal::service('entity_field.manager')
      ->getBaseFieldDefinitions('aculta_link_page');
    $update_manager->installFieldStorageDefinition(
      'theme_preset',
      'aculta_link_page',
      'aculta_links',
      $definitions['theme_preset'],
    );
  }

  return 'Adicionado o campo revisionável de preset visual às micropáginas existentes.';
}

/**
 * Moves the public social-links configuration into ACULTA Links.
 */
function aculta_links_update_10002(): string {
  $config_storage = \Drupal::service('config.storage');
  if ($config_storage->read('aculta_links.social_links') !== FALSE) {
    return 'The ACULTA Links social configuration already exists; no values were changed.';
  }

  $source = $config_storage->read('aculta_portal.social_links') ?: [];
  $data = array_replace([
    'instagram' => '',
    'youtube' => '',
    'facebook' => '',
    'buttons' => [],
  ], array_intersect_key($source, array_flip(['instagram', 'youtube', 'facebook', 'buttons'])));
  \Drupal::configFactory()
    ->getEditable('aculta_links.social_links')
    ->setData($data)
    ->save();

  return 'Copied the existing ACULTA social-links values; the legacy configuration was preserved for rollback.';
}

/**
 * Installs revisionable availability-window fields on existing page items.
 */
function aculta_links_update_10003(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $definitions = \Drupal::service('entity_field.manager')
    ->getBaseFieldDefinitions('aculta_link_item');
  foreach (['available_from', 'available_until'] as $field_name) {
    if ($update_manager->getFieldStorageDefinition($field_name, 'aculta_link_item') === NULL) {
      $update_manager->installFieldStorageDefinition(
        $field_name,
        'aculta_link_item',
        'aculta_links',
        $definitions[$field_name],
      );
    }
  }

  return 'Added revisionable availability-window fields to existing ACULTA Links items; existing items remain immediately available with no end date.';
}

