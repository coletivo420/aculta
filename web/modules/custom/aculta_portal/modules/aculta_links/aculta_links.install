<?php

declare(strict_types=1);

/**
 * Installs the revisionable visual preset field on existing micropages.
 */
function aculta_links_update_10001(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('theme_preset', 'aculta_link_page') === NULL) {
    $definitions = \Drupal::service('entity_field.manager')
      ->getBaseFieldDefinitions('aculta_link_page');
    $update_manager->installFieldStorageDefinition(
      'theme_preset',
      'aculta_link_page',
      'aculta_links',
      $definitions['theme_preset'],
    );
  }

  return 'Adicionado o campo revisionável de preset visual às micropáginas existentes.';
}

/**
 * Moves the public social-links configuration into ACULTA Links.
 */
function aculta_links_update_10002(): string {
  $config_storage = \Drupal::service('config.storage');
  if ($config_storage->read('aculta_links.social_links') !== FALSE) {
    return 'The ACULTA Links social configuration already exists; no values were changed.';
  }

  $source = $config_storage->read('aculta_portal.social_links') ?: [];
  $data = array_replace([
    'instagram' => '',
    'youtube' => '',
    'facebook' => '',
    'buttons' => [],
  ], array_intersect_key($source, array_flip(['instagram', 'youtube', 'facebook', 'buttons'])));
  \Drupal::configFactory()
    ->getEditable('aculta_links.social_links')
    ->setData($data)
    ->save();

  return 'Copied the existing ACULTA social-links values; the legacy configuration was preserved for rollback.';
}

/**
 * Installs revisionable availability-window fields on existing page items.
 */
function aculta_links_update_10003(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $definitions = \Drupal::service('entity_field.manager')
    ->getBaseFieldDefinitions('aculta_link_item');
  foreach (['available_from', 'available_until'] as $field_name) {
    if ($update_manager->getFieldStorageDefinition($field_name, 'aculta_link_item') === NULL) {
      $update_manager->installFieldStorageDefinition(
        $field_name,
        'aculta_link_item',
        'aculta_links',
        $definitions[$field_name],
      );
    }
  }

  return 'Added revisionable availability-window fields to existing ACULTA Links items; existing items remain immediately available with no end date.';
}

/**
 * Installs the generated short-code field on existing reusable destinations.
 */
function aculta_links_update_10004(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('short_code', 'aculta_link') === NULL) {
    $definitions = \Drupal::service('entity_field.manager')
      ->getBaseFieldDefinitions('aculta_link');
    $update_manager->installFieldStorageDefinition(
      'short_code',
      'aculta_link',
      'aculta_links',
      $definitions['short_code'],
    );
  }

  return 'Added the opaque short-code field; existing destinations receive a code when next saved.';
}

/**
 * Installs the opt-in public owner identity field on existing microsites.
 */
function aculta_links_update_10005(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('show_owner_identity', 'aculta_link_page') === NULL) {
    $definitions = \Drupal::service('entity_field.manager')
      ->getBaseFieldDefinitions('aculta_link_page');
    $update_manager->installFieldStorageDefinition(
      'show_owner_identity',
      'aculta_link_page',
      'aculta_links',
      $definitions['show_owner_identity'],
    );
  }

  return 'Added the opt-in public owner identity field to existing microsites; existing pages keep the default disabled.';
}

/**
 * Installs the daily aggregate storage for privacy-minimized analytics.
 */
function aculta_links_update_10006(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_links_stat_daily')) {
    $schema->createTable('aculta_links_stat_daily', aculta_links_schema()['aculta_links_stat_daily']);
  }

  return 'Installed the daily aggregate table for link clicks; no visitor identifiers are stored.';
}

/**
 * Defines storage for daily aggregate analytics.
 */
function aculta_links_schema(): array {
  return [
    'aculta_links_stat_daily' => [
      'description' => 'Daily aggregate counts for privacy-minimized ACULTA Links events.',
      'fields' => [
        'event' => [
          'type' => 'varchar',
          'length' => 16,
          'not null' => TRUE,
        ],
        'target_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'event_date' => [
          'type' => 'varchar',
          'length' => 10,
          'not null' => TRUE,
        ],
        'count' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['event', 'target_id', 'event_date'],
      'indexes' => [
        'event_date' => ['event_date'],
      ],
    ],
  ];
}
