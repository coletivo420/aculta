<main aria-labelledby="aculta-links-landing-title">
  <h1 id="aculta-links-landing-title">{{ title }}</h1>
  {% if description %}
    <p>{{ description }}</p>
  {% endif %}
  {% if has_links %}
    {{ links }}
  {% endif %}
  {% if has_projects %}
    <section aria-labelledby="aculta-links-landing-projects-title">
      <h2 id="aculta-links-landing-projects-title">{{ 'Projetos da ACULTA'|t }}</h2>
      {{ projects }}
    </section>
  {% endif %}
</main>
