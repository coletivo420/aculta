/**
 * Cliques passaram a ser contados pelo aculta_statistics (ADR-0004).
 *
 * A tabela própria foi criada aqui antes da centralização e é removida em
 * aculta_linkweed_update_10008(). Nenhum dado é migrado: o banco é de teste.
 */
function aculta_linkweed_update_10006(): string {
  return 'Cliques de links passam ao aculta_statistics; a tabela própria é removida na atualização 10008.';
}

/**
 * Installs the Drupal node-reference destination on existing reusable links.
 */
function aculta_linkweed_update_10007(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('target_node', 'aculta_linkweed') === NULL) {
    $definitions = \Drupal::service('entity_field.manager')
      ->getBaseFieldDefinitions('aculta_linkweed');
    $update_manager->installFieldStorageDefinition(
      'target_node',
      'aculta_linkweed',
      'aculta_linkweed',
      $definitions['target_node'],
    );
  }

  return 'Added the revisionable node-reference destination field; existing URI destinations remain unchanged.';
}

/**
 * Remove a tabela própria de cliques: a contagem agora é do aculta_statistics (ADR-0004).
 *
 * Sem migração: o banco de teste não retém esses agregados.
 */
function aculta_linkweed_update_10008(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('aculta_linkweed_stat_daily')) {
    $schema->dropTable('aculta_linkweed_stat_daily');
  }

  return 'Removed the link click table; clicks are counted by aculta_statistics.';
}

/**
 * Renames the LinkWeed module, entity types, tables, and active configuration.
 */
function aculta_linkweed_update_10009(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  $tables = [
    'aculta_link' => 'aculta_linkweed',
    'aculta_link_revision' => 'aculta_linkweed_revision',
    'aculta_link_item' => 'aculta_linkweed_item',
    'aculta_link_item_revision' => 'aculta_linkweed_item_revision',
    'aculta_link_page' => 'aculta_linkweed_page',
    'aculta_link_page_revision' => 'aculta_linkweed_page_revision',
  ];
  foreach ($tables as $old => $new) {
    if ($schema->tableExists($old) && !$schema->tableExists($new)) {
      $schema->renameTable($old, $new);
    }
  }

  foreach (['entity.definitions.installed', 'entity.storage_schema.sql'] as $collection_name) {
    $collection = \Drupal::keyValue($collection_name);
    foreach ($collection->getAll() as $key => $value) {
      if (strpos($key, 'aculta_link') !== 0) {
        continue;
      }
      $new_key = aculta_linkweed_rename_value($key);
      $collection->set($new_key, aculta_linkweed_rename_value($value));
      if ($new_key !== $key) {
        $collection->delete($key);
      }
    }
  }

  $config = \Drupal::configFactory()->getEditable('core.extension');
  $modules = $config->get('module') ?: [];
  if (isset($modules['aculta_links']) && !isset($modules['aculta_linkweed'])) {
    $weight = $modules['aculta_links'];
    unset($modules['aculta_links']);
    $modules['aculta_linkweed'] = $weight;
    $config->set('module', $modules)->save();
  }

  $storage = \Drupal::service('config.storage');
  foreach ($storage->listAll('aculta_links.') as $name) {
    $new_name = aculta_linkweed_rename_value($name);
    $data = $storage->read($name);
    $storage->write($new_name, aculta_linkweed_rename_value($data));
    $storage->delete($name);
  }
  foreach ($storage->listAll() as $name) {
    $data = $storage->read($name);
    $renamed = aculta_linkweed_rename_value($data);
    if ($renamed !== $data) {
      $storage->write($name, $renamed);
    }
  }

  aculta_linkweed_repair_installed_entity_definitions();

  return 'Renomeados o módulo LinkWeed, suas entidades, tabelas, schema e configurações ativas.';
}

/** Recursively renames LinkWeed identifiers without corrupting serialized values. */
function aculta_linkweed_rename_value(mixed $value): mixed {
  if (is_string($value)) {
    return str_replace(
      ['aculta_linkweedweed_page', 'aculta_linkweedweed_item', 'aculta_linkweedweed', 'aculta_links', 'aculta_link_page', 'aculta_link_item', 'aculta_link'],
      ['aculta_linkweed_page', 'aculta_linkweed_item', 'aculta_linkweed', 'aculta_linkweed', 'aculta_linkweed_page', 'aculta_linkweed_item', 'aculta_linkweed'],
      $value,
    );
  }
  if (is_array($value)) {
    $renamed = [];
    foreach ($value as $key => $item) {
      $renamed[aculta_linkweed_rename_value($key)] = aculta_linkweed_rename_value($item);
    }
    return $renamed;
  }
  return $value;
}

/** Repairs identifiers produced by the first idempotent migration pass. */
function aculta_linkweed_update_10010(): string {
  $repair = static function (mixed $value) use (&$repair): mixed {
    if (is_string($value)) {
      return str_replace('aculta_linkweedweed', 'aculta_linkweed', $value);
    }
    if (is_array($value)) {
      $out = [];
      foreach ($value as $key => $item) {
        $out[$repair($key)] = $repair($item);
      }
      return $out;
    }
    return $value;
  };
  foreach (['entity.definitions.installed', 'entity.storage_schema.sql'] as $name) {
    $store = \Drupal::keyValue($name);
    foreach ($store->getAll() as $key => $value) {
      $new_key = $repair($key);
      $store->set($new_key, $repair($value));
      if ($new_key !== $key) {
        $store->delete($key);
      }
    }
  }
  $storage = \Drupal::service('config.storage');
  foreach ($storage->listAll('aculta_linkweedweed.') as $name) {
    $storage->write($repair($name), $repair($storage->read($name)));
    $storage->delete($name);
  }
  return 'Corrigidos os identificadores duplicados da migração LinkWeed.';
}

/**
 * Rewrites installed definition objects after entity type IDs have changed.
 *
 * The rename passes above can rename key-value keys and arrays, but entity
 * type and field storage definitions are objects. Their embedded entity type
 * IDs must come from the active definitions, or Core fails while calculating
 * the change list (before update hooks can run).
 */
function aculta_linkweed_repair_installed_entity_definitions(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_field_manager = \Drupal::service('entity_field.manager');
  $repository = \Drupal::service('entity.last_installed_schema.repository');

  $entity_type_manager->useCaches(FALSE);
  $entity_field_manager->useCaches(FALSE);
  try {
    foreach (['aculta_linkweed', 'aculta_linkweed_item', 'aculta_linkweed_page'] as $entity_type_id) {
      if (!$entity_type_manager->hasDefinition($entity_type_id)) {
        continue;
      }
      $repository->setLastInstalledDefinition($entity_type_manager->getDefinition($entity_type_id));
      $repository->setLastInstalledFieldStorageDefinitions(
        $entity_type_id,
        $entity_field_manager->getFieldStorageDefinitions($entity_type_id),
      );
    }
  }
  finally {
    $entity_type_manager->useCaches(TRUE);
    $entity_field_manager->useCaches(TRUE);
  }
}

/** Repairs stale serialized IDs before Core's pending entity updates run. */
function aculta_linkweed_update_10011(): string {
  aculta_linkweed_repair_installed_entity_definitions();

  return 'Alinhadas as definições instaladas das entidades LinkWeed aos tipos e campos ativos.';
}

/**
 * Reconciles installed schema metadata for revision and availability fields.
 */
function aculta_linkweed_update_10013(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $field_manager = \Drupal::service('entity_field.manager');
  $updated = [];
  foreach ([
    'aculta_linkweed_item' => ['revision_uid', 'available_from', 'available_until'],
    'aculta_linkweed_page' => ['revision_uid'],
  ] as $entity_type_id => $field_names) {
    $current = $field_manager->getFieldStorageDefinitions($entity_type_id);
    foreach ($field_names as $field_name) {
      $original = $manager->getFieldStorageDefinition($field_name, $entity_type_id);
      if ($original !== NULL && isset($current[$field_name])) {
        $manager->updateFieldStorageDefinition($current[$field_name]);
        $updated[] = "$entity_type_id.$field_name";
      }
    }
  }

  return $updated
    ? 'Reconciled installed schema metadata for: ' . implode(', ', $updated) . '.'
    : 'LinkWeed field schema metadata was already current.';
}

