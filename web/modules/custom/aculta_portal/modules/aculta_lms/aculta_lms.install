<?php

/**
 * @file
 * Install and update hooks for ACULTA LMS.
 */

declare(strict_types=1);

/** Installs the append-only attempt archive entity definition. */
function aculta_lms_update_10001(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_lms_attempt_archive'));
}

/** Installs the certificate storage definition. */
function aculta_lms_update_10002(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $definition = \Drupal::entityTypeManager()->getDefinition('aculta_lms_certificate');
  if (!$manager->getEntityType('aculta_lms_certificate')) {
    $manager->installEntityType($definition);
  }
}

/** Installs the xAPI statement storage (ADR-041, D-67). */
function aculta_lms_update_10003(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('aculta_lms_xapi_statement')) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_lms_xapi_statement'));
  }
}

/**
 * Implements hook_requirements().
 *
 * Uploads of file answers need the private file system (ported from lms_file_upload).
 */
function aculta_lms_requirements(string $phase): array {
  $requirements = [];
  if (\Drupal\Core\Site\Settings::get('file_private_path') === NULL) {
    $requirements['aculta_lms_file_upload'] = [
      'title' => t('LMS file upload'),
      'value' => t('The private file system has not been configured.'),
      'description' => t('The private file system is required for storing student uploaded files. Configure it at <a href=":url">file system settings</a>.', [
        ':url' => \Drupal\Core\Url::fromRoute('system.file_system_settings')->toString(),
      ]),
      'severity' => \Drupal\Core\Extension\Requirement\RequirementSeverity::Error,
    ];
  }
  return $requirements;
}
