<?php

/**
 * @file
 * Install and update hooks for ACULTA LMS.
 */

declare(strict_types=1);

/** Installs the append-only attempt archive entity definition. */
function aculta_lms_update_10001(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_lms_attempt_archive'));
}

/** Installs the certificate storage definition. */
function aculta_lms_update_10002(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $definition = \Drupal::entityTypeManager()->getDefinition('aculta_lms_certificate');
  if (!$manager->getEntityType('aculta_lms_certificate')) {
    $manager->installEntityType($definition);
  }
}

/** Installs the xAPI statement storage (ADR-041, D-67). */
function aculta_lms_update_10003(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('aculta_lms_xapi_statement')) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_lms_xapi_statement'));
  }
}

/**
 * Implements hook_requirements().
 *
 * Uploads of file answers need the private file system (ported from lms_file_upload).
 */
function aculta_lms_requirements(string $phase): array {
  $requirements = [];
  if (\Drupal\Core\Site\Settings::get('file_private_path') === NULL) {
    $requirements['aculta_lms_file_upload'] = [
      'title' => t('LMS file upload'),
      'value' => t('The private file system has not been configured.'),
      'description' => t('The private file system is required for storing student uploaded files. Configure it at <a href=":url">file system settings</a>.', [
        ':url' => \Drupal\Core\Url::fromRoute('system.file_system_settings')->toString(),
      ]),
      'severity' => \Drupal\Core\Extension\Requirement\RequirementSeverity::Error,
    ];
  }
  return $requirements;
}

/** Installs the certificate template definition (modelo separado do registro emitido). */
function aculta_lms_update_10004(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('aculta_lms_certificate_template')) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_lms_certificate_template'));
  }
}

/** Installs the four ACULTA-owned learning entities (ADR-042, P2). */
function aculta_lms_update_10005(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();
  foreach (['aculta_lms_lesson', 'aculta_lms_activity', 'aculta_lms_answer', 'aculta_lms_progress'] as $entity_type_id) {
    if (!$manager->getEntityType($entity_type_id)) {
      $manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
    }
  }
}

/** Aligns required columns and constrained list lengths for the P2 tables. */
function aculta_lms_update_10006(): void {
  $database_schema = \Drupal::database()->schema();
  $required_columns = [
    'aculta_lms_lesson' => [
      'course_id' => ['type' => 'int', 'not null' => TRUE],
      'title' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'published' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE],
      'weight' => ['type' => 'int', 'not null' => TRUE],
      'changed' => ['type' => 'int', 'not null' => TRUE],
    ],
    'aculta_lms_activity' => [
      'lesson_id' => ['type' => 'int', 'not null' => TRUE],
      'type' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'graded' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE],
      'weight' => ['type' => 'int', 'not null' => TRUE],
      'changed' => ['type' => 'int', 'not null' => TRUE],
    ],
    'aculta_lms_answer' => [
      'activity_id' => ['type' => 'int', 'not null' => TRUE],
      'uid' => ['type' => 'int', 'not null' => TRUE],
      'state' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'created' => ['type' => 'int', 'not null' => TRUE],
      'changed' => ['type' => 'int', 'not null' => TRUE],
    ],
    'aculta_lms_progress' => [
      'course_id' => ['type' => 'int', 'not null' => TRUE],
      'uid' => ['type' => 'int', 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'finished' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE],
      'changed' => ['type' => 'int', 'not null' => TRUE],
    ],
  ];
  foreach ($required_columns as $table => $columns) {
    foreach ($columns as $column => $specification) {
      if (!$database_schema->tableExists($table) || !$database_schema->fieldExists($table, $column)) {
        continue;
      }
      $database_schema->changeField($table, $column, $column, $specification);
    }
  }
}

/** Copies Group class permission mappings into ACULTA-owned configuration. */
function aculta_lms_update_10007(): void {
  $config_factory = \Drupal::configFactory();
  $legacy = $config_factory->get('lms_classes.settings');
  $current = $config_factory->get('aculta_lms.settings');
  $editable = $config_factory->getEditable('aculta_lms.settings');
  foreach (['class_permission_mappings', 'course_permission_mappings'] as $mapping) {
    $editable->set($mapping, array_replace(
      (array) ($legacy->get($mapping) ?? []),
      (array) ($current->get($mapping) ?? []),
    ));
  }
  $editable->save();
}

/** Adds the immutable JSON payload field to ACULTA answer attempts. */
function aculta_lms_update_10008(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getFieldStorageDefinition('answer_data', 'aculta_lms_answer')) {
    return;
  }
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_lms_answer');
  $manager->installFieldStorageDefinition('answer_data', 'aculta_lms_answer', 'aculta_lms', $fields['answer_data']);
}

/** Adds Core comments to ACULTA answer attempts. */
function aculta_lms_update_10009(): void {
  $comment_type_storage = \Drupal::entityTypeManager()->getStorage('comment_type');
  if (!$comment_type_storage->load('aculta_lms_answer_comment')) {
    $comment_type_storage->create([
      'id' => 'aculta_lms_answer_comment',
      'label' => 'Comentário da resposta ACULTA',
      'target_entity_type_id' => 'aculta_lms_answer',
      'description' => '',
      'status' => TRUE,
    ])->save();
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage_config_storage = $entity_type_manager->getStorage('field_storage_config');
  if (!$field_storage_config_storage->load('aculta_lms_answer.comments')) {
    $field_storage_config_storage->create([
      'field_name' => 'comments',
      'entity_type' => 'aculta_lms_answer',
      'type' => 'comment',
      'settings' => ['comment_type' => 'aculta_lms_answer_comment'],
      'module' => 'comment',
      'locked' => TRUE,
      'cardinality' => 1,
      'translatable' => TRUE,
      'persist_with_no_fields' => FALSE,
      'custom_storage' => FALSE,
    ])->save();
  }

  $field_config_storage = \Drupal::entityTypeManager()->getStorage('field_config');
  if (!$field_config_storage->load('aculta_lms_answer.aculta_lms_answer.comments')) {
    $field_config_storage->create([
      'field_name' => 'comments',
      'entity_type' => 'aculta_lms_answer',
      'bundle' => 'aculta_lms_answer',
      'label' => 'Comentários da resposta',
      'required' => TRUE,
      'translatable' => TRUE,
      'default_value' => [[
        'status' => 2,
        'cid' => 0,
        'last_comment_timestamp' => 0,
        'last_comment_name' => NULL,
        'last_comment_uid' => 0,
        'comment_count' => 0,
      ]],
      'settings' => [
        'default_mode' => 1,
        'per_page' => 50,
        'anonymous' => 0,
        'form_location' => TRUE,
        'preview' => 1,
      ],
    ])->save();
  }
}

/** Adds the missing Core comment body field for existing answer comments. */
function aculta_lms_update_10010(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_config_storage = $entity_type_manager->getStorage('field_config');
  $comment_body = $field_config_storage->load('comment.aculta_lms_answer_comment.comment_body');
  if (!$comment_body) {
    $comment_body = $field_config_storage->create([
      'uuid' => '2d34480d-1f59-4d31-86c2-829ef03786ac',
      'field_name' => 'comment_body',
      'entity_type' => 'comment',
      'bundle' => 'aculta_lms_answer_comment',
      'label' => 'Comentário',
      'description' => '',
      'required' => FALSE,
      'translatable' => TRUE,
      'default_value' => [],
      'default_value_callback' => '',
      'settings' => ['allowed_formats' => []],
    ]);
  }
  $comment_body->save();
}

/** Adds a precision field without changing existing integer score storage. */
function aculta_lms_update_10011(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $installed = $manager->getFieldStorageDefinition('score_precise', 'aculta_lms_attempt_archive');
  if ($installed) {
    return;
  }
  $definitions = \Drupal::service('entity_field.manager')
    ->getBaseFieldDefinitions('aculta_lms_attempt_archive');
  $manager->installFieldStorageDefinition('score_precise', 'aculta_lms_attempt_archive', 'aculta_lms', $definitions['score_precise']);
}

/** Keeps course-to-class Group relationships owned by ACULTA after P5. */
function aculta_lms_update_10012(): void {
  $name = 'group.relationship_type.lms_course-lms_classes';
  $config = \Drupal::configFactory()->getEditable($name);
  if (!$config->isNew()) {
    $config->set('dependencies.module', ['aculta_lms'])->save();
  }
}

/** Adds activity answer configuration used by ACULTA answer plugins. */
function aculta_lms_update_10013(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getFieldStorageDefinition('answer_config', 'aculta_lms_activity')) {
    return;
  }
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_lms_activity');
  $manager->installFieldStorageDefinition('answer_config', 'aculta_lms_activity', 'aculta_lms', $fields['answer_config']);
}

/** Adds the educator feedback projection to ACULTA answer entities. */
function aculta_lms_update_10014(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getFieldStorageDefinition('feedback', 'aculta_lms_answer')) {
    return;
  }
  $fields = \Drupal::service('entity_field.manager')
    ->getBaseFieldDefinitions('aculta_lms_answer');
  $manager->installFieldStorageDefinition('feedback', 'aculta_lms_answer', 'aculta_lms', $fields['feedback']);
}
