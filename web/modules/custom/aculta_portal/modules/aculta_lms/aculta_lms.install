<?php

/**
 * @file
 * Install and update hooks for ACULTA LMS.
 */

declare(strict_types=1);

/** Installs the append-only attempt archive entity definition. */
function aculta_lms_update_10001(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_lms_attempt_archive'));
}

/** Installs the certificate storage definition. */
function aculta_lms_update_10002(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $definition = \Drupal::entityTypeManager()->getDefinition('aculta_lms_certificate');
  if (!$manager->getEntityType('aculta_lms_certificate')) {
    $manager->installEntityType($definition);
  }
}
