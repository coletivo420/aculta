/**
 * Removes config for library update and content type update times.
 * This has been moved to the State API.
 */
function aculta_lms_h5p_update_8001(&$sandbox) {
  $config = \Drupal::service('config.factory')
    ->getEditable('h5p.settings');
  $state = \Drupal::state();
  $state->setMultiple([
    'h5p.content_type_cache_updated_at' => $config->get('h5p_content_type_cache_updated_at', 0),
    'h5p.fetched_library_metadata_on' => $config->get('h5p_fetched_library_metadata_on', 0),
  ]);
  $config->clear('h5p_content_type_cache_updated_at')
    ->clear('h5p_fetched_library_metadata_on')
    ->save();

  \Drupal::messenger()->addStatus('Module h5p removed configuration items successfully.');
}

/**
 * Add fields for metadata and addons.
 */
function aculta_lms_h5p_update_8002() {
  $schema = \Drupal::service('database')->schema();

  if (!$schema->fieldExists('h5p_libraries', 'add_to')) {
    $schema->addField('h5p_libraries', 'add_to', [
      'description' => 'plugin configuration data',
      'type' => 'text'
    ]);
  }
  if (!$schema->fieldExists('h5p_libraries', 'metadata_settings')) {
    $schema->addField('h5p_libraries', 'metadata_settings', [
      'description' => 'Metadata settings',
      'type' => 'text'
    ]);
  }

  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Title'))
    ->setDescription(t('Title of the main content'))
    ->setSetting('max_length', '255')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('title', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Authors'))
    ->setDescription(t('List of authors in json format'))
    ->setSetting('size', 'big')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('authors', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Source'))
    ->setDescription(t('Link to the source, could also be citation'))
    ->setSetting('max_length', '2083')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('source', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('integer')
    ->setLabel(t('Year (from)'))
    ->setDescription(t('Start year for copyright'))
    ->setSetting('unsigned', TRUE)
    ->setSetting('size', 'normal');

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('year_from', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('integer')
  ->setLabel(t('Year (to)'))
  ->setDescription(t('End year for copyright'))
  ->setSetting('unsigned', TRUE)
  ->setSetting('size', 'normal');

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('year_to', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('License'))
    ->setDescription(t('License name of the content'))
    ->setSetting('max_length', '32')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('license', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('License version'))
    ->setDescription(t('Version of license used for the content'))
    ->setSetting('max_length', '10')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('license_version', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Changes'))
    ->setDescription(t('List of changes in json format'))
    ->setSetting('size', 'big')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('changes', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('License extras'))
    ->setDescription(t('Extra licensing terms'))
    ->setSetting('size', 'big')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('license_extras', 'h5p_content', 'h5p_content', $storage_definition);

  $storage_definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Authors comments'))
    ->setDescription(t('Comments for the editor'))
    ->setSetting('size', 'big')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('author_comments', 'h5p_content', 'h5p_content', $storage_definition);
}


/**
 * Retain the historical update ID without touching legacy public files.
 *
 * Migration from public H5P content to private storage requires an explicit
 * inventory and is not safe to perform during a generic database update.
 */
function aculta_lms_h5p_update_8003(&$sandbox): void {
}

/**
 * Add field for default commmon field language
 */
function aculta_lms_h5p_update_8004() {
  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Default Language'))
    ->setDescription(t('Default language for common fields'))
    ->setSetting('max_length', '32')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('default_language', 'h5p_content', 'h5p_content', $storage_definition);
}

/**
 * Update hook to modify the database schema to include 'a11y_title'.
 */
function aculta_lms_h5p_update_8005() {
  $schema = \Drupal::service('database')->schema();

  if (!$schema->fieldExists('h5p_content', 'a11y_title')) {
    $schema->addField('h5p_content', 'a11y_title', [
      'description' => 'Accessibility title for content.',
      'type' => 'varchar',
      'length' => 255,
      'not null' => FALSE,
      'default' => NULL,
    ]);
  }
  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Assistive Technologies label'))
    ->setDescription(t('Accessibility title for content'))
    ->setSetting('max_length', '255')
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('a11y_title', 'h5p_content', 'h5p_content', $storage_definition);

}

/**
 * Historical placeholder. The current entity is installed by update 8007.
 *
 * @deprecated in aculta_lms_h5p: The H5P entity ID changed in update 8007.
 */
function aculta_lms_h5p_update_8006(): void {
}

/**
 * Recreate the H5P content entity under its ACULTA-owned entity type ID.
 *
 * Legacy H5P content, completion data, course assignments, and old entity
 * references are intentionally discarded. H5P library definitions remain.
 */
function aculta_lms_h5p_update_8007(): void {
  $database = \Drupal::database();
  $schema = $database->schema();
  $repository = \Drupal::service('entity.last_installed_schema.repository');
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $legacy_definition = $repository->getLastInstalledDefinition('h5p_content');

  // Remove H5P-managed content media through the aculta_image-aware storage
  // adapter before dropping the old entity table. Files retained because of
  // other references remain protected by that adapter's normal policy.
  if ($schema->tableExists('h5p_content')) {
    $content_ids = $database->select('h5p_content', 'hc')
      ->fields('hc', ['id'])
      ->execute()
      ->fetchCol();
    if ($content_ids !== []) {
      $storage_path = \Drupal::service('aculta_lms_h5p.storage_path')->getPath();
      $file_storage = \Drupal::service('aculta_lms_h5p.file_storage_factory')->create($storage_path);
      foreach ($content_ids as $content_id) {
        $file_storage->deleteContent(['id' => (int) $content_id]);
      }
    }
  }

  // Remove references from courses and forum topics before dropping the old
  // entity storage. The H5P protocol table names remain unchanged.
  foreach ([
    'group__field_h5p_activities' => 'h5p_content_id',
    'group_revision__field_h5p_activities' => 'h5p_content_id',
    'node__field_h5p_content' => 'field_h5p_content_target_id',
    'node_revision__field_h5p_content' => 'field_h5p_content_target_id',
  ] as $table => $column) {
    if ($schema->tableExists($table) && $schema->fieldExists($table, $column)) {
      $database->delete($table)->execute();
    }
  }

  foreach (['h5p_content_libraries', 'h5p_content_user_data', 'h5p_points'] as $table) {
    if ($schema->tableExists($table)) {
      $database->delete($table)->execute();
    }
  }
  if ($schema->tableExists('file_usage')) {
    $database->delete('file_usage')
      ->condition('module', 'aculta_lms_h5p')
      ->condition('type', 'h5p_content')
      ->execute();
  }

  if ($legacy_definition) {
    // Core invokes the old storage schema handler to drop its tables and
    // installed entity definition. This is an intentional destructive reset.
    $update_manager->uninstallEntityType($legacy_definition);
  }

  $entity_type_id = 'aculta_h5p_content';
  if (!$repository->getLastInstalledDefinition($entity_type_id)) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
    $field_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions($entity_type_id);
    $update_manager->installFieldableEntityType($entity_type, $field_definitions);
  }

  // Forum's optional entity reference field follows the new entity type ID.
  $field_storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('node.field_h5p_content');
  if ($field_storage && $field_storage->getSetting('target_type') === 'h5p_content') {
    $field_storage->setSetting('target_type', $entity_type_id)->save();
  }
}
