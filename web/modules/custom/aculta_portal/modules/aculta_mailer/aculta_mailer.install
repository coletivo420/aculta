<?php

/**
 * @file
 * Install and update hooks for ACULTA Mailer.
 */

declare(strict_types=1);

/**
 * Instala a entidade de registro de envios (aculta_mail_log). */
function aculta_mailer_update_10001(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('aculta_mail_log'));
}

/**
 * Installs a field storage definition after checking the field manager contract.
 */
function aculta_mailer_install_field_storage_definition(string $name, \Drupal\Core\Field\FieldDefinitionInterface $field): void {
  if (!$field instanceof \Drupal\Core\Field\FieldStorageDefinitionInterface) {
    throw new \UnexpectedValueException('O campo informado não fornece uma definição de armazenamento.');
  }
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition($name, 'aculta_mail_log', 'aculta_mailer', $field);
}

/**
 * Acrescenta o texto completo da falha ao registro de envios (relatório do admin).
 */
function aculta_mailer_update_10002(): void {
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_mail_log');
  aculta_mailer_install_field_storage_definition('error_message', $fields['error_message']);
}

/**
 * Acrescenta o ID da mensagem no provedor ao registro (eventos de webhook sem correlação).
 */
function aculta_mailer_update_10003(): void {
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_mail_log');
  aculta_mailer_install_field_storage_definition('provider_message_id', $fields['provider_message_id']);
}

/**
 * Campo do conteúdo cifrado para reenvio das mensagens com falha.
 */
function aculta_mailer_update_10004(): void {
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_mail_log');
  aculta_mailer_install_field_storage_definition('payload_cipher', $fields['payload_cipher']);
}

/**
 * Prazo do conteúdo cifrado para reenvio (link de uso único: 24 horas).
 */
function aculta_mailer_update_10005(): void {
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_mail_log');
  aculta_mailer_install_field_storage_definition('payload_expires', $fields['payload_expires']);
}

/**
 * Contadores de rastreamento (aberturas e cliques), só com consentimento.
 */
function aculta_mailer_update_10006(): void {
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('aculta_mail_log');
  foreach (['opens', 'clicks', 'first_opened', 'first_clicked'] as $name) {
    aculta_mailer_install_field_storage_definition($name, $fields[$name]);
  }
}

/**
 * Installs the Mailer transport, template, layout, and brand entity types.
 */
function aculta_mailer_update_10008(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();
  foreach ([
    'aculta_mailer_transport',
    'aculta_mailer_template',
    'aculta_mailer_layout',
    'aculta_mailer_brand',
  ] as $entity_type_id) {
    if ($manager->getEntityType($entity_type_id) === NULL) {
      $manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
    }
  }

  return 'Installed the ACULTA Mailer configuration entity types.';
}
