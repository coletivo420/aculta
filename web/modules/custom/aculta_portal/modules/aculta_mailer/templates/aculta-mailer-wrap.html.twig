{#
/**
 * @file
 * Envelope HTML neutro do ACULTA Mailer. O tema pode sobrepor este template com a apresentação do site.
 *
 * Variables:
 * - body: corpo já escapado, com quebras de linha em <br>.
 * - subject: assunto.
 * - type: tipo do e-mail.
 * - sub_type: subtipo do e-mail.
 */
#}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body>
<div class="email-type-{{ type|clean_class }} email-sub-type-{{ sub_type|clean_class }}">
  <p>{{ body }}</p>
</div>
</body>
</html>
