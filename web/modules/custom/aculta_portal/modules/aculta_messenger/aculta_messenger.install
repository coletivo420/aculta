<?php

/**
 * @file
 * Install and update hooks for ACULTA Messenger.
 */

use Drupal\aculta_messenger\Database\ForumNoticeEventSchema;

/**
 * Implements hook_schema().
 */
function aculta_messenger_schema(): array {
  return [
    ForumNoticeEventSchema::TABLE => ForumNoticeEventSchema::definition(),
  ];
}

/**
 * Adds a terminal cancelled state to the shared Message email delivery field.
 */
function aculta_messenger_update_10001(): void {
  $field_storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('message.field_aculta_msg_delivery');
  if (!$field_storage) {
    return;
  }
  $allowed_values = $field_storage->getSetting('allowed_values') ?? [];
  foreach ($allowed_values as $option) {
    if (($option['value'] ?? NULL) === 'cancelled') {
      return;
    }
  }
  $allowed_values[] = [
    'value' => 'cancelled',
    'label' => 'Cancelado',
  ];
  $field_storage->setSetting('allowed_values', $allowed_values)->save();
}

/**
 * Adds the Forum direct-email outbox columns to the existing idempotency ledger.
 */
function aculta_messenger_update_10002(): void {
  $table = ForumNoticeEventSchema::TABLE;
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists($table)) {
    return;
  }
  $definition = ForumNoticeEventSchema::definition();
  foreach (['email_status', 'email_attempts', 'email_updated'] as $field) {
    if (!$schema->fieldExists($table, $field)) {
      $schema->addField($table, $field, $definition['fields'][$field]);
    }
  }
  if (!$schema->indexExists($table, 'email_status')) {
    $schema->addIndex($table, 'email_status', ['email_status', 'email_updated'], $definition);
  }
}

/**
 * Installs defaults for the centralized LMS, Wiki, and Commerce adapters.
 */
function aculta_messenger_update_10003(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'aculta_messenger');
}

/**
 * Installs defaults for the centralized ACULTA Donation adapter.
 */
function aculta_messenger_update_10004(): void {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'aculta_messenger');
}

/**
 * Adds stable Mailer correlation IDs to the existing Forum event ledger.
 */
function aculta_messenger_update_10005(): void {
  $table = ForumNoticeEventSchema::TABLE;
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists($table) || $schema->fieldExists($table, 'email_correlation')) {
    return;
  }
  $definition = ForumNoticeEventSchema::definition();
  $schema->addField($table, 'email_correlation', $definition['fields']['email_correlation']);
}

/**
 * Adds a terminal permanent-failure value to the shared Mailer status field.
 */
function aculta_messenger_update_10006(): void {
  $field_storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('message.field_aculta_msg_delivery');
  if (!$field_storage) {
    return;
  }
  $allowed_values = $field_storage->getSetting('allowed_values') ?? [];
  foreach ($allowed_values as $option) {
    if (($option['value'] ?? NULL) === 'failed_permanent') {
      return;
    }
  }
  $allowed_values[] = [
    'value' => 'failed_permanent',
    'label' => 'Falha permanente',
  ];
  $field_storage->setSetting('allowed_values', $allowed_values)->save();
}
