/**
 * Installs only missing unread-count fields without replacing active config.
 */
function aculta_messenger_update_10013(): void {
  $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'aculta_messenger');
  $defaults = new FileStorage($module_path . '/config/install');
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage = $entity_type_manager->getStorage('field_storage_config');
  $field_config = $entity_type_manager->getStorage('field_config');

  // The existing friendship event field has a legacy string type on some
  // sites. It is intentionally excluded: these read-state fields are the
  // only missing dependencies used by the count queries.
  $storage_names = [
    'field.storage.message.field_aculta_friendship_read',
    'field.storage.message.field_aculta_game_award_uuid',
    'field.storage.message.field_aculta_game_read',
  ];
  foreach ($storage_names as $name) {
    $config = $defaults->read($name);
    if (!is_array($config) || empty($config['id'])) {
      throw new \UnexpectedValueException(sprintf('Missing Messenger field default: %s.', $name));
    }
    if (!$field_storage->load($config['id'])) {
      $field_storage->create($config)->save();
    }
  }

  $instance_names = [
    'field.field.message.aculta_msg_friendship.field_aculta_friendship_read',
    'field.field.message.aculta_msg_game_award.field_aculta_game_award_uuid',
    'field.field.message.aculta_msg_game_award.field_aculta_game_read',
  ];
  foreach ($instance_names as $name) {
    $config = $defaults->read($name);
    if (!is_array($config) || empty($config['id'])) {
      throw new \UnexpectedValueException(sprintf('Missing Messenger field default: %s.', $name));
    }
    if ($field_config->load($config['id'])) {
      continue;
    }
    $storage_id = $config['entity_type'] . '.' . $config['field_name'];
    $storage = $field_storage->load($storage_id);
    if (!$storage || $storage->getType() !== $config['field_type']) {
      \Drupal::logger('aculta_messenger')->error('Skipped unread-count field @field because its field storage is missing or has a different type.', ['@field' => $config['field_name']]);
      continue;
    }
    $field_config->create($config)->save();
  }
}

/**
 * Moves the Wiki editorial review settings to the central Messenger config.
 *
 * Only copies keys the destination does not already configure. A conflict is
 * logged and left untouched, so an explicit Messenger choice is never
 * overwritten by the legacy Wiki value.
 */
function aculta_messenger_update_10014(): void {
  if (!\Drupal::moduleHandler()->moduleExists('aculta_wiki')) {
    return;
  }
  $source = \Drupal::configFactory()->getEditable('aculta_wiki.settings');
  $destination = \Drupal::configFactory()->getEditable('aculta_messenger.settings');
  $map = [
    'review_notifications' => 'wiki_review_notifications',
    'review_recipients' => 'wiki_review_recipients',
  ];
  $conflicts = [];
  $copied = FALSE;
  foreach ($map as $legacy_key => $central_key) {
    $legacy_value = $source->get($legacy_key);
    if ($legacy_value === NULL) {
      continue;
    }
    if ($destination->get($central_key) !== NULL) {
      $conflicts[] = $central_key;
      continue;
    }
    $destination->set($central_key, $legacy_value);
    $copied = TRUE;
  }
  if ($copied) {
    $destination->save();
  }
  if ($conflicts !== []) {
    \Drupal::logger('aculta_messenger')->notice(
      'Wiki review settings were already configured in Messenger and were not overwritten: @keys.',
      ['@keys' => implode(', ', $conflicts)],
    );
    return;
  }
  // Every legacy key was migrated: remove the source so it is not exported
  // without an owner schema.
  if ($source->get('review_notifications') !== NULL || $source->get('review_recipients') !== NULL) {
    $source->delete();
  }
}

/**
 * Installs the private Message bundle used for Events contribution outcomes.
 */
function aculta_messenger_update_10015(): void {
  $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'aculta_messenger');
  $source = new FileStorage($module_path . '/config/install');
  $names = [
    'message.template.aculta_msg_events_contrib_notice',
    'field.storage.message.field_aculta_events_outcome',
    'field.storage.message.field_aculta_events_notice_read',
    'field.storage.message.field_aculta_events_prop_rev',
    'field.storage.message.field_aculta_events_prop_uuid',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_events_outcome',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_events_notice_read',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_events_prop_rev',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_events_prop_uuid',
  ];
  $config = $source->readMultiple($names);
  $ordered_names = (new ConfigDependencyManager())
    ->setData($config)
    ->sortAll();
  $config_manager = \Drupal::service('config.manager');
  foreach ($ordered_names as $name) {
    if ($config_manager->loadConfigEntityByName($name) !== NULL) {
      continue;
    }
    $entity_type = $config_manager->getEntityTypeIdByName($name);
    if ($entity_type === NULL || !isset($config[$name])) {
      throw new \LogicException(sprintf('Events notice configuration %s is missing or is not an entity.', $name));
    }
    $storage = \Drupal::entityTypeManager()->getStorage($entity_type);
    if (!$storage instanceof ConfigEntityStorageInterface) {
      throw new \LogicException(sprintf('Events notice configuration %s does not use config entity storage.', $name));
    }
    $entity = $storage->createFromStorageRecord($config[$name]);
    if (!$entity->isInstallable()) {
      throw new \LogicException(sprintf('Events notice configuration %s has unmet dependencies.', $name));
    }
    $entity->save();
  }
}

/**
 * Allows the Events inbox bundle to store author submission notices.
 */
function aculta_messenger_update_10016(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $field = $storage->load('message.field_aculta_events_outcome');
  if ($field === NULL) {
    return;
  }
  $allowedValues = $field->getSetting('allowed_values') ?? [];
  $isList = array_is_list($allowedValues);
  foreach ($allowedValues as $definition) {
    if ($isList && ($definition['value'] ?? NULL) === 'submitted') {
      return;
    }
  }
  if (!$isList && array_key_exists('submitted', $allowedValues)) {
    return;
  }
  if ($isList) {
    $allowedValues[] = [
      'value' => 'submitted',
      'label' => 'Enviar para revisão',
    ];
  }
  else {
    $allowedValues['submitted'] = 'Enviar para revisão';
  }
  $field->setSetting('allowed_values', $allowedValues);
  $field->save();
}

/**
 * Adds digest and direct-email delivery fields to Events proposal notices.
 */
function aculta_messenger_update_10017(): void {
  $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'aculta_messenger');
  $source = new FileStorage($module_path . '/config/install');
  $names = [
    'field.storage.message.field_aculta_msg_delivery',
    'field.storage.message.field_aculta_messenger_attempts',
    'field.storage.message.field_aculta_events_digest_sent',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_events_digest_sent',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_msg_delivery',
    'field.field.message.aculta_msg_events_contrib_notice.field_aculta_messenger_attempts',
  ];
  $config = $source->readMultiple($names);
  $config_manager = \Drupal::service('config.manager');
  $ordered_names = (new ConfigDependencyManager())->setData($config)->sortAll();
  foreach ($ordered_names as $name) {
    if ($config_manager->loadConfigEntityByName($name) !== NULL) {
      continue;
    }
    $entity_type = $config_manager->getEntityTypeIdByName($name);
    if ($entity_type === NULL || !isset($config[$name])) {
      throw new \LogicException(sprintf('Events notice delivery configuration %s is missing or is not an entity.', $name));
    }
    $storage = \Drupal::entityTypeManager()->getStorage($entity_type);
    if (!$storage instanceof ConfigEntityStorageInterface) {
      throw new \LogicException(sprintf('Events notice delivery configuration %s does not use config entity storage.', $name));
    }
    $entity = $storage->createFromStorageRecord($config[$name]);
    if (!$entity->isInstallable()) {
      throw new \LogicException(sprintf('Events notice delivery configuration %s has unmet dependencies.', $name));
    }
    $entity->save();
  }
}

/**
 * Reconciles the installed schema metadata for the friendship event field.
 */
function aculta_messenger_update_10018(): string {
  $entity_type_id = 'message';
  $field_name = 'field_aculta_friendship_event';
  $manager = \Drupal::entityDefinitionUpdateManager();
  $installed = $manager->getFieldStorageDefinition($field_name, $entity_type_id);
  $current = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions($entity_type_id)[$field_name] ?? NULL;

  if ($installed !== NULL && $current !== NULL) {
    $manager->updateFieldStorageDefinition($current);
    return 'Reconciled the installed friendship event field schema without rewriting its values.';
  }

  return 'The friendship event field is not installed; no schema or values were changed.';
}
