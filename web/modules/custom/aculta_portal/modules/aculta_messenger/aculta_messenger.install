<?php

/**
 * @file
 * Install and update hooks for ACULTA Messenger.
 */

use Drupal\aculta_messenger\Database\ForumCommentNoticeSchema;

/**
 * Implements hook_schema().
 */
function aculta_messenger_schema(): array {
  return [
    ForumCommentNoticeSchema::TABLE => ForumCommentNoticeSchema::definition(),
  ];
}
