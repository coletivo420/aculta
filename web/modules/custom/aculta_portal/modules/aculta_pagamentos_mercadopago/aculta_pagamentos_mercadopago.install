<?php

declare(strict_types=1);

/**
 * @file
 * Install and update hooks for the ACULTA Mercado Pago integration.
 */

/**
 * Verifies Commerce credit card bundle field definitions.
 */
function aculta_pagamentos_mercadopago_update_10001(): string {
  // Commerce defines card metadata as bundle fields on the credit_card payment
  // method type. They are not base fields and must not be installed through
  // EntityDefinitionUpdateManager::installFieldStorageDefinition().
  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldDefinitions('commerce_payment_method', 'credit_card');
  $required_fields = ['card_type', 'card_number', 'card_exp_month', 'card_exp_year'];
  $missing_fields = array_diff($required_fields, array_keys($definitions));
  if ($missing_fields) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf(
      'Commerce payment method type credit_card is missing expected bundle fields: %s.',
      implode(', ', $missing_fields),
    ));
  }

  return 'Verified Commerce credit_card bundle fields; no redundant base fields were installed.';
}
