{#
  Fallback neutro do card de calendário do Studio (aculta_studio).

  Sem apresentação: o tema ativo sobrescreve este template. O id e os alvos
  data-nav fazem parte do comportamento HTMX e permanecem nos dois.
#}
<div id="aculta-studio-calendar-card" data-portal-ui="studio-calendar">
  <h2>{{ title }}</h2>
  <nav aria-label="{{ 'Navegação do calendário'|t }}">
    {% if previous_url %}<a href="{{ previous_url }}" data-nav="prev" rel="prev">{{ 'Mês anterior'|t }}</a>{% endif %}
    <span>{{ current_month_label }}</span>
    {% if next_url %}<a href="{{ next_url }}" data-nav="next" rel="next">{{ 'Próximo mês'|t }}</a>{% endif %}
  </nav>
  <nav aria-label="{{ 'Filtrar calendário'|t }}">
    <ul>
      {% for filter in filters %}
        <li>
          <a href="{{ filter.url }}"{% if filter.active %} aria-current="true"{% endif %}>{{ filter.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
  <table>
    <thead>
      <tr>
        <th>{{ 'Dom'|t }}</th>
        <th>{{ 'Seg'|t }}</th>
        <th>{{ 'Ter'|t }}</th>
        <th>{{ 'Qua'|t }}</th>
        <th>{{ 'Qui'|t }}</th>
        <th>{{ 'Sex'|t }}</th>
        <th>{{ 'Sáb'|t }}</th>
      </tr>
    </thead>
    <tbody>
      {% for week in weeks %}
        <tr>
          {% for cell in week %}
            <td>
              {% if cell.is_current_month and cell.url %}
                <a href="{{ cell.url }}">{{ cell.day_number }}</a>
              {% else %}
                <span>{{ cell.day_number }}</span>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
  <section>
    <h3>{{ selected_date_label }}</h3>
    {% if selected_day_events is not empty %}
      <ul>
        {% for event in selected_day_events %}
          <li>
            {% if event.url %}
              <a href="{{ event.url }}">{{ event.title }}</a>
            {% else %}
              <span>{{ event.title }}</span>
            {% endif %}
            {% if event.time %}<span>{{ event.time }}</span>{% endif %}
            {% if event.location %}<span>{{ event.location }}</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>{{ 'Nenhum evento neste dia.'|t }}</p>
    {% endif %}
  </section>
  {% if can_add_event and add_event_url %}
    <a href="{{ add_event_url }}">{{ 'Propor novo evento'|t }}</a>
  {% endif %}
</div>
