<?php

/**
 * Instalação e atualização do módulo aculta_ugc.
 *
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Funções de instalação e atualização do ACULTA UGC (ARQ-06).
 */

/**
 * Cria tabelas e definições de entidade para aculta_ugc (ARQ-06).
 */
function aculta_ugc_update_10001(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  $entityTypeManager = \Drupal::entityTypeManager();

  if (!$updateManager->getEntityType('aculta_ugc_report')) {
    $entityType = $entityTypeManager->getDefinition('aculta_ugc_report');
    $updateManager->installEntityType($entityType);
  }

  return (string) t('Installed ACULTA UGC report entity type (ARQ-06).');
}

/**
 * Installs the legacy flagging ID field used to retain report provenance.
 */
function aculta_ugc_update_10003(): string {
  $entity_type_id = 'aculta_ugc_report';
  $field_name = 'legacy_flag_id';
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getFieldStorageDefinition($field_name, $entity_type_id) === NULL) {
    $definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions($entity_type_id);
    $manager->installFieldStorageDefinition($field_name, $entity_type_id, 'aculta_ugc', $definitions[$field_name]);
  }

  return 'Installed the legacy flagging ID field on UGC reports.';
}
