<?php

/**
 * @file
 * Instalação e atualização do aculta_user.
 */

declare(strict_types=1);

use Drupal\aculta_user\Entity\BadgeAward;

/** Implements hook_schema(). */
function aculta_user_schema(): array {
  $schema['aculta_user_consent'] = [
    'description' => 'Append-only consent evidence; retained for the lifetime of the user account.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'agreement' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'action' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'ip_address' => ['type' => 'varchar', 'length' => 45, 'not null' => FALSE],
      'user_agent' => ['type' => 'varchar', 'length' => 2048, 'not null' => FALSE],
      'documents' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'legacy' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'previous_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'record_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => ['consent_lookup' => ['uid', 'agreement', 'id']],
  ];
  return $schema;
}

/** Creates the ledger and preserves each Agreement module's current row as incomplete legacy evidence. */
function aculta_user_update_10006(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aculta_user_consent')) {
    $schema->createTable('aculta_user_consent', aculta_user_schema()['aculta_user_consent']);
  }
  if ($schema->tableExists('agreement')) {
    $rows = \Drupal::database()->select('agreement', 'a')->fields('a', ['uid', 'type', 'agreed', 'agreed_date'])->execute();
    foreach ($rows as $row) {
      \Drupal::service('aculta_user.consent_ledger')->record((int) $row->uid, (string) $row->type, (int) $row->agreed ? 'accepted' : 'revoked', [], TRUE, (int) $row->agreed_date);
    }
  }
  return (string) t('Created the append-only consent ledger and copied current Agreement records as incomplete legacy evidence.');
}

/**
 * Instala o registro das conquistas concedidas (aculta_badge_award).
 */
function aculta_user_update_10001(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $type = \Drupal::entityTypeManager()->getDefinition('aculta_badge_award');
  $manager->installEntityType($type);
}

/** Instala a entidade interna de relacionamentos entre membros. */
function aculta_user_update_10002(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $type = \Drupal::entityTypeManager()->getDefinition('aculta_friendship');
  $manager->installEntityType($type);
}

/** Adiciona motivos administrativos sem alterar IDs, datas ou concessões anteriores. */
function aculta_user_update_10003(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  foreach ([
    'motivo_concessao' => 'Motivo da concessão administrativa',
    'motivo_revogacao' => 'Motivo da revogação administrativa',
  ] as $name => $label) {
    if ($manager->getFieldStorageDefinition($name, 'aculta_badge_award') !== NULL) {
      continue;
    }
    $field = \Drupal\Core\Field\BaseFieldDefinition::create('string_long')->setLabel($label);
    $manager->installFieldStorageDefinition($name, 'aculta_badge_award', 'aculta_user', $field);
  }
}

/**
 * Removes the obsolete moderation toggle for the contributed Forum bundle.
 */
function aculta_user_update_10004(): string {
  \Drupal::configFactory()->getEditable('aculta_user.settings')
    ->clear('primeiro_comentario_moderado')
    ->save();

  return (string) t('Removed the obsolete first-comment setting for Drupal Forum.');
}


/**
 * Associado vira situação: campos de situação, data de adesão, autor e motivo na marca existente.
 *
 * Contas que já tinham a marca (ou o papel) passam a "ativo", com a data de adesão igual à data da marca. Sem essa
 * migração, quem já é associado perderia a situação.
 */
function aculta_user_update_10005(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('aculta_associado');
  $fields = \Drupal\aculta_user\Entity\AssociadoMarcador::baseFieldDefinitions($entity_type);
  foreach (['situacao', 'data_adesao', 'motivo', 'changed'] as $name) {
    if ($manager->getFieldStorageDefinition($name, 'aculta_associado') === NULL) {
      $manager->installFieldStorageDefinition($name, 'aculta_associado', 'aculta_user', $fields[$name]);
    }
  }
  \Drupal::database()->update('aculta_associado')
    ->fields(['situacao' => 'ativo'])
    ->condition('situacao', 'pendente')
    ->execute();
  \Drupal::database()->query("UPDATE {aculta_associado} SET data_adesao = created WHERE data_adesao IS NULL AND situacao = 'ativo'");
}
