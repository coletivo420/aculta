<?php

/**
 * @file
 * Install and update hooks for ACULTA Wiki.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 *
 * Provision Core's queue table before a Wiki entity save can trigger
 * DatabaseQueue's lazy table-creation DDL inside an editorial transaction.
 */
function aculta_wiki_install(): void {
  \Drupal::service('aculta_wiki.editorial_event_queue')->prepareStorage();
}

/**
 * Installs structured field values on existing Wiki proposal entities.
 */
function aculta_wiki_update_10001(): void {
  $entity_type_id = 'aculta_wiki_proposal';
  $entity_type_manager = \Drupal::entityTypeManager();
  $definition_manager = \Drupal::entityDefinitionUpdateManager();

  // The entity type may have been added after aculta_wiki was already enabled.
  // Install its complete SQL schema before installing the field added later.
  if ($definition_manager->getEntityType($entity_type_id) === NULL) {
    $definition_manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
  }

  // Fresh installs already include this base field in the installed definition.
  if ($definition_manager->getFieldStorageDefinition('proposed_fields', $entity_type_id) !== NULL) {
    return;
  }

  $definitions = \Drupal::service('entity_field.manager')
    ->getBaseFieldDefinitions($entity_type_id);
  $definition_manager->installFieldStorageDefinition(
    'proposed_fields',
    $entity_type_id,
    'aculta_wiki',
    $definitions['proposed_fields'],
  );
}

/**
 * Provisions Queue API storage before Wiki editorial transactions use it.
 */
function aculta_wiki_update_10002(): string {
  \Drupal::service('aculta_wiki.editorial_event_queue')->prepareStorage();
  return 'Initialized reliable Queue API storage for ACULTA Wiki editorial events.';
}
