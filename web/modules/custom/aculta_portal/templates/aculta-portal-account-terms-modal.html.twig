{#
/**
 * Popup persistente de aceite dos termos (AccountTermsHooks).
 *
 * Não tem botão de fechar: o JavaScript (aculta_portal/account-terms-modal) abre com showModal(), cancela Esc e
 * prende o foco. O formulário é a mesma tela de aceite usada em /termos/aceitar (retorno sem JavaScript).
 * O <dialog> fica aqui e não no #prefix do formulário, porque o Form API filtra essa tag.
 */
#}
<dialog id="aculta-account-terms" class="portal-terms-modal" role="dialog" aria-modal="true" aria-labelledby="aculta-account-terms-title">
  <h2 id="aculta-account-terms-title" class="h4">{{ title }}</h2>
  {{ form }}
</dialog>
