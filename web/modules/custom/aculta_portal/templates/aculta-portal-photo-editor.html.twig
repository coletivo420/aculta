{#
  Fallback neutro do editor de foto (aculta_portal). Sem apresentação e sem ícone: o tema ativo (ACULTA420) sobrescreve este template.
#}
<div data-aculta-photo-editor>
  <button type="button" data-aculta-photo-open aria-haspopup="dialog" aria-controls="portal-account-photo-dialog" aria-label="{{ 'Alterar foto de perfil de @name'|t({'@name': display_name}) }}">
    {{ photo }}
    <span>
      
    </span>
  </button>

  {# The open attribute provides an inline form fallback when JavaScript is unavailable. #}
  <dialog id="portal-account-photo-dialog" open data-aculta-photo-dialog aria-labelledby="portal-account-photo-title">
    <div>
      <button type="button" data-aculta-photo-close aria-label="{{ 'Fechar'|t }}">&times;</button>
      <h2 id="portal-account-photo-title" tabindex="-1">{{ 'Alterar foto do perfil'|t }}</h2>
      <p>{{ 'Escolha uma imagem e ajuste o enquadramento antes de salvar.'|t }}</p>
      {{ photo_form }}
    </div>
  </dialog>
</div>
