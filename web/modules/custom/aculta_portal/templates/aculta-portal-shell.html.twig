<section class="portal-account" data-portal-account-layout aria-busy="false">
  <header class="portal-account__header">
    <h1>Minha conta</h1>
    <p>Área pessoal</p>
  </header>
  <div class="portal-account__layout">
    <nav class="portal-account__nav" aria-label="Minha conta">
      <h2 class="visually-hidden">Navegação da conta</h2>
      <div class="portal-account__menu-desktop">{{ menu }}</div>
      {{ menu_accordion }}
    </nav>
    <section class="portal-account__content" data-portal-account-content aria-labelledby="portal-account-section-title" aria-busy="false" role="region">
      <h2 id="portal-account-section-title" tabindex="-1">{{ section_title }}</h2>
      <div class="portal-account__body" id="portal-account-body">{{ content }}</div>
    </section>
  </div>
  <p class="portal-account__loading" data-portal-account-loading hidden>Carregando…</p>
  <p class="portal-account__status" data-portal-account-status aria-live="polite" aria-atomic="true"></p>
</section>
