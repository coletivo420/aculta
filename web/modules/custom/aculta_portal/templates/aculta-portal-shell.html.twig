{#
  Fallback neutro do shell da Minha conta (aculta_portal). Sem apresentação: o tema ativo (ACULTA420) sobrescreve este
  template. Os atributos data-portal-account-* são o contrato de comportamento e ficam nos dois.
#}
<section data-portal-account-layout aria-busy="false">
  <header>
    <h1>Minha conta</h1>
    <p>Área pessoal</p>
  </header>
  <div>
    <nav aria-label="Minha conta">
      <h2>Navegação da conta</h2>
      <div>
        <ul data-portal-account-menu>
          {% for item in menu_items %}
            <li><a href="{{ item.href }}" data-aculta-portal-link="true"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
          <li><a href="{{ logout.href }}" data-aculta-portal-link="true">{{ logout.label }}</a></li>
        </ul>
      </div>
      <div data-portal-account-accordion>
        {% for item in accordion_items %}
          <details data-portal-account-item{% if item.open %} open{% endif %}>
            <summary data-portal-account-summary>{{ item.label }}</summary>
            <div data-portal-account-accordion-panel data-src="{{ item.href }}"></div>
          </details>
        {% endfor %}
        <a href="{{ logout.href }}" data-portal-account-summary>{{ logout.label }}</a>
      </div>
    </nav>
    <section data-portal-account-content aria-labelledby="portal-account-section-title" aria-busy="false" role="region">
      <h2 id="portal-account-section-title" tabindex="-1">{{ section_title }}</h2>
      <div id="portal-account-body">{{ content }}</div>
    </section>
  </div>
  <p data-portal-account-status aria-live="polite" aria-atomic="true"></p>
</section>
