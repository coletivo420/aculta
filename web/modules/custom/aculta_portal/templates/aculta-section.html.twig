{#
  Neutral fallback for the aculta_section theme hook. The active theme overrides
  this template with its own section pattern; the Portal keeps no ACULTA classes.
#}
<section>
  {% if section_title %}<h2>{{ section_title }}</h2>{% endif %}
  {% if section_heading %}<h3>{{ section_heading }}</h3>{% endif %}
  {{ section_body }}
</section>
