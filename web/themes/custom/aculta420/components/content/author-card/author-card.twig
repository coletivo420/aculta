{% set layout = variant == 'author_forum_stacked' ? 'stacked' : 'inline' %}
{% set context_labels = {
  author_editorial: 'Revista'|t,
  author_comment: 'Comentário da Revista'|t,
  author_forum: 'Growroom420'|t,
  author_forum_stacked: 'Growroom420'|t,
  author_lms: 'Discussão de cursos'|t,
  author_wiki: 'Wiki420'|t
} %}
<article class="aculta-author-card aculta-author-card--{{ layout }} aculta-author-card--{{ variant }}">
  {% if avatar %}
    <div class="aculta-author-card__avatar">{{ avatar }}</div>
  {% else %}
    <div class="aculta-author-card__avatar aculta-author-card__avatar--initial" aria-hidden="true">{{ display_name|slice(0, 1)|upper }}</div>
  {% endif %}
  <div class="aculta-author-card__identity">
    <div class="aculta-author-card__name">
      {% if profile_url %}<a href="{{ profile_url }}">{{ display_name }}</a>{% else %}{{ display_name }}{% endif %}
    </div>
    {% if context_labels[variant] is defined %}<span class="aculta-author-card__context">{{ context_labels[variant] }}</span>{% endif %}
    {% if member_since and variant in ['author_forum', 'author_forum_stacked'] %}<span class="aculta-author-card__joined">{{ 'Conta ACULTA desde @year'|t({'@year': member_since}) }}</span>{% endif %}
    {% if source_label %}<span class="aculta-author-card__source">{{ source_label }}</span>{% endif %}
    {% if actions %}<div class="aculta-author-card__actions">{{ actions }}</div>{% endif %}
  </div>
</article>
