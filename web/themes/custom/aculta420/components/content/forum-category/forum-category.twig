<article class="aculta-forum-category">
  {% if parent %}<div class="aculta-forum-category__parent">{{ parent }}</div>{% endif %}
  <div class="aculta-forum-category__title">{{ title }}</div>
  {% if description %}<div class="aculta-forum-category__description">{{ description }}</div>{% endif %}
  {% if count %}<div class="aculta-forum-category__count">{{ count }}</div>{% endif %}
</article>
