{% set count = count|default(0) %}
{% set counter_label = count_kind|default('active') == 'attention'
  ? (count == 1 ? 'aviso ativo ou não lido'|t : 'avisos ativos ou não lidos'|t)
  : (count == 1 ? 'aviso ativo'|t : 'avisos ativos'|t) %}
{% set label = count > 0
  ? '@count @kind. Abrir avisos'|t({'@count': count, '@kind': counter_label})
  : 'Abrir avisos'|t %}
{{ attach_library('aculta420/messenger-drawers') }}
<button type="button"
        class="aculta-utility-trigger aculta-alerts-trigger"
        data-toggle="modal"
        data-target="#aculta-alerts-offcanvas"
        aria-controls="aculta-alerts-offcanvas"
        aria-expanded="false"
        aria-label="{{ label }}"
        data-aculta-count-kind="{{ count_kind|default('active') }}">
  <span class="aculta-utility-trigger__icon">
    <i class="bi bi-bell" aria-hidden="true"></i>
    <span class="aculta-unread-count aculta-utility-trigger__count" data-aculta-alerts-count data-count="{{ count }}" aria-hidden="true">{{ count > 99 ? '99+' : count }}</span>
  </span>
</button>

<div class="modal fade aculta-utility-offcanvas aculta-alerts-offcanvas"
     tabindex="-1"
     id="aculta-alerts-offcanvas"
     role="dialog"
     aria-labelledby="aculta-alerts-offcanvas-title"
     data-aculta-utility-drawer
     data-aculta-drawer-count="alerts"
     data-aculta-drawer-url="{{ href }}"
     data-aculta-drawer-label="{{ 'Não foi possível carregar os avisos. Tente novamente.'|t }}">
  <div class="modal-dialog" role="document"><div class="modal-content">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Fechar avisos'|t }}"><span aria-hidden="true">&times;</span></button>
    <h2 class="modal-title h5" id="aculta-alerts-offcanvas-title">{{ 'Avisos'|t }}</h2>
  </div>
  <div class="modal-body aculta-utility-offcanvas__body" data-aculta-drawer-content aria-live="polite" aria-busy="false">
    <p>{{ 'Abra para atualizar os avisos.'|t }}</p>
  </div>
  {# Rodapé fixo da gaveta, abaixo de todos os avisos (persistentes, alertas e do Fórum). Mesmo estilo do botão do carrinho. #}
  {% if all_href %}
    <div class="aculta-alerts-offcanvas__footer">
      <a class="btn btn-primary aculta-alerts-offcanvas__action" href="{{ all_href }}">{{ 'Ver todos os avisos'|t }}</a>
    </div>
  {% endif %}
  </div></div>
</div>
