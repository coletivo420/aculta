{% set count = count|default(0) %}
{% set counter_label = count_kind|default('active') == 'attention'
  ? 'avisos ativos ou não lidos'|t
  : 'avisos ativos'|t %}
{% set label = count > 0
  ? '@count @kind. Abrir avisos'|t({'@count': count, '@kind': counter_label})
  : 'Abrir avisos'|t %}
<a class="aculta-alerts-trigger use-ajax"
   href="{{ href }}"
   data-dialog-type="modal"
   data-dialog-options="{{ {'title': 'Avisos'|t, 'closeText': 'Fechar'|t}|json_encode|e('html_attr') }}"
   aria-haspopup="dialog"
   aria-label="{{ label }}">
  <i class="bi bi-bell" aria-hidden="true"></i>
  {% if count > 0 %}
    {{ include('aculta420:unread-badge', {count: count}, with_context = false) }}
  {% endif %}
</a>
