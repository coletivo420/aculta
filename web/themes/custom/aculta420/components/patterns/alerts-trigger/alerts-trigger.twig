{% set count = count|default(0) %}
{% set counter_label = count_kind|default('active') == 'attention'
  ? 'avisos ativos ou não lidos'|t
  : 'avisos ativos'|t %}
{% set label = count > 0
  ? '@count @kind. Abrir avisos'|t({'@count': count, '@kind': counter_label})
  : 'Abrir avisos'|t %}
{{ attach_library('aculta420/messenger-drawers') }}
<button type="button"
        class="btn btn-link p-0 aculta-utility-trigger aculta-alerts-trigger"
        data-bs-toggle="offcanvas"
        data-bs-target="#aculta-alerts-offcanvas"
        aria-controls="aculta-alerts-offcanvas"
        aria-label="{{ label }}">
  <i class="bi bi-bell" aria-hidden="true"></i>
  <span class="aculta-unread-count" data-aculta-alerts-count data-count="{{ count }}">{{ count > 99 ? '99+' : count }}</span>
</button>

<div class="offcanvas offcanvas-end aculta-utility-offcanvas aculta-alerts-offcanvas"
     tabindex="-1"
     id="aculta-alerts-offcanvas"
     aria-labelledby="aculta-alerts-offcanvas-title"
     data-aculta-drawer-count="alerts"
     data-aculta-drawer-url="{{ href }}"
     data-aculta-drawer-label="{{ 'Não foi possível carregar os avisos. Tente novamente.'|t }}">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h5" id="aculta-alerts-offcanvas-title">{{ 'Avisos'|t }}</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'Fechar avisos'|t }}"></button>
  </div>
  <div class="offcanvas-body aculta-utility-offcanvas__body" data-aculta-drawer-content aria-live="polite" aria-busy="false">
    <p>{{ 'Abra para atualizar os avisos.'|t }}</p>
  </div>
  {# Rodapé fixo da gaveta, abaixo de todos os avisos (persistentes, alertas e do Fórum). Mesmo estilo do botão do carrinho. #}
  {% if all_href %}
    <div class="aculta-alerts-offcanvas__footer">
      <a class="btn btn-primary aculta-alerts-offcanvas__action" href="{{ all_href }}">{{ 'Ver todos os avisos'|t }}</a>
    </div>
  {% endif %}
</div>
