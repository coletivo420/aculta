{% stories card with { title: "Conteúdo/Cartão de conteúdo" } %}

  {% story vertical_com_cabe_alho_e_rodap with { name: "Vertical com cabeçalho e rodapé", args: {
    variant: "default"
  } } %}
    {% set image %}
<img src="/themes/custom/aculta420/assets/branding/podplant420/web/horizontal/podplant420-horizontal-on-light-480w.webp" alt="Marca PodPlant420">
    {% endset %}
    {% set header %}
Destaque cultural
    {% endset %}
    {% set content %}
<h3>Encontro e participação</h3><p>Atividades culturais promovem convivência e debate público.</p>
    {% endset %}
    {% set footer %}
<a href="#">Saiba mais</a>
    {% endset %}
    {{ include('aculta420:card', {
      image: image,
      header: header,
      content: content,
      footer: footer,
      variant: "default"
    }, with_context = false) }}
  {% endstory %}

  {% story horizontal with { name: "Horizontal", args: {
    variant: "horizontal"
  } } %}
    {% set image %}
<img src="/themes/custom/aculta420/assets/branding/podplant420/web/horizontal/podplant420-horizontal-on-light-480w.webp" alt="Marca PodPlant420">
    {% endset %}
    {% set content %}
<h3>Projeto comunitário</h3><p>A apresentação mantém conteúdo e mídia em fluxo responsivo.</p>
    {% endset %}
    {% set footer %}
<a href="#">Conheça o projeto</a>
    {% endset %}
    {{ include('aculta420:card', {
      image: image,
      content: content,
      footer: footer,
      variant: "horizontal"
    }, with_context = false) }}
  {% endstory %}

{% endstories %}
