{# Carrinho: botão com contagem e gaveta lateral (offcanvas do Bootstrap). Um carrinho, com um separador por tipo de pedido
   (loja, cursos, apoio) e um botão de checkout em cada separador. Dados vêm do Portal. #}
{# O badge fica sempre no DOM; com zero itens o CSS o esconde. O módulo atualiza data-aculta-cart-count após "Adicionar ao carrinho". #}
<button type="button" class="btn btn-link p-0 aculta-cart-utility aculta-utility-trigger" data-bs-toggle="offcanvas" data-bs-target="#aculta-cart-offcanvas" aria-controls="aculta-cart-offcanvas" aria-label="Abrir carrinho ({{ count }} itens)" data-aculta-cart-trigger>
  <i class="bi bi-cart3" aria-hidden="true"></i>
  <span class="aculta-unread-count" data-aculta-cart-count data-count="{{ count }}">{{ count > 99 ? '99+' : count }}</span>
</button>

<div class="offcanvas offcanvas-end aculta-cart-offcanvas aculta-utility-offcanvas" tabindex="-1" id="aculta-cart-offcanvas" aria-labelledby="aculta-cart-offcanvas-label">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h5" id="aculta-cart-offcanvas-label">Carrinho</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar carrinho"></button>
  </div>
  <div class="offcanvas-body aculta-cart-offcanvas__body">
    {% if empty %}
      <p class="aculta-cart-offcanvas__empty">Sem produto(s) no carrinho.</p>
    {% else %}
      <div class="aculta-cart-offcanvas__lista" role="list">
        {% for site in sites %}{% if site.key != 'assinatura' %}
          <div class="aculta-cart-offcanvas__separador" role="separator">
            <span class="aculta-cart-offcanvas__separador-nome">{{ site.label }}</span>
            <span class="aculta-cart-offcanvas__separador-total">{{ site.total }}</span>
          </div>
          {% for item in site.items %}
            {# Caixa igual às de aviso e mensagens (alerta do Bootstrap, tokens do tema); o X fecha a caixa. #}
            <div class="aculta-cart-offcanvas__caixa" role="listitem">
              <span class="aculta-cart-offcanvas__title">{{ item.title }}</span>
              <span class="aculta-cart-offcanvas__meta">{{ item.quantity }} × {{ item.total }}</span>
            </div>
          {% endfor %}
        {% endif %}{% endfor %}
      </div>
      {% if checkout_url %}
        <a class="btn btn-primary aculta-cart-offcanvas__action" href="{{ checkout_url }}">Finalizar carrinho</a>
      {% endif %}
      {% for site in sites %}{% if site.key == 'assinatura' %}
        <div class="aculta-cart-offcanvas__assinatura">
          <div class="aculta-cart-offcanvas__separador" role="separator">
            <span class="aculta-cart-offcanvas__separador-nome">{{ site.label }}</span>
            <span class="aculta-cart-offcanvas__separador-total">{{ site.total }}</span>
          </div>
          {% for item in site.items %}
            <div class="aculta-cart-offcanvas__caixa" role="listitem">
              <span class="aculta-cart-offcanvas__title">{{ item.title }}</span>
              <span class="aculta-cart-offcanvas__meta">{{ item.quantity }} × {{ item.total }}</span>
            </div>
          {% endfor %}
          {% if site.checkout_url %}
            <a class="btn btn-outline-primary aculta-cart-offcanvas__action" href="{{ site.checkout_url }}">Finalizar assinatura</a>
          {% endif %}
        </div>
      {% endif %}{% endfor %}
      <p class="aculta-cart-offcanvas__total"><strong>Total geral:</strong> {{ total }}</p>
      {% if url %}
        <a class="btn btn-link p-0 aculta-cart-offcanvas__cart-link" href="{{ url }}">Ver carrinho completo</a>
      {% endif %}
    {% endif %}
  </div>
  <div class="aculta-cart-offcanvas__banner">{{ banner }}</div>
</div>
