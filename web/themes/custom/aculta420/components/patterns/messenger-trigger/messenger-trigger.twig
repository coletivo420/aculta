{% set count = count|default(0) %}
{% set label = count > 0
  ? (count == 1 ? '1 conversa não lida. Abrir mensagens'|t : '@count conversas não lidas. Abrir mensagens'|t({'@count': count}))
  : 'Abrir mensagens'|t %}
{{ attach_library('aculta420/messenger-drawers') }}
<button type="button"
        class="aculta-utility-trigger aculta-messenger-trigger"
        data-toggle="modal"
        data-target="#aculta-messenger-offcanvas"
        aria-controls="aculta-messenger-offcanvas"
        aria-expanded="false"
        aria-label="{{ label }}">
  <span class="aculta-utility-trigger__icon">
    <i class="bi bi-chat-dots" aria-hidden="true"></i>
    <span class="aculta-unread-count aculta-utility-trigger__count" data-aculta-messenger-count data-count="{{ count }}" aria-hidden="true">{{ count > 99 ? '99+' : count }}</span>
  </span>
</button>

<div class="modal fade aculta-utility-offcanvas aculta-messenger-offcanvas"
     tabindex="-1"
     id="aculta-messenger-offcanvas"
     role="dialog"
     aria-labelledby="aculta-messenger-offcanvas-title"
     data-aculta-utility-drawer
     data-aculta-drawer-count="messages"
     data-aculta-drawer-url="{{ href }}"
     data-aculta-drawer-label="{{ 'Não foi possível carregar as mensagens. Tente novamente.'|t }}">
  <div class="modal-dialog" role="document"><div class="modal-content">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Fechar mensagens'|t }}"><span aria-hidden="true">&times;</span></button>
    <h2 class="modal-title h5" id="aculta-messenger-offcanvas-title">{{ 'Mensagens'|t }}</h2>
  </div>
  <div class="modal-body aculta-utility-offcanvas__body" data-aculta-drawer-content aria-live="polite" aria-busy="false">
    <p>{{ 'Abra para atualizar suas conversas.'|t }}</p>
  </div>
  {# Rodapé fixo da gaveta, abaixo de todas as conversas. Mesmo botão e posição do rodapé de avisos. #}
  {% if all_href %}
    <div class="aculta-messenger-offcanvas__footer">
      <a class="btn btn-primary aculta-messenger-offcanvas__action" href="{{ all_href }}">{{ 'Ver todas as mensagens'|t }}</a>
    </div>
  {% endif %}
  </div></div>
</div>
