{# Abas do produto. Bootstrap controla as abas; os ids vêm de `id` para não colidirem. #}
<div class="aculta-product-tabs">
  <ul class="nav nav-tabs aculta-product-tabs__nav" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="{{ id }}-descricao-tab" data-bs-toggle="tab" data-bs-target="#{{ id }}-descricao" type="button" role="tab" aria-controls="{{ id }}-descricao" aria-selected="true">Descrição</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="{{ id }}-info-tab" data-bs-toggle="tab" data-bs-target="#{{ id }}-info" type="button" role="tab" aria-controls="{{ id }}-info" aria-selected="false">Informação adicional</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="{{ id }}-avaliacoes-tab" data-bs-toggle="tab" data-bs-target="#{{ id }}-avaliacoes" type="button" role="tab" aria-controls="{{ id }}-avaliacoes" aria-selected="false">Avaliações ({{ review_count }})</button>
    </li>
  </ul>
  <div class="tab-content aculta-product-tabs__panels">
    <div class="tab-pane fade show active" id="{{ id }}-descricao" role="tabpanel" aria-labelledby="{{ id }}-descricao-tab" tabindex="0">
      {{ description }}
    </div>
    <div class="tab-pane fade" id="{{ id }}-info" role="tabpanel" aria-labelledby="{{ id }}-info-tab" tabindex="0">
      {{ details }}
    </div>
    <div class="tab-pane fade" id="{{ id }}-avaliacoes" role="tabpanel" aria-labelledby="{{ id }}-avaliacoes-tab" tabindex="0">
      {{ reviews }}
    </div>
  </div>
</div>
