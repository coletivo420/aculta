{# Modelo padrão da publicação da Revista. Função: dados e acesso vêm do Drupal; aparência fica aqui. #}
<div class="aculta-revista-publication">
  {% if meta %}<div class="aculta-revista-publication__meta">{{ meta }}</div>{% endif %}
  {% if has_cover %}<figure class="aculta-revista-publication__cover">{{ cover }}</figure>{% endif %}
  {% if has_subtitle %}<div class="aculta-revista-publication__subtitle">{{ subtitle }}</div>{% endif %}
  {% if has_summary %}<div class="aculta-revista-publication__summary">{{ summary }}</div>{% endif %}
  <div class="aculta-revista-publication__body">{{ body }}</div>
  {% if has_footer %}<div class="aculta-revista-publication__footer">{{ footer }}</div>{% endif %}
  {% if authors %}<div class="aculta-revista-publication__authors">{{ authors }}</div>{% endif %}
  {% if discussion %}<div class="aculta-revista-publication__discussion">{{ discussion }}</div>{% endif %}
</div>
