{#
/**
 * @file
 * Envelope HTML dos e-mails do ACULTA (hook aculta_mailer_wrap).
 *
 * O texto de cabeçalho e rodapé vem do layout do aculta_mailer, como conteúdo do corpo. Aqui fica só a apresentação:
 * tabela para compatibilidade com clientes de e-mail e estilos em linha (o e-mail não carrega o CSS do site).
 *
 * Variables:
 * - body: Email body content (HTML, quando is_html).
 * - is_html: True if generating HTML output, false for plain text.
 * - subject: Email subject.
 * - type: Email type.
 * - sub_type: Email sub-type.
 * - attributes: HTML attributes for the top-level email element.
 */
#}
{%
  set classes = [
    'email-type-' ~ type|clean_class,
    'email-sub-type-' ~ sub_type|clean_class,
  ]
%}

{% if is_html %}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#fbf4e8;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;">
<div{{ attributes.addClass(classes) }}>
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#fbf4e8;">
    <tr>
      <td align="center" style="padding:24px 16px;">
        <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;background:#ffffff;border-radius:8px;">
          <tr>
            <td style="background:#3d5c17;padding:16px 24px;border-radius:8px 8px 0 0;">
              <img src="/themes/custom/aculta420/assets/branding/aculta420/web/logo-aculta420-horizontal-branco-900x300.png" width="180" alt="ACULTA" style="display:block;border:0;width:180px;height:auto;">
            </td>
          </tr>
          <tr>
            <td style="padding:24px;font-size:16px;line-height:1.5;color:#1a1a1a;">
              {{ body }}
            </td>
          </tr>
          <tr>
            <td style="padding:16px 24px;background:#fdf8ea;color:#163d2a;font-size:13px;line-height:1.4;border-radius:0 0 8px 8px;">
              Associação Cultural Antiproibicionista
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</div>
</body>
</html>
{% else %}
{{ body }}
{% endif %}
