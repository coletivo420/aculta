{# Drupal renders reusable content through the block theme hook. #}
{% extends "block.html.twig" %}
{% block content %}
<div class="aculta-institution-record">
  {% if view_mode == 'footer' %}
    <div class="aculta-footer-brand">{{ content.field_org_name }}</div>
    {% if not institution_entity.field_cnpj.isEmpty %}<div class="aculta-footer-cnpj">CNPJ {{ content.field_cnpj }}</div>{% endif %}
    {{ content.field_headquarters }}
  {% else %}
  <dl class="aculta-institution-details">
    {% for field_name in ['field_org_name', 'field_nonprofit_description', 'field_trade_name', 'field_legal_nature', 'field_legal_code', 'field_cnpj', 'field_opening_date', 'field_registration_status', 'field_main_activity', 'field_secondary_activity', 'field_headquarters', 'field_address', 'field_site', 'field_email', 'field_phone', 'field_governance'] %}
      {% if content[field_name] is defined and not institution_entity.get(field_name).isEmpty and not (view_mode == 'registration' and field_name == 'field_legal_code') %}
        <div>
          <dt>{{ field_name == 'field_org_name' and view_mode in ['institutional', 'registration'] ? 'Nome empresarial'|t : content[field_name]['#title'] }}</dt>
          <dd>{% if view_mode == 'registration' and field_name == 'field_legal_nature' %}{{ institution_entity.field_legal_code.value }} - {% endif %}{{ content[field_name] }}</dd>
        </div>
      {% endif %}
    {% endfor %}
  </dl>
  {% if view_mode == 'home' and institution_transparency_url %}
    <p>{{ link('TRANSPARÊNCIA'|t, institution_transparency_url, {'class': ['aculta-editorial-link']}) }}</p>
  {% endif %}
  {% endif %}
</div>
{% endblock %}
