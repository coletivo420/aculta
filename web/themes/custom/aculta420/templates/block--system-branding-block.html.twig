{# Branding values come from Drupal theme/site settings; no runtime path logic here. #}
{% extends "block.html.twig" %}
{% block content %}
  <div class="aculta-brand">
    {% if site_logo %}
      <a href="{{ path('<front>') }}" rel="home" class="site-logo">
        <img src="{{ site_logo }}" alt="{{ site_name ?: 'Home'|t }}" width="900" height="300" fetchpriority="high" />
      </a>
    {% elseif site_name %}
      <a href="{{ path('<front>') }}" rel="home" class="site-title">{{ site_name }}</a>
    {% endif %}
    {% if site_slogan %}
      <p class="site-slogan">{{ site_slogan }}</p>
    {% endif %}
  </div>
{% endblock %}
