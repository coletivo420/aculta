{#
/**
 * @file
 * Lista de fóruns do Fórum (ACULTA420, F4). Substitui a tabela do módulo contrib forum (forum-list.html.twig).
 *
 * A informação é a mesma e as variáveis também: forums (label, link, depth, is_container, num_topics, num_posts,
 * last_reply, new_topics, new_url, new_text, description). Contêineres são títulos de seção; fóruns são cartões.
 * Sem JavaScript. A aparência fica em css/components/forum-index.css, por tokens semânticos (claro e escuro).
 *
 * @see forum-list.html.twig do módulo forum (variáveis e contrato)
 */
#}
<div class="aculta-forum-index">
  {% for child_id, forum in forums %}
    {% if forum.is_container %}
      <h2 class="aculta-forum-index__section{% if forum.depth > 0 %} aculta-forum-index__section--nested{% endif %}">
        <a href="{{ forum.link }}">{{ forum.label }}</a>
      </h2>
    {% else %}
      <article class="aculta-forum-index__item{% if forum.depth > 0 %} aculta-forum-index__item--nested{% endif %}">
        <div class="aculta-forum-index__main">
          <h3 class="aculta-forum-index__title">
            <a href="{{ forum.link }}">{{ forum.label }}</a>
          </h3>
          {% if forum.new_topics == true %}
            <a class="aculta-forum-index__new" href="{{ forum.new_url }}">{{ forum.new_text }}</a>
          {% endif %}
          {% if forum.description.value %}
            <p class="aculta-forum-index__description">{{ forum.description.value }}</p>
          {% endif %}
        </div>
        <dl class="aculta-forum-index__stats">
          <div>
            <dt>{{ 'Tópicos'|t }}</dt>
            <dd>{{ forum.num_topics }}</dd>
          </div>
          <div>
            <dt>{{ 'Posts'|t }}</dt>
            <dd>{{ forum.num_posts }}</dd>
          </div>
        </dl>
        <p class="aculta-forum-index__last">
          <span class="aculta-forum-index__label">{{ 'Última postagem'|t }}</span>
          {{ forum.last_reply }}
        </p>
      </article>
    {% endif %}
  {% endfor %}
</div>
