{# Bootstrap grid layout for Display Suite entity displays. #}
<{{ outer_wrapper }}{{ attributes.addClass('row', 'g-4', 'aculta420-ds-layout', 'aculta420-ds-layout--three-column') }}>
  {{ title_suffix.contextual_links }}
  <{{ first_wrapper }}{{ first_attributes.addClass('col-12', 'col-md-6', 'col-xl-4') }}>
    {{ first }}
  </{{ first_wrapper }}>
  <{{ second_wrapper }}{{ second_attributes.addClass('col-12', 'col-md-6', 'col-xl-4') }}>
    {{ second }}
  </{{ second_wrapper }}>
  <{{ third_wrapper }}{{ third_attributes.addClass('col-12', 'col-md-6', 'col-xl-4') }}>
    {{ third }}
  </{{ third_wrapper }}>
</{{ outer_wrapper }}>
