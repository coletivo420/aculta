{# Publicação da Revista (article): usa o modelo padrão aculta420:revista-publication. Conteúdo e acesso vêm do Drupal. #}
<article{{ attributes.addClass('node', 'node--type-article', 'node--view-mode-full', 'aculta-revista-article') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% set footer %}
    {{ content.field_editorial_category }}
    {{ content.field_tags }}
    {{ content.field_references }}
    {{ content.field_credits }}
    {{ content|without('post_meta', 'field_media_image', 'field_subtitle', 'field_summary', 'body', 'field_editorial_category', 'field_tags', 'field_references', 'field_credits', 'article_authors', 'discussao', 'field_discussao', 'field_published_at') }}
  {% endset %}
  {{ include('aculta420:revista-publication', {
    has_subtitle: not node.field_subtitle.isEmpty,
    has_summary: not node.field_summary.isEmpty,
    has_cover: not node.field_media_image.isEmpty,
    has_footer: (footer|trim) is not empty,
    meta: content.post_meta,
    cover: content.field_media_image,
    subtitle: content.field_subtitle,
    summary: content.field_summary,
    body: content.body,
    footer: footer,
    authors: content.article_authors,
    discussion: content.discussao
  }, with_context = false) }}
</article>
