{# Drupal presenter: preserve node attributes here and delegate only inner visual markup to SDC. #}
<article{{ attributes.addClass('aculta-editorial-card') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {{ include('aculta420:editorial-card', {
    category: content.field_category,
    title: label,
    summary: content.field_summary,
    complement: content.field_complement,
    cta: content.field_link
  }, with_context = false) }}
</article>
