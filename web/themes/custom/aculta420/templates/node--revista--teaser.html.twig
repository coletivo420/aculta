{# Cartão da Revista nas listagens (revista_sessoes): reutiliza o SDC card. #}
{{ attach_library('aculta420/revista-listing') }}
{% set title_link %}<a href="{{ url }}" rel="bookmark">{{ label }}</a>{% endset %}
{% set card_content %}
  <h2 class="aculta-revista-teaser__title">{{ title_link }}</h2>
  {% if not node.field_subtitle.isEmpty %}
    <div class="aculta-revista-teaser__subtitle">{{ content.field_subtitle }}</div>
  {% endif %}
  {% if not node.field_summary.isEmpty %}
    <div class="aculta-revista-teaser__summary">{{ content.field_summary }}</div>
  {% endif %}
{% endset %}
{% set card_footer %}
  <a class="aculta-revista-teaser__cta" href="{{ url }}" rel="bookmark">{{ 'Leia a publicação'|t }}<span class="visually-hidden"> {{ label }}</span></a>
{% endset %}
<article{{ attributes.addClass('aculta-revista-teaser') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {{ include('aculta420:card', {
    variant: 'default',
    image: node.field_media_image.isEmpty ? null : content.field_media_image,
    header: node.field_editorial_category.isEmpty ? null : content.field_editorial_category,
    content: card_content,
    footer: card_footer
  }, with_context = false) }}
</article>
