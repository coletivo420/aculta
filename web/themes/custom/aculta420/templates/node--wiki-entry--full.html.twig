{# Drupal owns fields, access, revisions and operation links; the theme owns presentation. #}
<article{{ attributes.addClass('aculta-wiki-entry') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {{ include('aculta420:context-header', { title: label, eyebrow: 'Wiki420 · Enciclopédia livre'|t }, with_context = false) }}
  {{ include('aculta420:wiki-entry', {
    variant: 'article',
    show_heading: false,
    url: url,
    title: label,
    has_summary: not node.field_wiki_summary.isEmpty and content.field_wiki_summary['#access']|default(true),
    has_image: not node.field_wiki_image.isEmpty and content.field_wiki_image['#access']|default(true),
    has_categories: not node.field_wiki_categories.isEmpty and content.field_wiki_categories['#access']|default(true),
    has_related: not node.field_wiki_related.isEmpty and content.field_wiki_related['#access']|default(true),
    has_references: not node.field_wiki_references.isEmpty and content.field_wiki_references['#access']|default(true),
    summary: content.field_wiki_summary,
    image: content.field_wiki_image,
    categories: content.field_wiki_categories,
    body: content.body,
    related: content.field_wiki_related,
    references: content.field_wiki_references,
    discussion: content.field_aculta_discussion,
    actions: content.links
  }, with_context = false) }}
</article>
