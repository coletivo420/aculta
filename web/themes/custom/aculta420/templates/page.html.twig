{# Semantic layout; Bootstrap5 remains the sole provider of Bootstrap assets. #}
{# Institution Bar: global, institutional, no Domain/purpose decisions here. #}
<div class="aculta-page-top">
<div class="aculta-institution-bar">
  <div class="container aculta-container aculta-institution-bar__inner">
    <p class="aculta-institution-bar__brand">
      <a class="aculta-institution-bar__home" href="{{ aculta_brand_home }}">
  <img class="aculta-institution-bar__logo" src="{{ base_path ~ directory }}/assets/branding/aculta420/web/logo-aculta420-horizontal-branco-78x26.webp" srcset="{{ base_path ~ directory }}/assets/branding/aculta420/web/logo-aculta420-horizontal-branco-78x26.webp 1x, {{ base_path ~ directory }}/assets/branding/aculta420/web/logo-aculta420-horizontal-branco-156x52.webp 2x" width="78" height="26" alt="{{ 'ACULTA - Associação Cultural Antiproibicionista'|t }}" decoding="async">
      </a>
    </p>
    {% if domain_presentation.identity.purpose|default('') != 'links' and (aculta_search_utility or aculta_account_menu or aculta_cart) %}
      <div class="aculta-utility">
        {{ aculta_search_utility }}
        {% if aculta_cart %}
          {{ include('aculta420:cart-offcanvas', {
            count: aculta_cart.count,
            empty: aculta_cart.empty,
            url: aculta_cart.url,
            total: aculta_cart.total,
            items: aculta_cart.items,
            banner: 'Compre na loja e apoie a luta antiproibicionista!',
          }, with_context = false) }}
        {% endif %}
        {{ aculta_account_menu }}
      </div>
    {% endif %}
  </div>
</div>

{% if domain_presentation.identity.purpose|default('') == 'links' %}
</div>
<main id="main-content" class="aculta-main aculta-social-links-shell" tabindex="-1">
  <div class="container aculta-container">
    {{ page.content }}
  </div>
</main>
<footer class="aculta-social-links-footer">
  <div class="container aculta-container">
    {{ social_links_page_footer }}
  </div>
</footer>
{% else %}
<header class="aculta-header">
  <div class="navbar aculta-navbar">
    <div class="container aculta-container">
      <div class="aculta-branding">
        {% if aculta_domain_brand_media %}
          <div class="aculta-domain-brand-media">
            <a href="{{ domain_presentation.identity.home_url }}" rel="home" aria-label="{{ domain_presentation.identity.title }}">
              {{ aculta_domain_brand_media }}
            </a>
          </div>
        {% endif %}
        {{ page.header }}
        {% if not aculta_has_system_branding and aculta_domain_brand_fallback %}
          <a href="{{ aculta_domain_brand_fallback.home_url }}"
             rel="home"
             class="site-title">
            {{ aculta_domain_brand_fallback.label }}
          </a>
        {% endif %}
      </div>
      {% if page.primary_menu %}
        <button class="navbar-toggler aculta-menu-toggle" type="button"
                data-bs-toggle="collapse" data-bs-target="#aculta-primary-menu"
                aria-controls="aculta-primary-menu" aria-expanded="false"
                aria-label="{{ 'Menu principal'|t }}">
          <span class="navbar-toggler-icon" aria-hidden="true"></span>
          <span>{{ 'Menu'|t }}</span>
        </button>
        <div class="collapse navbar-collapse" id="aculta-primary-menu">
          {{ page.primary_menu }}
        </div>
      {% endif %}
    </div>
  </div>
</header>
</div>

<main id="main-content" class="aculta-main flex-grow-1" tabindex="-1">
  <div class="container aculta-container">
    {% if aculta_breadcrumb %}
      <div class="aculta-breadcrumb">{{ aculta_breadcrumb }}</div>
    {% endif %}
    {% if page.highlighted or aculta_help %}
      <div class="aculta-highlighted">{{ page.highlighted }}{{ aculta_help }}</div>
    {% endif %}
    {% if aculta_page_title and not institutional_home %}
      <div class="aculta-page-heading">{{ aculta_page_title }}</div>
    {% endif %}
    <div class="row g-4 g-xl-5">
      <div class="{{ page.sidebar ? 'col-12 col-lg-8' : 'col-12' }} aculta-content">
        {% if aculta_account_edit_blocked %}
          <div class="aculta-account-edit-notice" role="status">
            <p>{{ 'O gerenciamento da sua conta é feito em Minha Conta.'|t }}</p>
            <a href="{{ aculta_account_security_url }}">{{ 'Ir para Segurança'|t }}</a>
          </div>
        {% endif %}
        {{ page.content }}
      </div>
      {% if page.sidebar %}
        <aside class="col-12 col-lg-4 aculta-sidebar" aria-label="{{ 'Informações complementares'|t }}">
          {{ page.sidebar }}
        </aside>
      {% endif %}
    </div>
  </div>
</main>

<footer class="aculta-footer mt-auto">
  <div class="container aculta-container">
    <div class="aculta-footer-surface">
      {{ page.footer }}
    </div>
  </div>
</footer>
{% endif %}
