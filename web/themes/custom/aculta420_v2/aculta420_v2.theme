<?php

/**
 * @file
 * Apresentação do tema ACULTA420 V2.
 *
 * O preprocess genérico converte o token neutro data-portal-ui nas classes do
 * tema. Fica aqui, e não em src/Hook, porque o hook genérico `preprocess` não
 * é um `preprocess_*` nomeado por theme hook; o mapa de tokens continua em
 * \Drupal\aculta420_v2\Hook\PortalUiHooks, junto do preprocess_container.
 */

declare(strict_types=1);

use Drupal\aculta420_v2\Hook\PortalUiHooks;

/**
 * Implements hook_preprocess().
 *
 * @phpstan-param array<string, mixed> $variables
 *   Variables supplied by the active theme hook.
 */
function aculta420_v2_preprocess(array &$variables): void {
  PortalUiHooks::preprocessVariables($variables);
}

/**
 * Implements hook_theme_suggestions_input_alter().
 *
 * Botões de moderação com ícone Phosphor usam o componente moderation-submit.
 *
 * @param array<int, string> $suggestions
 *   Theme suggestions.
 * @param array<string, mixed> $variables
 *   Input variables.
 */
function aculta420_v2_theme_suggestions_input_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  if (is_array($element) && isset($element['#moderation_icon'])) {
    $suggestions[] = 'input__submit__moderation';
  }
}
