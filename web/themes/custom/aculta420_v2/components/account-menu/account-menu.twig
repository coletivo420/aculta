{% if authenticated %}
  <nav class="aculta-account-menu aculta-account-menu--signed-in" aria-label="{{ 'Menu da conta'|t }}">
    <details class="aculta-account-menu__details">
      <summary class="aculta-account-menu__summary">
        <span class="aculta-account-menu__avatar">
          {% block avatar %}
            {{ include('aculta420_v2:icon', { name: 'user', variant: 'duotone', size: 'md' }, with_context = false) }}
          {% endblock %}
        </span>
        <span class="visually-hidden">{{ summary_label|default('Minha conta'|t) }}</span>
      </summary>
      <div class="aculta-account-menu__panel">
{% else %}
  <nav class="aculta-account-menu" aria-label="{{ 'Menu da conta'|t }}">
{% endif %}
    {% block menu_items %}{% endblock %}
{% if authenticated %}
      </div>
    </details>
  </nav>
{% else %}
  </nav>
{% endif %}
