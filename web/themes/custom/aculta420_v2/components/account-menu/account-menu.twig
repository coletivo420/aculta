<nav class="aculta-account-menu{{ authenticated ? ' aculta-account-menu--signed-in' }}" aria-label="{{ 'Menu de conta e sites'|t }}">
  <details class="aculta-account-menu__details">
    <summary class="aculta-account-menu__summary">
      {% if avatar is not empty %}
        {{ include('aculta420_v2:avatar', { media: avatar, size: 'sm' }, with_context = false) }}
      {% else %}
        {{ include('aculta420_v2:avatar', { size: 'sm', label: 'Avatar'|t }, with_context = false) }}
      {% endif %}
      <span class="visually-hidden">{% if summary_label is not empty %}{{ summary_label|t }}{% else %}{{ 'Abrir menu de conta'|t }}{% endif %}</span>
    </summary>
    <div class="aculta-account-menu__panel">
      {% if sites is not empty %}
        <section class="aculta-account-menu__sites" aria-label="{{ 'Sites'|t }}">
          <h2>{{ 'Sites'|t }}</h2>
          <ul>
            {% for site in sites %}
              <li><a href="{{ site.url }}"{% if site.current %} aria-current="page"{% endif %}>{{ site.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
      <section class="aculta-account-menu__session" aria-label="{{ 'Sessão'|t }}">
        {% if authenticated %}
          <div class="aculta-account-menu__identity">
            {% if avatar is not empty %}
              {{ include('aculta420_v2:avatar', { media: avatar, size: 'sm' }, with_context = false) }}
            {% else %}
              {{ include('aculta420_v2:avatar', { size: 'sm', label: 'Avatar'|t }, with_context = false) }}
            {% endif %}
            {% if account_name %}<span>{{ account_name }}</span>{% endif %}
          </div>
        {% endif %}
        {{ menu_items }}
      </section>
    </div>
  </details>
</nav>
