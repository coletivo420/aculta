<nav class="aculta-account-menu{{ authenticated ? ' aculta-account-menu--signed-in' }}" aria-label="{{ 'Menu'|t }}">
  <details class="aculta-account-menu__details">
    <summary class="aculta-account-menu__summary">
      <span class="aculta-account-menu__icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">{{ summary_label is not empty ? summary_label : 'Abrir menu'|t }}</span>
    </summary>
    <div class="aculta-account-menu__panel" role="dialog" aria-modal="true" aria-label="{{ 'Menu'|t }}">
      <div class="aculta-account-menu__header">
        <button type="button" class="aculta-account-menu__close" data-aculta-account-menu-close>
          <span aria-hidden="true">&times;</span>
          <span class="visually-hidden">{{ 'Fechar menu'|t }}</span>
        </button>
      </div>
      <div class="aculta-account-menu__columns">
        <section class="aculta-account-menu__col aculta-account-menu__col--primary" aria-label="{{ 'Navegação principal'|t }}">
          {{ primary_menu_items }}
        </section>

        <section class="aculta-account-menu__col aculta-account-menu__col--account" aria-label="{{ 'Conta'|t }}">
          {% if authenticated %}
            <div class="aculta-account-menu__identity">
              {% if avatar is not empty %}
                {{ include('aculta420_v2:avatar', { media: avatar, size: 'sm' }, with_context = false) }}
              {% else %}
                {{ include('aculta420_v2:avatar', { size: 'sm', label: 'Avatar'|t }, with_context = false) }}
              {% endif %}
              {% if account_name %}<span>{{ account_name }}</span>{% endif %}
            </div>
          {% endif %}
          <div class="aculta-account-menu__actions">
            {{ menu_items }}
          </div>
        </section>

        <section class="aculta-account-menu__col aculta-account-menu__col--sites" aria-label="{{ 'Sites e informações legais'|t }}">
          {% if sites is not empty %}
            <div class="aculta-account-menu__group">
              <h2>{{ 'Sites'|t }}</h2>
              <ul>
                {% for site in sites %}
                  <li><a href="{{ site.url }}"{% if site.current %} aria-current="page"{% endif %}>{{ site.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {% if legal_links is not empty %}
            <div class="aculta-account-menu__group">
              <ul>
                {% for link in legal_links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </section>
      </div>
    </div>
  </details>
</nav>
