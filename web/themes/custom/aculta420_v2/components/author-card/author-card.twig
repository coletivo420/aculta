{% set layout = variant == 'author_forum_stacked' ? 'stacked' : 'inline' %}
{% set context_labels = {
  author_editorial: 'Revista'|t,
  author_comment: 'Comentário da Revista'|t,
  author_forum: 'Growroom420'|t,
  author_forum_stacked: 'Growroom420'|t,
  author_lms: 'Discussão de cursos'|t,
  author_wiki: 'Wiki420'|t
} %}
{% set social_icons = { instagram: 'instagram-logo', facebook: 'facebook-logo', reddit: 'reddit-logo' } %}
<article class="author-card author-card--{{ layout }} author-card--{{ variant }} author-card--{{ size|default('md') }}">
  {% if has_avatar %}
    <div class="author-card__avatar">
      {% block avatar %}{% endblock %}
    </div>
  {% endif %}
  <div class="author-card__identity">
    <div class="author-card__name">
      {% if profile_url %}<a href="{{ profile_url }}">{{ display_name }}</a>{% else %}{{ display_name }}{% endif %}
    </div>
    {% if context_labels[variant] is defined %}<span class="author-card__context">{{ context_labels[variant] }}</span>{% endif %}
    {% if member_since and variant in ['author_forum', 'author_forum_stacked'] %}<span class="author-card__joined">{{ 'Conta ACULTA desde @year'|t({'@year': member_since}) }}</span>{% endif %}
    {% if designation %}<span class="author-card__designation">{{ designation }}</span>{% endif %}
    {% if source_label %}<span class="author-card__source">{{ source_label }}</span>{% endif %}
    {% if bio %}<p class="author-card__bio">{{ bio }}</p>{% endif %}
    {% if social_links is not empty %}
      <ul class="author-card__social-links" aria-label="{{ 'Redes sociais públicas'|t }}">
        {% for social in social_links %}
          {% if social_icons[social.network] is defined and social.url %}
            <li>
              <a href="{{ social.url }}" rel="nofollow noopener noreferrer" target="_blank" aria-label="{{ social.label }}" title="{{ social.label }}">
                {{ include('aculta420_v2:icon', { name: social_icons[social.network], variant: 'regular', size: 'md' }, with_context = false) }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
    {% if has_actions %}
      <div class="author-card__actions">{% block actions %}{% endblock %}</div>
    {% endif %}
  </div>
</article>
