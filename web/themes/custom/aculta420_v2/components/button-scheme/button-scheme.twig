{#
  Grade de estados: repouso, desativado e foco, para as cinco variantes.
  Não tem modo próprio: o modo claro/escuro é trocado na página inteira pelo
  seletor da UI Library, e esta grade herda os tokens do contêiner de pré-visualização.
#}
{% set variants = ['primary', 'secondary', 'outline', 'ghost', 'danger'] %}
<div class="aculta-button-scheme">
  <table class="aculta-button-scheme__grid">
    <thead>
      <tr>
        <th scope="col">{{ 'Variante'|t }}</th>
        <th scope="col">{{ 'Repouso'|t }}</th>
        <th scope="col">{{ 'Desativado'|t }}</th>
        <th scope="col">{{ 'Foco'|t }}</th>
      </tr>
    </thead>
    <tbody>
      {% for variant in variants %}
        {% set focus_attributes = create_attribute({ class: ['is-focus'] }) %}
        <tr>
          <th scope="row"><code>{{ variant }}</code></th>
          <td>{{ include('aculta420_v2:button', { text: 'Ação', url: '#', variant: variant }, with_context = false) }}</td>
          <td>{{ include('aculta420_v2:button', { text: 'Ação', url: '#', variant: variant, disabled: true }, with_context = false) }}</td>
          <td>{{ include('aculta420_v2:button', { text: 'Ação', url: '#', variant: variant, attributes: focus_attributes }, with_context = false) }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
