<section{{ attributes.addClass('aculta-consent') }} hidden data-consent-banner role="region" aria-labelledby="aculta-consent-title">
  <div class="aculta-consent__message">
    <h2 id="aculta-consent-title">{{ 'Métricas de uso'|t }}</h2>
    <p>{{ 'Você pode permitir métricas anônimas para ajudar a melhorar os conteúdos. Consulte a'|t }} <a href="{{ privacy_url }}" data-consent-privacy>{{ 'Política de Privacidade'|t }}</a>.</p>
  </div>
  <div class="aculta-consent__actions">
    <button type="button" data-consent-action="accept">{{ 'Permitir métricas'|t }}</button>
    <button type="button" data-consent-action="deny">{{ 'Continuar sem métricas'|t }}</button>
  </div>
</section>
