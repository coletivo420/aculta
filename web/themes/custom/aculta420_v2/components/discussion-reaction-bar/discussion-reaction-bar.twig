{#
/**
 * @file
 * Barra de Reações (interativa): permite reagir e abrir a paleta integrada de opções.
 * Quando o usuário não pode reagir, renderiza a Barra de Reações Recebidas (somente leitura).
 * Popovers nativos (atributo popover): ficam sobre a página e não deslocam as reações.
 */
#}
{% set default_reaction = default_reaction|default('broccoli') %}
{% set user_reaction = user_reaction|default(null) %}
{% set can_react = can_react|default(false) %}
{# Ids dos popovers únicos por instância: a mesma barra pode aparecer várias vezes numa página. #}
{% set uid = random(100000000) %}
{% set more_id = 'reaction-more-' ~ uid %}
{% set palette_id = 'reaction-palette-' ~ uid %}

<div id="{{ target_id }}" class="discussion-reaction-bar" data-discussion-reaction-bar data-entity-type="{{ entity_type }}" data-entity-id="{{ entity_id }}">
{% if can_react %}
  <div class="discussion-reaction-bar__actions">
    {# Reação rápida (padrão) #}
    {% set default_icon = allowed_reactions[default_reaction] is defined ? allowed_reactions[default_reaction].icon : default_reaction %}
    {% set default_label = allowed_reactions[default_reaction] is defined ? allowed_reactions[default_reaction].label : 'Reagir'|t %}
    {% set is_default_active = (user_reaction == default_reaction) %}
    <form method="post" action="{{ react_url }}" data-hx-post="{{ react_url }}" data-hx-target="#{{ target_id }}" data-hx-swap="outerHTML" class="discussion-reaction-bar__quick-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="reaction" value="{{ default_reaction }}">
      <button type="submit" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--quick{% if is_default_active %} is-active{% endif %}" title="{{ default_label }}" aria-label="{{ default_label }}">
        {{ include('aculta420_v2:reaction-emoji', { name: default_icon, variant: is_default_active ? 'color' : 'flat', size: 'sm' }, with_context = false) }}
      </button>
    </form>

    {# Paleta de reações integrada à Barra de Reações. #}
    <div class="discussion-reaction-bar__palette-wrapper">
      <button type="button" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--trigger" popovertarget="{{ palette_id }}" style="anchor-name: --{{ palette_id }}" aria-haspopup="dialog" aria-expanded="false" title="{{ 'Escolher reação'|t }}" aria-label="{{ 'Escolher reação'|t }}">
        {{ include('aculta420_v2:icon', { name: 'smiley', variant: 'regular', size: 'sm' }, with_context = false) }}
      </button>
      <div id="{{ palette_id }}" class="discussion-reaction-bar__popover discussion-reaction-bar__popover--palette" style="position-anchor: --{{ palette_id }}" popover="auto" role="dialog" aria-label="{{ 'Escolher reação'|t }}" data-reaction-popover>
        <div class="discussion-reaction-bar__popover-list">
          {% for key, reaction in allowed_reactions %}
            {% if reaction.enabled|default(true) %}
              <form method="post" action="{{ react_url }}" data-hx-post="{{ react_url }}" data-hx-target="#{{ target_id }}" data-hx-swap="outerHTML" class="discussion-reaction-bar__form">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="reaction" value="{{ key }}">
                <button type="submit" class="discussion-reaction-bar__palette-btn{% if user_reaction == key %} is-selected{% endif %}" title="{{ reaction.label }}" aria-label="{{ reaction.label }}">
                  {{ include('aculta420_v2:reaction-emoji', { name: reaction.icon, variant: 'color', size: 'sm', label: reaction.label }, with_context = false) }}
                </button>
              </form>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% else %}
  {# Sem permissão para reagir: somente as reações recebidas. #}
  {{ include('aculta420_v2:discussion-reactions-received', { target_id: target_id, reactions: reactions, allowed_reactions: allowed_reactions }, with_context = false) }}
{% endif %}
</div>
