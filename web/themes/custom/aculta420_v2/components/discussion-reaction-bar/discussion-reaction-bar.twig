{% set default_reaction = default_reaction|default('heart') %}
{% set user_reaction = user_reaction|default(null) %}
{% set total_count = total_count|default(0) %}
{% set can_react = can_react|default(false) %}
{% set is_own_content = is_own_content|default(false) %}

<div id="{{ target_id }}" class="discussion-reaction-bar" data-discussion-reaction-bar data-entity-type="{{ entity_type }}" data-entity-id="{{ entity_id }}">
  <div class="discussion-reaction-bar__list">
    {% for key, item in reactions %}
      {% set emoji_icon = allowed_reactions[key] is defined ? allowed_reactions[key].icon : key %}
      {% set emoji_label = allowed_reactions[key] is defined ? allowed_reactions[key].label : key %}
      {% if can_react %}
        <form method="post" action="{{ react_url }}" data-hx-post="{{ react_url }}" data-hx-target="#{{ target_id }}" data-hx-swap="outerHTML" class="discussion-reaction-bar__form">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="reaction" value="{{ key }}">
          <button type="submit" class="discussion-reaction-bar__badge{% if item.user_reacted %} is-active{% endif %}" aria-pressed="{{ item.user_reacted ? 'true' : 'false' }}" title="{{ emoji_label }}">
            {{ include('aculta420_v2:reaction-emoji', { name: emoji_icon, variant: 'color', size: 'sm', label: emoji_label }, with_context = false) }}
            <span class="discussion-reaction-bar__count">{{ item.count }}</span>
          </button>
        </form>
      {% else %}
        <span class="discussion-reaction-bar__badge" title="{{ emoji_label }}">
          {{ include('aculta420_v2:reaction-emoji', { name: emoji_icon, variant: 'color', size: 'sm', label: emoji_label }, with_context = false) }}
          <span class="discussion-reaction-bar__count">{{ item.count }}</span>
        </span>
      {% endif %}
    {% endfor %}
  </div>

  {% if can_react %}
    <div class="discussion-reaction-bar__actions">
      {# Quick reaction button (Default reaction toggle) #}
      {% set default_icon = allowed_reactions[default_reaction] is defined ? allowed_reactions[default_reaction].icon : default_reaction %}
      {% set default_label = allowed_reactions[default_reaction] is defined ? allowed_reactions[default_reaction].label : 'Reagir'|t %}
      {% set is_default_active = (user_reaction == default_reaction) %}
      <form method="post" action="{{ react_url }}" data-hx-post="{{ react_url }}" data-hx-target="#{{ target_id }}" data-hx-swap="outerHTML" class="discussion-reaction-bar__quick-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="reaction" value="{{ default_reaction }}">
        <button type="submit" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--quick{% if is_default_active %} is-active{% endif %}" title="{{ default_label }}" aria-label="{{ default_label }}">
          {{ include('aculta420_v2:reaction-emoji', { name: default_icon, variant: is_default_active ? 'color' : 'flat', size: 'sm' }, with_context = false) }}
        </button>
      </form>

      {# Emoji picker popover trigger via HTMX #}
      <div class="discussion-reaction-bar__picker-wrapper">
        {% set picker_target_id = 'discussion-reaction-picker-' ~ target_id %}
        {% if picker_url %}
          <button type="button" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--trigger" aria-haspopup="dialog" aria-expanded="false" title="{{ 'Mais reações'|t }}" aria-label="{{ 'Mais reações'|t }}" data-hx-get="{{ picker_url }}" data-hx-target="#{{ picker_target_id }}" data-hx-swap="innerHTML" data-reaction-picker-trigger>
            {{ include('aculta420_v2:icon', { name: 'smiley', variant: 'regular', size: 'sm' }, with_context = false) }}
          </button>
        {% else %}
          <button type="button" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--trigger" aria-haspopup="dialog" aria-expanded="false" title="{{ 'Mais reações'|t }}" aria-label="{{ 'Mais reações'|t }}" data-reaction-picker-trigger>
            {{ include('aculta420_v2:icon', { name: 'smiley', variant: 'regular', size: 'sm' }, with_context = false) }}
          </button>
        {% endif %}

        <div id="{{ picker_target_id }}" class="discussion-reaction-bar__picker-container"></div>
      </div>
    </div>
  {% elseif allowed_reactions is not empty %}
    {% set default_icon = allowed_reactions[default_reaction] is defined ? allowed_reactions[default_reaction].icon : default_reaction %}
    {% set readonly_label = is_own_content ? 'Suas reações recebidas'|t : 'Reações da publicação'|t %}
    <div class="discussion-reaction-bar__actions discussion-reaction-bar__actions--readonly" title="{{ readonly_label }}">
      <span class="discussion-reaction-bar__summary" aria-label="{{ readonly_label }}: {{ total_count }}">
        {{ include('aculta420_v2:reaction-emoji', { name: default_icon, variant: total_count > 0 ? 'color' : 'flat', size: 'sm', label: readonly_label }, with_context = false) }}
        <span class="discussion-reaction-bar__count">{{ total_count }}</span>
      </span>
      <div class="discussion-reaction-bar__picker-wrapper">
        {% set picker_target_id = 'discussion-reaction-picker-' ~ target_id %}
        {% if picker_url %}
          <button type="button" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--trigger" aria-haspopup="dialog" aria-expanded="false" title="{{ 'Ver opções de reação'|t }}" aria-label="{{ 'Ver opções de reação'|t }}" data-hx-get="{{ picker_url }}" data-hx-target="#{{ picker_target_id }}" data-hx-swap="innerHTML" data-reaction-picker-trigger>
            {{ include('aculta420_v2:icon', { name: 'smiley', variant: 'regular', size: 'sm' }, with_context = false) }}
          </button>
        {% else %}
          <button type="button" class="discussion-reaction-bar__btn discussion-reaction-bar__btn--trigger" aria-haspopup="dialog" aria-expanded="false" title="{{ 'Ver opções de reação'|t }}" aria-label="{{ 'Ver opções de reação'|t }}" data-reaction-picker-trigger>
            {{ include('aculta420_v2:icon', { name: 'smiley', variant: 'regular', size: 'sm' }, with_context = false) }}
          </button>
        {% endif %}

        <div id="{{ picker_target_id }}" class="discussion-reaction-bar__picker-container"></div>
      </div>
    </div>
  {% endif %}
</div>
