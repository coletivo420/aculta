{#
 * @file
 * Compositor de resposta; a Library o mostra no popup e a página pode fornecer um popup compartilhado.
#}
{% set body %}
<div id="{{ target_id }}" class="discussion-reply-composer discussion-reply-composer--{{ status }} discussion-reply-composer--{{ mode|default('responder') }} forum-post-card forum-post-card--stripe-brand" data-discussion-reply-composer data-status="{{ status }}" data-mode="{{ mode|default('responder') }}" data-parent-id="{{ parent_id|default('') }}">
  <div class="forum-post-card__stripe"></div>
  <div class="forum-post-card__inner">
    <header class="forum-post-card__header discussion-reply-composer__header">
      <div class="forum-post-card__author">
        {{ include('aculta420_v2:avatar', {size: 'md', media: avatar}, with_context: false) }}
        <div class="forum-post-card__author-info">
          <div class="forum-post-card__author-name-row">
            <span class="forum-post-card__author-name">{{ mode == 'editar' ? 'Editar'|t : (mode == 'excluir' ? 'Excluir'|t : 'Sua Resposta'|t) }}</span>
            <span class="forum-post-card__author-role">{{ mode == 'excluir' ? 'Confirmação'|t : 'Compositor'|t }}</span>
          </div>
          {% if host_title %}
            <div class="forum-post-card__author-meta">
              <span class="discussion-reply-composer__host-title">{{ host_title }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </header>

    <div class="forum-post-card__body discussion-reply-composer__body">
      {% if parent_id and parent_author %}
        <div class="discussion-reply-composer__parent-banner">
          <span class="discussion-reply-composer__parent-label">{{ 'Respondendo a:'|t }}</span>
          <strong class="discussion-reply-composer__parent-author">{{ parent_author }}</strong>
          {% if parent_subject %}
            <span class="discussion-reply-composer__parent-subject">({{ parent_subject }})</span>
          {% endif %}
        </div>
      {% endif %}

      {% if messages %}
        <div class="discussion-reply-composer__messages" role="status" aria-live="polite">
          {{ messages }}
        </div>
      {% endif %}

      {% if context %}
        <div class="discussion-reply-composer__context">
          {{ context }}
        </div>
      {% endif %}

      {% if form %}
        <div class="discussion-reply-composer__form">
          {{ form }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endset %}
{% if standalone_popup is not defined or standalone_popup %}
  {{ include('aculta420_v2:popup', {
    id: target_id ~ '-popup',
    title: dialog_title|default(trigger_label|default('Responder'|t)),
    trigger_label: trigger_label|default('Responder'|t),
    content: body,
  }, with_context: false) }}
{% else %}
  {{ body }}
{% endif %}
