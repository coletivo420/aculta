{# Popup "Criar tópico": mesmo padrão do popup "Responder à discussão" (SDC dialog). #}
{% embed 'aculta420_v2:dialog' with {
  id: id,
  title: title|default('Criar tópico'),
  trigger_label: trigger_label|default('Criar tópico'),
  trigger_url: '#' ~ id,
  close_label: 'Fechar',
} only %}
  {% block content %}
    <div class="aculta-topic-create-dialog__body">
      {{ form }}
    </div>
  {% endblock %}
{% endembed %}
