{#
/**
 * @file
 * Linha de autor do fórum: avatar, nome e horário.
 * Compõe aculta420_v2:avatar; não monta avatar próprio.
 */
#}
{% set tag = profile_url ? 'a' : 'span' %}
<div class="forum-author-line">
  <{{ tag }} class="forum-author-line__identity{% if profile_url %} forum-author-line__link{% endif %}"{% if profile_url %} href="{{ profile_url }}" aria-label="{{ 'Ver perfil de @name'|t|replace({'@name': author_name}) }}"{% endif %}>
  <span class="forum-author-line__avatar">
    {% set avatar_markup = avatar is iterable ? render_var(avatar) : avatar %}
    {{ include('aculta420_v2:avatar', { size: 'md', label: author_name, media: avatar_markup and avatar_markup|trim != '' ? avatar_markup|raw : null }, with_context = false) }}
  </span>
  <span class="forum-author-line__name">{{ author_name }}</span>
  </{{ tag }}>
  {% if timestamp %}<span class="forum-author-line__time">· {{ timestamp }}</span>{% endif %}
</div>
