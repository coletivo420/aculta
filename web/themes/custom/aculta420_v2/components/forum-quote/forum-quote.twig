{#
/**
 * @file
 * Citação / quote do fórum: aspas em destaque, faixa verde à esquerda, vermelha à direita, e ações.
 */
#}
<blockquote{% if theme == 'dark' %} data-theme="dark"{% endif %} class="forum-quote forum-quote--density-{{ density|default('default') }}{% if density == 'compact' %} aculta-mobile-frame{% endif %}{% if accent_side == 'end' %} forum-quote--side-end{% endif %}">
  <div class="forum-quote__body">
    <span class="forum-quote__mark" aria-hidden="true">
      {{ include('aculta420_v2:icon', { name: 'quotes', variant: 'regular', size: 'lg' }, with_context = false) }}
    </span>
    <div class="forum-quote__text">
      {% if author_name %}
        <div class="forum-quote__author-row">
                    {% if avatar %}
            <span class="aculta-avatar aculta-avatar--sm"><span class="aculta-avatar__media">{{ avatar|raw }}</span></span>
          {% else %}
            {{ include('aculta420_v2:avatar', { size: 'sm', label: author_name }, with_context = false) }}
          {% endif %}
          <cite class="forum-quote__author">{{ author_name }}</cite>
        </div>
      {% endif %}
      {{ content }}
    </div>
  </div>
  <footer class="forum-quote__actions">
    {% if reactions_slot %}
      {{ reactions_slot }}
    {% endif %}
    {{ include('aculta420_v2:content-reply-bar', {
      permalink_url: permalink_url|default(null),
      edit_url: edit_url|default(null),
      delete_url: delete_url|default(null),
      quote_url: quote_url|default(null),
      reply_url: reply_url|default(null),
      target_id: 'aculta-reply-dialog-body',
    }, with_context = false) }}
  </footer>
</blockquote>
