{#
/**
 * @file
 * Reply compacto: resposta do fórum com autor, horário, texto e ações.
 * Faixa tricolor no topo (cores do tema) e faixa verde à esquerda.
 */
#}
<article class="forum-reply-compact{% if reacted %} is-reacted{% endif %}">
  <div class="forum-reply-compact__tricolor" aria-hidden="true">
    <span class="forum-reply-compact__tricolor-segment forum-reply-compact__tricolor-segment--green"></span>
    <span class="forum-reply-compact__tricolor-segment forum-reply-compact__tricolor-segment--yellow"></span>
    <span class="forum-reply-compact__tricolor-segment forum-reply-compact__tricolor-segment--red"></span>
  </div>
  <div class="forum-reply-compact__body">
    <div class="forum-reply-compact__avatar">
            {% if avatar %}
        <span class="aculta-avatar aculta-avatar--md"><span class="aculta-avatar__media">{{ avatar|raw }}</span></span>
      {% else %}
        {{ include('aculta420_v2:avatar', { size: 'md', label: author_name }, with_context = false) }}
      {% endif %}
    </div>
    <div class="forum-reply-compact__main">
      <header class="forum-reply-compact__header">
        <span class="forum-reply-compact__author">{{ author_name }}</span>
        {% if timestamp %}<span class="forum-reply-compact__time">· {{ timestamp }}</span>{% endif %}
        <div class="forum-reply-compact__tools">
          <span class="forum-reply-compact__heart{% if reacted %} is-active{% endif %}" title="{{ 'Reagir'|t }}">
            {{ include('aculta420_v2:icon', { name: 'heart', variant: 'regular', size: 'sm' }, with_context = false) }}
          </span>
          <span class="forum-reply-compact__more" aria-hidden="true">
            {{ include('aculta420_v2:icon', { name: 'dots-three', variant: 'regular', size: 'sm' }, with_context = false) }}
          </span>
        </div>
      </header>
      <div class="forum-reply-compact__text">
        {{ content }}
      </div>
    </div>
  </div>
</article>
