<div class="aculta-forum-topic__presentation aculta-forum-topic__presentation--{{ variant }}">
  {% if has_title %}<div class="aculta-forum-topic__title">{{ title }}</div>{% endif %}
  {% if has_meta %}<footer class="aculta-forum-topic__meta">{{ meta }}</footer>{% endif %}
  {% if has_bookmark %}<div class="aculta-forum-topic__bookmark">{{ bookmark }}</div>{% endif %}
  <div class="aculta-forum-topic__content">{{ content }}</div>
</div>
