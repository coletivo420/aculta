{% set variant = variant|default('stack') %}
{% if variant not in ['stack', 'aside', 'full'] %}
  {% set variant = 'stack' %}
{% endif %}
<main{{ attributes.addClass('layout-page', 'layout-page--' ~ variant) }} id="main-content" tabindex="-1">
  {% if title %}
    <div class="layout-page__title">{{ title }}</div>
  {% endif %}
  <div class="layout-page__content">{{ content }}</div>
  {% if aside %}
    {% set aside_rendered = aside|render %}
    {% if aside_rendered|trim is not empty %}
      <aside class="layout-page__aside" aria-label="{{ 'Related content'|t }}">{{ aside_rendered }}</aside>
    {% endif %}
  {% endif %}
</main>
