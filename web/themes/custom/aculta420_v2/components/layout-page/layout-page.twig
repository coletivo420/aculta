{% set variant = variant|default('stack') %}
{% if variant not in ['stack', 'aside', 'full'] %}
  {% set variant = 'stack' %}
{% endif %}
<main class="layout-page layout-page--{{ variant }}{% if studio_dashboard|default(false) %} layout-page--studio-dashboard{% endif %}" id="main-content" tabindex="-1">
  {% if title %}
    <div class="layout-page__title">{{ title }}</div>
  {% endif %}
  <div class="layout-page__content">{{ content }}</div>
  {% if has_aside %}
    <aside class="layout-page__aside" aria-label="{{ 'Related content'|t }}">{{ aside }}</aside>
  {% endif %}
</main>
