<article{{ attributes.addClass('lms-certificate-card') }} data-status="{{ status }}">
  <h3 class="lms-certificate-card__title">{{ title }}</h3>
  <p class="lms-certificate-card__status">{{ status_text }}</p>
  <p class="lms-certificate-card__issued">{{ issued_text }}</p>
  <div class="lms-certificate-card__action">{{ verification_action }}</div>
</article>
