{% set title_level = title_level|default('h2') %}
{% if title_level not in ['h1', 'h2'] %}
  {% set title_level = 'h2' %}
{% endif %}
<section class="revista-listing">
  <header class="revista-listing__header">
    {% if eyebrow %}<p class="revista-listing__eyebrow">{{ eyebrow }}</p>{% endif %}
    <{{ title_level }} class="revista-listing__title">{{ title }}</{{ title_level }}>
  </header>
  {% if has_items %}
    <div class="revista-listing__items">
      {% block items %}{% endblock %}
    </div>
  {% endif %}
</section>
