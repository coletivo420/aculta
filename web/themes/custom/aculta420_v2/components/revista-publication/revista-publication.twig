<div class="revista-publication">
  {% if has_meta %}<div class="revista-publication__meta">{{ meta }}</div>{% endif %}
  {% if has_cover %}
    <figure class="revista-publication__cover">{{ cover }}</figure>
  {% endif %}
  {% if has_subtitle %}<div class="revista-publication__subtitle">{{ subtitle }}</div>{% endif %}
  {% if has_summary %}<div class="revista-publication__summary">{{ summary }}</div>{% endif %}
  <div class="revista-publication__body">{{ body }}</div>
  {% if has_footer %}<footer class="revista-publication__footer">{{ footer }}</footer>{% endif %}
  {% if has_authors %}<section class="revista-publication__authors">{{ authors }}</section>{% endif %}
  {% if has_discussion %}<section class="revista-publication__discussion">{{ discussion }}</section>{% endif %}
</div>
