<section{{ attributes.addClass('wiki-moderation-decision') }} aria-label="{{ title }}">
  <header class="wiki-moderation-decision__header">
    <h2>{{ title }}</h2>
    {% if note %}<p>{{ note }}</p>{% endif %}
  </header>
  {% if context %}<div class="wiki-moderation-decision__context">{{ context }}</div>{% endif %}
  <div class="wiki-moderation-decision__form">{{ form }}</div>
</section>
