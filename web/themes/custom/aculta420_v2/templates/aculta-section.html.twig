{# The Portal owns editorial values; the shared SDC owns the visual section. #}
{% set section_header %}
  {% if section_title %}<h2 class="aculta-section-title">{{ section_title }}</h2>{% endif %}
  {% if section_heading %}<h3 class="aculta-section-heading">{{ section_heading }}</h3>{% endif %}
{% endset %}
{{ include('aculta420_v2:layout-section', {
  tone: 'default',
  section_variant: section_variant|default('default'),
  section_color: section_color|default('default'),
  header: section_header,
  content: section_body,
}, with_context = false) }}
