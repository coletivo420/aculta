{#
  Studio Dashboard (aculta_studio), apresentação ACULTA420.

  Sobrescreve o fallback neutro do módulo. Os dados vêm do hook
  aculta_studio_account; o markup, as classes e os ícones são do tema.
#}
{{ attach_library('aculta420_v2/account-carousel') }}
<div class="studio aculta-account-entry" data-portal-ui="account-entry">
  {{ include('aculta420_v2:studio-menu', { title: menu_title, items: menu_items }, with_context = false) }}
  <div class="aculta-xp-hero">
    {% if identity is not empty %}
      <div class="studio__panel aculta-panel aculta-panel--default aculta-panel__body studio-account-identity"
        data-portal-ui="studio-account-home studio-account-identity">
        <p>{{ identity.name }}</p>
        {% if identity.email %}
          <p class="aculta-xp-hero__mail">{{ identity.email }}</p>
        {% endif %}
        {% if identity.avatar %}
          <div class="studio-account-identity__avatar" data-portal-ui="studio-account-avatar">{{ identity.avatar }}</div>
        {% endif %}
        {% if identity.profile_url %}
          <a class="studio__action" data-portal-ui="studio-profile-public-link" href="{{ identity.profile_url }}">{{ 'Ver perfil público'|t }}</a>
        {% endif %}
      </div>
    {% endif %}
    {% if profile_link is not empty %}
      <div class="aculta-xp-hero__profile">
        <span aria-hidden="true">{{ include('aculta420_v2:icon', { name: 'user', variant: 'duotone', size: 'xl' }, with_context = false) }}</span>
        <p class="aculta-xp-hero__text">{{ 'Seu perfil público na ACULTA'|t }}</p>
        {{ profile_link }}
      </div>
    {% endif %}
  </div>
  {{ calendar }}
  {{ connections }}
  <h2 id="suas-experiencias">{{ experiences_title }}</h2>
  <p class="aculta-xp-section__text">{{ experiences_description }}</p>
  <ul class="aculta-xp-grid studio__actions list-unstyled aculta-u-grid aculta-u-gap-2" data-portal-ui="account-experiences">
    {% for experience in experiences %}
      {{ experience }}
    {% endfor %}
  </ul>
  {% if account_url %}
    <a class="aculta-xp-row studio__actions list-unstyled aculta-u-grid aculta-u-gap-2" data-portal-ui="account-entry-links" href="{{ account_url }}" aria-label="{{ account_link_label }}">
      <span class="aculta-xp-row__body">
        {{ include('aculta420_v2:icon', { name: 'gear-six', variant: 'duotone', size: 'xl' }, with_context = false) }}
        <span class="aculta-xp-row__text">
          <span class="aculta-xp-row__title">{{ account_link_title }}</span>
          <span class="aculta-xp-row__desc">{{ account_link_description }}</span>
        </span>
      </span>
    </a>
  {% endif %}
</div>
