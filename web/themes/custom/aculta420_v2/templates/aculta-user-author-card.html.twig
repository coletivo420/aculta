{% embed 'aculta420_v2:author-card' with {
  variant: variant|default('author_minimal'),
  size: size|default('md'),
  display_name: display_name|default(''),
  profile_url: profile_url|default(null),
  has_avatar: has_avatar|default(false),
  member_since: member_since|default(null),
  designation: designation|default(null),
  source_label: source_label|default(null),
  bio: bio|default(null),
  social_links: social_links|default([]),
  has_actions: actions is not empty
} only %}
  {% block avatar %}{{ avatar }}{% endblock %}
  {% block actions %}{{ actions }}{% endblock %}
{% endembed %}
