{# Preserve the Drupal comment render array, presenting it via forum-post-card. #}
{% set author_card = content.author_card|default(null) %}
{% set comment_body = content|without('author_card', 'links') %}
{% set actions_markup %}
  {{ permalink }}
  {{ content.links }}
{% endset %}
{% set author_name_val = author_card ? comment.getOwner().getDisplayName() : comment.getAuthorName() %}
{{ title_prefix }}
{{ include('aculta420_v2:forum-post-card', {
  stripe: 'brand',
  author_name: author_name_val|default('Participante'|t),
  author_role: null,
  author_posts: null,
  timestamp: created|default(null),
  reactions: null,
  reply_url: null,
  avatar: author_card,
  body: comment_body,
  actions: actions_markup,
  reply: null,
}, with_context = false) }}
{{ title_suffix }}
