{# Preserve the Drupal comment render array, presenting it via forum-post-card with Core attributes and accessibility metadata. #}
{% set author_card = content.author_card|default(null) %}
{% set comment_body = content|without('author_card', 'links') %}
{% set actions_markup %}
  {{ permalink }}
  {{ content.links }}
{% endset %}
{% set author_name_val = author_card ? (author_card['#display_name']|default(author)) : author %}
{% set composer_target_id = 'discussion-composer-' ~ commented_entity_type ~ '-' ~ commented_entity_id ~ '-' ~ comment.id %}
{{ title_prefix }}
<article{{ attributes.addClass('comment', 'comment--discussion', 'js-comment', status ? 'comment--' ~ status) }}>
  {% if parent_comment %}
    <p class="comment__in-reply-to">
      {{ 'Em resposta a'|t }}
      <strong class="comment__in-reply-to-author">{{ parent_comment.getAuthorName() }}</strong>
    </p>
  {% endif %}
  {{ include('aculta420_v2:forum-post-card', {
    stripe: 'brand',
    author_name: author_name_val|default('Participante'|t),
    author_role: null,
    author_posts: null,
    timestamp: created|default(null),
    reactions: null,
    reply_url: null,
    avatar: author_card,
    body: comment_body,
    actions: actions_markup,
    reply: null,
  }, with_context = false) }}
  <div id="{{ composer_target_id }}" class="discussion-reply-target"></div>
</article>
{{ title_suffix }}
