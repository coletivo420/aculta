{% if aculta_accordion_sdc_available|default(false) %}
  {{ include('aculta420_v2:accordion', {
    title: label,
    content: content.body
  }, with_context = false) }}
{% else %}
  <details class="faq-answer">
    <summary>{{ label }}</summary>
    <div class="faq-answer__content">{{ content.body }}</div>
  </details>
{% endif %}
