{# Topic page presentation using ACULTA420 V2 design tokens and Growroom420 visual guide. #}
{% set bookmark_action = content.flag_salvar_topico|default(null) %}
{% set opening_reaction_bar = reaction_bar|default(content.reaction_bar|default(null)) %}
{# Categoria, barra de reações e "Seguir tópico" ficam fora do conteúdo corrido: a barra vai no cartão de abertura. #}
{% set topic_content = content|without('flag_salvar_topico', 'flag_seguir_topico', 'field_aculta_categories', 'body', 'reaction_bar', 'author_card') %}
{# Postagem de abertura: corpo do tópico com o destaque do tópico fixado (SDC forum-opening-post). #}
{# Postagem de abertura como render array do componente (sem string): o SVG dos ícones não é filtrado. #}
{% set opening_render = {
  '#type': 'component',
  '#component': 'aculta420_v2:forum-opening-post',
  '#props': {
    author_name: node is defined and node ? node.getOwner().getDisplayName() : '',
    author_posts: author_posts is defined ? author_posts : null,
    author_reactions: author_reactions_received is defined ? author_reactions_received : null,
    timestamp: node is defined and node ? node.getCreatedTime()|date('d/m/Y H:i') : null,
    permalink_url: url|default(null),
    delete_url: opening_delete_url|default(null),
    edit_url: opening_edit_url|default(null),
    quote_url: opening_quote_url|default(null),
    reply_url: opening_reply_url|default(null),
    link_icon: opening_icons.link|default(null),
    delete_icon: opening_icons.delete|default(null),
    edit_icon: opening_icons.edit|default(null),
    quote_icon: opening_icons.quote|default(null),
    reply_icon: opening_icons.reply|default(null),
  },
  '#slots': {
    body: content.body,
    avatar: content.author_card is defined ? content.author_card : null,
    reactions_slot: opening_reaction_bar ? opening_reaction_bar : null,
  },
} %}
{# Primeiro item da discussão: peso negativo o coloca antes das categorias e do compositor. #}
{% set topic_content = topic_content|merge({'aculta_opening': opening_render|merge({'#weight': -100})}) %}
{% set title_markup %}
  {% if label and view_mode != 'full' %}
    <h2{{ title_attributes }}><a href="{{ url }}" rel="bookmark">{{ label }}</a></h2>
  {% endif %}
{% endset %}

<article{{ attributes.addClass('node', 'aculta-forum-topic', 'aculta-forum-topic--' ~ view_mode) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if view_mode == 'full' %}
    {% set topic_category = node is defined and node and node.hasField('field_aculta_categories') and not node.field_aculta_categories.isEmpty() ? node.field_aculta_categories.entity : null %}
    <nav class="aculta-forum-topic__breadcrumb" aria-label="{{ 'Caminho'|t }}">
      <a href="{{ url('<front>') }}">{{ 'Growroom420 / Comunidade'|t }}</a>
      {% if topic_category %}
        <span aria-hidden="true">/</span>
        <span class="aculta-forum-topic__category-pill">{{ topic_category.label() }}</span>
      {% endif %}
    </nav>
    <header class="aculta-forum-topic__full-header">
      <div class="aculta-forum-topic__header-actions">
        <button type="button" class="aculta-forum-action-btn" disabled aria-disabled="true">
          {{ include('aculta420_v2:icon', { name: 'bell', variant: 'duotone', size: 'sm' }, with_context = false) }}
          <span>{{ 'Seguir'|t }}</span>
          <span class="aculta-forum-action-btn__badge">{{ 'Em breve'|t }}</span>
        </button>
        <button type="button" class="aculta-forum-action-btn" disabled aria-disabled="true">
          {{ include('aculta420_v2:icon', { name: 'bookmark-simple', variant: 'duotone', size: 'sm' }, with_context = false) }}
          <span>{{ 'Salvar'|t }}</span>
          <span class="aculta-forum-action-btn__badge">{{ 'Em breve'|t }}</span>
        </button>
      </div>
    </header>
  {% endif %}
  {% if view_mode == 'full' %}
    <div class="aculta-forum-topic__layout">
      <div class="aculta-forum-topic__main">
        {{ include('aculta420_v2:forum-topic', {
          variant: 'full',
          has_title: false,
          has_meta: false,
          has_bookmark: false,
          title: title_markup,
          meta: date,
          bookmark: bookmark_action,
          content: topic_content
        }, with_context = false) }}
        <aside class="aculta-forum-topic__aside" aria-labelledby="forum-topic-about">
        <section class="aculta-forum-topic__about">
          <h2 class="aculta-forum-topic__about-title" id="forum-topic-about">{{ 'Sobre este tópico'|t }}</h2>
          <dl class="aculta-forum-topic__about-list">
            <div>
              <dt>{{ 'Categoria'|t }}</dt>
              <dd>{{ node is defined and node and node.field_aculta_categories.entity ? node.field_aculta_categories.entity.label() : '—' }}</dd>
            </div>
            <div>
              <dt>{{ 'Criado por'|t }}</dt>
              <dd>{{ node is defined and node ? node.getOwner().getDisplayName() : '—' }}</dd>
            </div>
            <div>
              <dt>{{ 'Criado em'|t }}</dt>
              <dd>{{ node is defined and node ? node.getCreatedTime()|date('d/m/Y H:i') : '—' }}</dd>
            </div>
          </dl>
          <dl class="aculta-forum-topic__about-stats">
            <div><dt>{{ 'Respostas'|t }}</dt><dd>—<span class="visually-hidden">{{ 'Dado indisponível'|t }}</span></dd></div>
            <div><dt>{{ 'Participantes'|t }}</dt><dd>—<span class="visually-hidden">{{ 'Dado indisponível'|t }}</span></dd></div>
            <div><dt>{{ 'Visualizações'|t }}</dt><dd>—<span class="visually-hidden">{{ 'Dado indisponível'|t }}</span></dd></div>
          </dl>
        </section>
      </aside>
      {# Popup de Responder/Citar: SDC de diálogo do tema; o compositor é carregado nele pelo JS. #}
      {% embed 'aculta420_v2:dialog' with {
        id: 'aculta-reply-dialog',
        title: 'Responder à discussão',
        trigger_label: 'Responder',
        trigger_url: '#aculta-reply-dialog',
        close_label: 'Fechar',
      } only %}
        {% block content %}
          <div id="aculta-reply-dialog-body" class="aculta-reply-dialog__body"></div>
        {% endblock %}
      {% endembed %}
      {# Comentar: botão do SDC de botão; o JS preenche a URL do compositor e abre o popup de resposta. #}
      {{ include('aculta420_v2:button', {
        text: 'Comentar',
        variant: 'primary',
        attributes: { 'data-aculta-comment-new': '', 'hidden': 'hidden' },
      }, with_context = false) }}
    </div>
    </div>
  {% else %}
    {{ include('aculta420_v2:forum-topic', {
      variant: 'teaser',
      has_title: label is not empty,
      has_meta: display_submitted and date is not empty,
      has_bookmark: bookmark_action is not empty,
      title: title_markup,
      meta: date,
      bookmark: bookmark_action,
      content: topic_content
    }, with_context = false) }}
  {% endif %}
</article>
