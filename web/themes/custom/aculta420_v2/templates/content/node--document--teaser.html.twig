<article{{ attributes.addClass('node', 'node--type-document', 'node--view-mode-teaser') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% embed 'aculta420_v2:document-card' with {
    title: label,
    url: url,
    category_render: content.field_category,
    summary_render: content.body,
    attachment_render: content.field_document
  } only %}
    {% block category %}{{ category_render }}{% endblock %}
    {% block summary %}{{ summary_render }}{% endblock %}
    {% block attachment %}{{ attachment_render }}{% endblock %}
  {% endembed %}
</article>
