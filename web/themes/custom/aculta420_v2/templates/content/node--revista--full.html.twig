<article{{ attributes.addClass('node', 'node--type-revista', 'node--view-mode-full') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if aculta_revista_full_component_layout %}
    {{ content._layout_builder }}
  {% elseif content._layout_builder is not empty %}
    {% include 'aculta420_v2:revista-publication' with {
      has_meta: content.post_meta is not empty,
      has_cover: not node.field_media_image.isEmpty,
      has_subtitle: not node.field_subtitle.isEmpty,
      has_summary: not node.field_summary.isEmpty,
      has_footer: false,
      has_authors: content.article_authors is not empty,
      has_discussion: false,
      meta: content.post_meta,
      body: content._layout_builder,
      authors: content.article_authors
    } only %}
  {% else %}
  {% set article_footer = content|without('post_meta', 'field_media_image', 'field_subtitle', 'field_summary', 'body', 'field_editorial_category', 'field_tags', 'field_references', 'field_credits', 'article_authors', 'field_aculta_discussion', 'field_published_at') %}
  {% include 'aculta420_v2:revista-publication' with {
    has_meta: content.post_meta is not empty,
    has_cover: not node.field_media_image.isEmpty,
    has_subtitle: not node.field_subtitle.isEmpty,
    has_summary: not node.field_summary.isEmpty,
    has_footer: article_footer is not empty,
    has_authors: content.article_authors is not empty,
    has_discussion: content.field_aculta_discussion is not empty,
    meta: content.post_meta,
    cover: content.field_media_image,
    subtitle: content.field_subtitle,
    summary: content.field_summary,
    body: content.body,
    footer: {
      category: content.field_editorial_category,
      tags: content.field_tags,
      references: content.field_references,
      credits: content.field_credits,
      other: article_footer
    },
    authors: content.article_authors,
    discussion: content.field_aculta_discussion
  } only %}
  {% endif %}
</article>
