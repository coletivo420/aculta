{# Form layout for creating a new forum topic (/discussoes/novo-topico, popup) #}
{% set composer_tips = [
  'Escolha a categoria mais adequada para sua dúvida ou relato.'|t,
  'Seja específico no título, evitando termos genéricos como "Ajuda urgente".'|t,
  'Descreva seu cultivo, iluminação, substrato e regas para facilitar o diagnóstico.'|t
] %}
{% set composer_rules = [
  {
    title: 'Respeito e colaboração'|t,
    text: 'O Growroom420 é um espaço de apoio mútuo. Trate todos os cultivadores com cordialidade.'|t
  },
  {
    title: 'Proibição de comércio'|t,
    text: 'É estritamente vedada a compra, venda, troca ou oferta de substâncias e produtos ilícitos.'|t
  }
] %}

{{ include('aculta420_v2:forum-composer-guidelines', {
  collapsed: false,
  tips: composer_tips,
  community_rules: composer_rules
}, with_context = false) }}

{% embed 'aculta420_v2:discussion-topic-composer' with {
  target_id: 'discussion-topic-composer-new',
  status: 'editando',
  host_title: 'Growroom420'
} %}
  {% block form %}
    <div class="aculta-forum-composer-form-wrapper">
      {{ form }}
    </div>
  {% endblock %}
{% endembed %}
