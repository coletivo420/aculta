{#
/**
 * @file
 * Template do seletor de emojis do fórum integrado ao UI Icons e Fluent Emoji.
 *
 * Fornece interface de popover com busca instantânea, agrupamento por categorias,
 * navegação por teclado (Escape, Tab, setas), suporte a toque e envio HTMX.
 */
#}
<div class="discussion-reaction-bar__popup" role="dialog" aria-label="{{ 'Escolha uma reação'|t }}" data-reaction-picker-popup>
  <div class="discussion-reaction-bar__picker-header">
    <input type="search" class="discussion-reaction-bar__search" placeholder="{{ 'Buscar emoji...'|t }}" aria-label="{{ 'Buscar emoji'|t }}" data-reaction-picker-search autocomplete="off">
    <button type="button" class="discussion-reaction-bar__picker-close" aria-label="{{ 'Fechar'|t }}" data-reaction-picker-close>&times;</button>
  </div>

  <div class="discussion-reaction-bar__categories" data-reaction-picker-body>
    {% for category_key, category_data in emoji_categories %}
      <div class="discussion-reaction-bar__category" data-reaction-category="{{ category_key }}">
        <div class="discussion-reaction-bar__category-title">{{ category_data.label }}</div>
        <div class="discussion-reaction-bar__palette">
          {% for id, emoji in category_data.items %}
            {% set is_selected = (user_reaction == id) %}
            <form method="post" action="{{ react_url }}" data-hx-post="{{ react_url }}" data-hx-target="#{{ target_id }}" data-hx-swap="outerHTML" class="discussion-reaction-bar__popup-form">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
              <input type="hidden" name="reaction" value="{{ id }}">
              <button type="submit" class="discussion-reaction-bar__palette-btn{% if is_selected %} is-selected{% endif %}" title="{{ emoji.name }}" aria-label="{{ emoji.name }}" data-emoji-name="{{ emoji.name|lower }}" data-emoji-keywords="{{ emoji.keywords|join(' ')|lower }}">
                {{ include('aculta420_v2:reaction-emoji', { name: emoji.id, variant: 'color', size: 'md' }, with_context = false) }}
              </button>
            </form>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
    <div class="discussion-reaction-bar__empty" hidden>{{ 'Nenhum emoji encontrado.'|t }}</div>
  </div>
</div>
