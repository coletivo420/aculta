{#
/**
 * @file
 * Envio de formulário renderizado como <button> do SDC aculta420_v2:button.
 *
 * Mantém name, value, id, formnovalidate e os atributos do Drupal (inclusive o
 * ligação do AJAX pelo id). O variante vem da classe button--* que o mapa de
 * tokens emite. Sem type="button": o componente gera type="submit".
 */
#}
{% set variant = attributes.hasClass('button--danger') ? 'danger'
  : attributes.hasClass('button--secondary') ? 'secondary'
  : attributes.hasClass('button--outline') ? 'outline'
  : attributes.hasClass('button--ghost') ? 'ghost'
  : 'primary' %}
{% set is_small = attributes.hasClass('button--small') %}
{% set is_disabled = attributes.hasAttribute('disabled') %}
{% set rest = attributes
  .removeAttribute('type')
  .removeAttribute('disabled')
  .removeClass(['button', 'button--primary', 'button--secondary', 'button--outline', 'button--ghost', 'button--danger', 'button--small', 'button--action', 'button--cta']) %}
{{ include('aculta420_v2:button', {
  text: value,
  is_submit: true,
  variant: variant,
  size: is_small ? 'small' : 'default',
  disabled: is_disabled,
  attributes: rest,
}, with_context = false) }}
