{#
/**
 * @file
 * Theme override for the basic structure of a Drupal page.
 *
 * @see \\Drupal\\Core\\Theme\\ThemePreprocess::preprocessHtml()
 */
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <link rel="icon" href="{{ base_path ~ directory }}/assets/icons/aculta420-favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="{{ base_path ~ directory }}/assets/icons/apple-touch-icon.png">
    <link rel="manifest" href="{{ base_path ~ directory }}/assets/icons/site.webmanifest">
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes.addClass(body_classes) }}>
    <a href="#main-content" class="visually-hidden focusable skip-link">{{ 'Skip to main content'|t }}</a>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
