{#
/**
 * @file
 * Shell paralelo da ADR-054.
 *
 * Ativado pela opção aculta_shell_variant = v2. Compõe as cinco áreas finais
 * (institution, header, content, sidebar_first, footer). Ajuda e breadcrumb
 * são extraídos dos blocos no header pelo preprocess, sem depender de
 * regiões antigas que já foram retiradas do info.yml.
 */
#}
<div class="page page--shell-v2">

  {% if page.institution %}
    <div class="page__institution">{{ page.institution }}</div>
  {% endif %}

  {% if domain_presentation.layout.show_site_header is not defined or domain_presentation.layout.show_site_header %}
    <header class="page__header" role="banner">{{ page.header }}</header>
  {% endif %}

  {% if multidomain_network_links is not empty %}
    <div class="page__showcase">
      {{ include('aculta420_v2:purpose-showcase', {
        heading: 'Ecossistema ACULTA'|t,
        links: multidomain_network_links
      }, with_context = false) }}
    </div>
  {% endif %}

  {# Ajuda e breadcrumb vêm do Portal e de blocos da região header. #}
  {% if aculta_help or aculta_breadcrumb %}
    <div class="page-shell-v2__contextual">
      {% if aculta_help %}
        <div class="page__help">{{ aculta_help }}</div>
      {% endif %}
      {% if aculta_breadcrumb %}
        <div class="page__breadcrumb">{{ aculta_breadcrumb }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% set main_content = page.content %}
  {% if aculta_lms_lesson_route|default(false) and aculta_lms_lesson_sdc_available|default(false) %}
    {% set main_content = include('aculta420_v2:lms-lesson-page', {
      content: page.content
    }, with_context = false) %}
  {% endif %}
  {% set layout_page_template = 'aculta420_v2:layout-page' %}
  {% if aculta_layout_page_sdc_available|default(false) %}
    {{ include(layout_page_template, {
      variant: aculta_layout_variant|default('stack'),
      title: aculta_page_title,
      content: main_content,
      aside: page.sidebar_first
    }, with_context = false) }}
  {% else %}
    {# Fallback para cache de descoberta SDC aquecido, como no shell clássico. #}
    {% set fallback_variant = aculta_layout_variant|default('stack') %}
    <main id="main-content" class="page__main{% if fallback_variant == 'stack' %} page__main--stack{% elseif fallback_variant == 'aside' and page.sidebar_first %} page__main--with-sidebar{% endif %}" tabindex="-1">
      {% if aculta_page_title %}<div class="page__title">{{ aculta_page_title }}</div>{% endif %}
      <div class="page__content">{{ main_content }}</div>
      {% if page.sidebar_first %}
        <aside class="page__sidebar" aria-label="{{ 'Related content'|t }}">{{ page.sidebar_first }}</aside>
      {% endif %}
    </main>
  {% endif %}

  <div class="page-shell-v2__footer">
    {% if social_links_page_footer %}
      {{ include('aculta420_v2:site-footer', {
        variant: 'social-links',
        content: social_links_page_footer
      }, with_context = false) }}
    {% elseif page.footer %}
      {{ include('aculta420_v2:site-footer', { content: page.footer }, with_context = false) }}
    {% endif %}
  </div>
</div>
