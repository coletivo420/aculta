{#
/**
 * @file
 * Template de implementação para a barra de progresso.
 * Integra o componente SDC aculta420_v2:progress.
 */
#}
<div data-drupal-progress>
  {% embed 'aculta420_v2:progress' with {
    id: 'drupal-progress-bar',
    label: label|default('Progresso'|t),
    value: percent is not null ? percent : null,
    max: 100
  } only %}
  {% endembed %}
  {% if message %}
    <div class="progress__description">{{ message }}</div>
  {% endif %}
</div>
