{% if breadcrumb %}
  {% set items %}
    {% for item in breadcrumb %}
      <li class="aculta-breadcrumb__item"><a class="aculta-breadcrumb__link" href="{{ item.url }}">{{ item.text }}</a></li>
    {% endfor %}
    {% if aculta_current_breadcrumb %}
      <li class="aculta-breadcrumb__item aculta-breadcrumb__current" aria-current="page">{{ aculta_current_breadcrumb }}</li>
    {% endif %}
  {% endset %}
  {{ include('aculta420_v2:breadcrumb', { label: 'Breadcrumb'|t, items: items }, with_context = false) }}
{% endif %}
