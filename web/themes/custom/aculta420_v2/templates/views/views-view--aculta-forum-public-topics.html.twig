{#
  Lista pública de tópicos do fórum (ACULTA420 V2), três colunas como na referência:
  categorias à esquerda, lista ao centro e números e regras à direita.
  Categorias e totais vêm de ForumListHooks; abas usam as rotas dos displays existentes.
#}
{% set current_display = view.current_display %}

{% set new_topic_markup %}
  <a href="{{ url('aculta_forum.topic_composer') }}" class="use-htmx" data-action="topico-criar" data-hx-get="{{ url('aculta_forum.topic_composer') }}" data-hx-target="#aculta-topic-dialog-body" data-hx-swap="innerHTML" data-hx-select="[data-aculta-topic-composer]">{{ '+ Novo tópico'|t }}</a>
{% endset %}

{% set tab_items = [
  { label: 'Recentes'|t, href: url('view.aculta_forum_public_topics.page_discussions'), active: current_display == 'page_discussions', count: null },
  { label: 'Populares'|t, href: url('view.aculta_forum_public_topics.page_most_commented'), active: current_display == 'page_most_commented', count: null },
  { label: 'Novas'|t, href: url('view.aculta_forum_public_topics.page_new_topics'), active: current_display == 'page_new_topics', count: null },
  { label: 'Sem resposta'|t, href: url('view.aculta_forum_public_topics.page_unanswered'), active: current_display == 'page_unanswered', count: null }
] %}

<div class="aculta-forum-list">
  {{ include('aculta420_v2:forum-category-header', {
    title: 'Growroom420'|t,
    description: 'Cultivo, ciência, cultura e antiproibicionismo. Um espaço para aprender e trocar experiências.'|t,
    icon: null,
    actions: new_topic_markup|raw,
    stats: null
  }, with_context = false) }}

  <div class="aculta-forum-list__layout">
    <aside class="aculta-forum-list__categories" aria-labelledby="forum-categories-title">
      <h2 class="aculta-forum-list__aside-title" id="forum-categories-title">{{ 'Categorias'|t }}</h2>
      <ul class="aculta-forum-list__category-list">
        <li>
          <a href="{{ url('view.aculta_forum_public_topics.page_discussions') }}" class="aculta-forum-list__category is-all">
            <span>{{ 'Todas as categorias'|t }}</span>
            <span class="aculta-forum-list__category-count">{{ forum_total_topics }}</span>
          </a>
        </li>
        {% for category in forum_categories %}
          <li>
            <a href="{{ category.url }}" class="aculta-forum-list__category">
              <span>{{ category.label }}</span>
              <span class="aculta-forum-list__category-count">{{ category.count }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </aside>

    <section class="aculta-forum-list__panel" aria-label="{{ 'Lista de tópicos'|t }}">
      <div class="aculta-forum-list__search">
        <input type="search" class="aculta-forum-list__search-input" disabled aria-disabled="true" aria-label="{{ 'Buscar tópicos'|t }}" placeholder="{{ 'Buscar tópicos (em breve)'|t }}">
      </div>
      {{ include('aculta420_v2:forum-tabs', {
        label: 'Ordenação dos tópicos'|t,
        items: tab_items
      }, with_context = false) }}
      <ul class="aculta-forum-list__soon" aria-label="{{ 'Em breve'|t }}">
        {% for label in ['Não lidos'|t, 'Seguindo'|t, 'Meus tópicos'|t, 'Participações'|t] %}
          <li><span aria-disabled="true">{{ label }} <em>{{ 'Em breve'|t }}</em></span></li>
        {% endfor %}
      </ul>

      {% if rows %}
        <div class="forum-topic-row__head" aria-hidden="true">
          <span>{{ 'Tópico'|t }}</span>
          <span class="forum-topic-row__head-cols">
            <span>{{ 'Respostas'|t }}</span>
            <span>{{ 'Visualizações'|t }}</span>
            <span>{{ 'Última atividade'|t }}</span>
          </span>
        </div>
        <div class="aculta-forum-list__rows">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="aculta-forum-list__rows">
          <div class="view-empty">{{ empty }}</div>
        </div>
      {% endif %}

      {% if pager %}
        <div class="aculta-forum-list__pager">
          {{ pager }}
        </div>
      {% endif %}
    </section>

    <aside class="aculta-forum-list__aside">
      {% set aside_stats = [
        { label: 'Tópicos'|t, value: forum_total_topics },
        { label: 'Respostas'|t, value: null },
        { label: 'Pessoas'|t, value: null }
      ] %}
      {{ include('aculta420_v2:forum-sidebar-panels', {
        stats: aside_stats,
        featured: null,
        moderators: null,
        rules: [
          'Mantenha as postagens no tema específico de cada discussão.'|t,
          'Sem spam ou autopromoção desautorizada.'|t,
          'Colabore com respostas úteis e fundamentadas.'|t
        ],
        related: null
      }, with_context = false) }}
    </aside>
  </div>
</div>
