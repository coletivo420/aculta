{% set classes = [
  'view',
  'view-' ~ id|clean_class,
  'view-id-' ~ id,
  'view-display-id-' ~ display_id,
  dom_id ? 'js-view-dom-id-' ~ dom_id,
] %}
{% embed 'aculta420_v2:forum-search-page' with { attributes: attributes.addClass(classes) } %}
{% block title_prefix %}{{ title_prefix }}{% endblock %}
{% block title %}{{ title }}{% endblock %}
{% block title_suffix %}{{ title_suffix }}{% endblock %}
{% block header %}{{ header }}{% endblock %}
{% block exposed %}{{ exposed }}{% endblock %}
{% block attachment_before %}{{ attachment_before }}{% endblock %}
{% block rows %}{{ rows }}{% endblock %}
{% block empty %}{{ empty }}{% endblock %}
{% block pager %}{{ pager }}{% endblock %}
{% block attachment_after %}{{ attachment_after }}{% endblock %}
{% block more %}{{ more }}{% endblock %}
{% block footer %}{{ footer }}{% endblock %}
{% block feed_icons %}{{ feed_icons }}{% endblock %}
{% endembed %}
