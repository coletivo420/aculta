{% set classes = [
  'view',
  'view-' ~ id|clean_class,
  'view-id-' ~ id,
  'view-display-id-' ~ display_id,
  dom_id ? 'js-view-dom-id-' ~ dom_id
] %}
<div{{ attributes.addClass(classes, 'revista-view') }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  {% if header %}<div class="revista-view__header">{{ header }}</div>{% endif %}
  {% if exposed %}<div class="revista-view__filters">{{ exposed }}</div>{% endif %}
  {% if attachment_before %}<div class="revista-view__attachment revista-view__attachment--before">{{ attachment_before }}</div>{% endif %}

  {% if rows %}
    {% if view.getStyle().getPluginId() == 'ui_patterns' %}
      {{ rows }}
    {% else %}
      {% embed 'aculta420_v2:revista-listing' with {
        eyebrow: 'Publicações'|t,
        title: 'Revista 420'|t,
        has_items: true,
        rows_render: rows
      } only %}
        {% block items %}{{ rows_render }}{% endblock %}
      {% endembed %}
    {% endif %}
  {% elseif empty %}
    <div class="revista-view__empty">{{ empty }}</div>
  {% endif %}

  {% if pager %}<div class="revista-view__pager">{{ pager }}</div>{% endif %}
  {% if attachment_after %}<div class="revista-view__attachment revista-view__attachment--after">{{ attachment_after }}</div>{% endif %}
  {% if more %}<div class="revista-view__more">{{ more }}</div>{% endif %}
  {% if footer %}<footer class="revista-view__footer">{{ footer }}</footer>{% endif %}
  {% if feed_icons %}<div class="revista-view__feed">{{ feed_icons }}</div>{% endif %}
</div>
